/* WOMATE APPROVED ICON NAV · GLOBAL RESTORE V2 */
.iconPillarSection{display:block!important;padding:clamp(54px,6vw,82px) clamp(18px,5vw,72px) clamp(60px,7vw,92px)!important;background:linear-gradient(180deg,#f5f8f6 0%,#fff 100%)!important}
.iconPillarHead{display:block!important;max-width:1100px!important;margin:0 auto clamp(28px,4vw,44px)!important;text-align:center!important}
.iconPillarHead>span{display:block!important;margin-bottom:10px!important;font-size:10px!important;font-weight:800!important;letter-spacing:.17em!important;color:#6c8b89!important}
.iconPillarHead h2{margin:0 auto!important;max-width:19ch!important;font-size:clamp(32px,4.2vw,58px)!important;line-height:1!important;letter-spacing:-.043em!important;font-weight:700!important;color:#0e4d4a!important;text-wrap:balance!important}
.iconPillarTray{display:block!important;max-width:1240px!important;margin:0 auto!important;padding:clamp(16px,2vw,24px)!important;border:1px solid rgba(14,77,74,.08)!important;border-radius:34px!important;background:rgba(255,255,255,.82)!important;box-shadow:0 20px 60px rgba(6,58,55,.06)!important}
.iconPillarGrid{display:grid!important;gap:8px!important}
.iconPillarGrid.six{grid-template-columns:repeat(6,minmax(0,1fr))!important}
.iconPillarGrid.eight{grid-template-columns:repeat(8,minmax(0,1fr))!important}
.iconPillarCard{-webkit-appearance:none!important;appearance:none!important;position:relative!important;min-width:0!important;min-height:142px!important;margin:0!important;padding:18px 8px 15px!important;border:0!important;border-radius:22px!important;background:transparent!important;color:#0e4d4a!important;box-shadow:none!important;cursor:pointer!important;display:flex!important;flex-direction:column!important;align-items:center!important;justify-content:center!important;gap:12px!important;text-align:center!important}
.iconPillarCard:hover,.iconPillarCard:focus-visible{transform:translateY(-2px)!important;background:rgba(14,77,74,.035)!important}
.iconPillarNo{position:absolute!important;top:11px!important;left:12px!important;font-size:9px!important;font-weight:850!important;letter-spacing:.14em!important;color:#78918f!important}
.iconPillarGlyph{width:66px!important;height:66px!important;flex:0 0 66px!important;border-radius:21px!important;display:grid!important;place-items:center!important;background:#edf5f1!important;color:#0e4d4a!important;box-shadow:0 9px 25px rgba(6,58,55,.065)!important}
.iconPillarCard:nth-child(2n) .iconPillarGlyph{background:#f1edf8!important}.iconPillarCard:nth-child(4n) .iconPillarGlyph{background:#f7efe4!important}
.iconPillarCard:hover .iconPillarGlyph,.iconPillarCard:focus-visible .iconPillarGlyph{background:#c6ff52!important;transform:scale(1.04)!important}
.iconPillarCard strong{font-size:13px!important;line-height:1.08!important;letter-spacing:-.015em!important;max-width:12ch!important}
.iconPillarHint{display:block!important;margin:16px auto 0!important;text-align:center!important;font-size:9px!important;letter-spacing:.13em!important;text-transform:uppercase!important;color:#78918f!important}
.iconPillarModal{position:fixed!important;inset:0!important;z-index:9999!important;display:grid!important;place-items:center!important;padding:18px!important}
.iconPillarBackdrop{position:absolute!important;inset:0!important;border:0!important;background:rgba(2,30,29,.78)!important;backdrop-filter:blur(12px)!important}
.iconPillarDialog{position:relative!important;z-index:1!important;width:min(700px,94vw)!important;padding:clamp(32px,5vw,58px)!important;border-radius:32px!important;background:#083f3e!important;color:#fff!important;box-shadow:0 36px 100px rgba(0,0,0,.4)!important;border:1px solid rgba(198,255,82,.18)!important}
.iconPillarDialogIcon{width:58px!important;height:58px!important;border-radius:18px!important;display:grid!important;place-items:center!important;background:#c6ff52!important;color:#083f3e!important;margin-bottom:22px!important}
.healSupportDirect{display:grid;grid-template-columns:1.25fr auto;gap:38px;align-items:end;padding:32px 0;border-top:1px solid rgba(14,77,74,.16);border-bottom:1px solid rgba(14,77,74,.16)}
.healSupportDirect p{max-width:760px;line-height:1.7;color:#557370}
@media(max-width:1100px){.iconPillarGrid.six,.iconPillarGrid.eight{grid-template-columns:repeat(4,minmax(0,1fr))!important}}
@media(max-width:760px){.iconPillarHead{text-align:left!important}.iconPillarGrid.six,.iconPillarGrid.eight{grid-template-columns:repeat(2,minmax(0,1fr))!important}.iconPillarCard{min-height:116px!important}.iconPillarGlyph{width:56px!important;height:56px!important;flex-basis:56px!important;border-radius:17px!important}.healSupportDirect{grid-template-columns:1fr}}

/* WOMATE MOBILE NAV · CATEGORISED */
@media(max-width:900px){
 .mobileNavCategorised{position:fixed!important;inset:0!important;z-index:9998!important;background:#f8faf8!important;padding:18px 20px 28px!important;overflow-y:auto!important;display:block!important}
 .mobileNavCategorised>a{border:0!important}
 .mobileNavTop{display:flex;align-items:center;justify-content:space-between;padding:4px 0 18px;border-bottom:1px solid rgba(14,77,74,.13)}
 .mobileNavTop>span{font-size:10px;font-weight:850;letter-spacing:.16em;color:#6d8886}
 .mobileNavTop button{width:38px;height:38px;border:1px solid rgba(14,77,74,.14);border-radius:50%;background:#fff;color:#0e4d4a;display:grid;place-items:center}
 .mobileNavGroup{padding:20px 0 10px;border-bottom:1px solid rgba(14,77,74,.11)}
 .mobileNavLabel{display:block;margin:0 0 8px;font-size:9px;font-weight:850;letter-spacing:.16em;color:#819694}
 .mobileNavGroup a{display:flex!important;align-items:center!important;justify-content:space-between!important;padding:10px 0!important;border:0!important;font-size:17px!important;font-weight:700!important;letter-spacing:-.02em!important;color:#0e4d4a!important;text-decoration:none!important}
 .mobileNavGroup a svg{opacity:.45}
 .mobileDonate{display:flex!important;align-items:center!important;justify-content:space-between!important;margin-top:22px!important;padding:15px 18px!important;border-radius:999px!important;background:#c6ff52!important;color:#0e4d4a!important;font-weight:850!important;text-decoration:none!important}
}


/* WOMATE She Leads testimonial carousel */
.sheTestimonialSlider{position:relative;width:100%;max-width:620px;margin-inline:auto}
.sheTestimonialStage{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:28px;background:#0E4D4A;box-shadow:0 28px 70px rgba(14,77,74,.16)}
.sheTestimonialStage img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.018);transition:opacity 1.25s ease,transform 6.5s ease;pointer-events:none}
.sheTestimonialStage img.active{opacity:1;transform:scale(1)}
.sheTestimonialDots{display:flex;justify-content:center;gap:8px;margin-top:16px}
.sheTestimonialDots button{width:7px;height:7px;min-height:0;padding:0;border:0;border-radius:999px;background:rgba(14,77,74,.22);cursor:pointer;transition:width .35s ease,background .35s ease}
.sheTestimonialDots button.active{width:28px;background:#0E4D4A}
@media(max-width:700px){.sheTestimonialStage{border-radius:20px}.sheTestimonialSlider{max-width:100%}}
@media(prefers-reduced-motion:reduce){.sheTestimonialStage img{transition:opacity .2s ease;transform:none}.sheTestimonialDots button{transition:none}}

/* She Leads testimonial slider â€” fixed */
.sheTestimonialSlider{position:relative;width:100%;max-width:620px;margin-inline:auto}
.sheTestimonialStage{position:relative;width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:28px;background:#0E4D4A;box-shadow:0 28px 70px rgba(14,77,74,.16)}
.sheTestimonialStage img{display:block;position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;visibility:hidden;transform:scale(1.015);transition:opacity 1.2s ease,transform 7s ease,visibility 0s linear 1.2s}
.sheTestimonialStage img.active{opacity:1;visibility:visible;transform:scale(1);transition:opacity 1.2s ease,transform 7s ease,visibility 0s}
.sheTestimonialDots{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:16px}
.sheTestimonialDots button{display:block;width:7px;height:7px;min-width:7px;min-height:7px;padding:0;border:0;border-radius:999px;background:rgba(14,77,74,.22);cursor:pointer}
.sheTestimonialDots button.active{width:28px;background:#0E4D4A}
@media(max-width:700px){.sheTestimonialStage{border-radius:20px}.sheTestimonialSlider{max-width:100%}}
@media(prefers-reduced-motion:reduce){.sheTestimonialStage img{transform:none;transition:opacity .2s ease,visibility 0s}}

/* WOMATE Circle â€” premium WhatsApp concierge */
.circleIntroWithWhatsApp{
  display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(340px,520px);
  column-gap:clamp(34px,6vw,90px);
  row-gap:20px;
  align-items:center;
}
.circleIntroWithWhatsApp>span{grid-column:1/-1}
.circleIntroWithWhatsApp .circleIntroCopy{min-width:0}
.circleWaShell{position:relative;width:100%;min-height:520px;display:flex;align-items:center;justify-content:center}
.circleWaPanel{
  width:min(100%,500px);
  overflow:hidden;
  border-radius:30px;
  background:#fff;
  box-shadow:0 30px 90px rgba(6,42,39,.20);
  border:1px solid rgba(14,77,74,.08);
  transform:translateZ(0);
}
.circleWaHead{
  display:grid;
  grid-template-columns:64px minmax(0,1fr) 42px;
  gap:16px;
  align-items:center;
  padding:22px 22px 20px;
  background:#0E4D4A;
  color:#fff;
}
.circleWaAvatar{
  width:64px;height:64px;border-radius:50%;
  background:#fff;display:grid;place-items:center;overflow:hidden;
  border:3px solid rgba(198,255,82,.8);
}
.circleWaAvatar img{width:78%;height:78%;object-fit:contain}
.circleWaHead strong{display:block;font-size:20px;line-height:1.1;letter-spacing:-.02em}
.circleWaHead span{display:block;margin-top:7px;font-size:13px;color:rgba(255,255,255,.72)}
.circleWaClose{
  width:42px;height:42px;min-height:42px;border:0;border-radius:50%;
  background:transparent;color:#fff;font-size:30px;line-height:1;cursor:pointer;
}
.circleWaClose:hover{background:rgba(255,255,255,.1)}
.circleWaBody{
  min-height:250px;
  padding:36px 28px 30px;
  background:
    radial-gradient(circle at 20% 30%,rgba(255,255,255,.38) 0 1px,transparent 1.5px) 0 0/38px 38px,
    #eee7df;
  display:flex;flex-direction:column;align-items:flex-start;
}
.circleWaToday{align-self:center;font-size:12px;color:#617783;margin-bottom:28px}
.circleWaBubble{
  max-width:88%;
  padding:17px 20px;
  border-radius:18px 18px 18px 5px;
  background:#fff;
  color:#25343b;
  font-size:16px;line-height:1.55;
  box-shadow:0 5px 18px rgba(0,0,0,.03);
}
.circleWaTime{align-self:flex-end;margin-top:8px;font-size:11px;color:#6c8088}
.circleWaCompose{padding:22px;background:#fff}
.circleWaInputRow{display:grid;grid-template-columns:minmax(0,1fr) 52px;gap:10px;align-items:center}
.circleWaInputRow input{
  width:100%;height:52px;border:1px solid #d9dedb;border-radius:999px;
  padding:0 20px;font:inherit;font-size:14px;background:#fff;color:#183b39;outline:none;
}
.circleWaInputRow input:focus{border-color:#0E4D4A;box-shadow:0 0 0 3px rgba(14,77,74,.08)}
.circleWaSend{
  width:52px;height:52px;min-height:52px;border:0;border-radius:50%;
  display:grid;place-items:center;background:#25D366;color:#fff;
  font-size:23px;cursor:pointer;box-shadow:0 10px 22px rgba(37,211,102,.25)
}
.circleWaStart{
  width:100%;min-height:54px;margin-top:14px;border:0;border-radius:999px;
  padding:12px 18px;background:#25D366;color:#082b25;
  font:inherit;font-size:15px;font-weight:800;cursor:pointer;
}
.circleWaStart:hover,.circleWaSend:hover{transform:translateY(-1px);filter:brightness(.97)}
.circleWaCompose small{display:block;margin:10px auto 0;text-align:center;font-size:10px;color:#73807c}
.circleWaFab{
  width:72px;height:72px;min-height:72px;border:5px solid #0E4D4A;border-radius:50%;
  display:grid;place-items:center;background:#25D366;color:#fff;
  box-shadow:0 18px 48px rgba(6,42,39,.24);cursor:pointer;
}
.circleWaFab svg{width:37px;height:37px}
@media(max-width:900px){
 .circleIntroWithWhatsApp{grid-template-columns:1fr!important}
 .circleIntroWithWhatsApp>span{grid-column:auto}
 .circleWaShell{min-height:0;margin-top:18px}
 .circleWaPanel{width:100%;max-width:560px}
}
@media(max-width:560px){
 .circleWaPanel{border-radius:22px}
 .circleWaHead{grid-template-columns:52px minmax(0,1fr) 38px;padding:18px 16px;gap:12px}
 .circleWaAvatar{width:52px;height:52px}
 .circleWaHead strong{font-size:17px}
 .circleWaHead span{font-size:11px}
 .circleWaBody{min-height:220px;padding:28px 18px 24px}
 .circleWaBubble{max-width:94%;font-size:14px}
 .circleWaCompose{padding:16px}
}
@media(prefers-reduced-motion:reduce){
 .circleWaStart,.circleWaSend,.circleWaClose{transition:none!important}
}
