@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap');
:root{--g:#0E4D4A;--gd:#073b39;--l:#C6FF52;--w:#fff;--cream:#f5f7f1;--ink:#123e3c;--muted:#56716f;--line:rgba(14,77,74,.14)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Manrope,system-ui,sans-serif;color:var(--ink);background:#fff}a{text-decoration:none;color:inherit}button,input,textarea,select{font:inherit}img{display:block;max-width:100%}
.globalHeader{height:84px;position:absolute;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;gap:34px;padding:0 clamp(22px,4.6vw,72px);color:white;border-bottom:1px solid rgba(255,255,255,.12);backdrop-filter:blur(12px);background:linear-gradient(180deg,rgba(3,37,35,.35),transparent)}.brand{display:flex;align-items:center;gap:12px}.brand img{width:128px;filter:brightness(0) invert(1)}.brand span{font-size:9px;letter-spacing:.16em;text-transform:uppercase;opacity:.62}.headright{margin-left:auto;display:flex;align-items:center;gap:18px}.quiet,nav a{font-size:11px;font-weight:800;letter-spacing:.02em;opacity:.76;transition:.2s}.quiet:hover,nav a:hover{opacity:1;color:var(--l)}nav{display:flex;gap:21px}.pill{border:0;border-radius:999px;padding:13px 18px;font-size:12px;font-weight:800;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:.25s}.pill:hover{transform:translateY(-2px)}.lime{background:var(--l);color:var(--g);box-shadow:0 12px 35px rgba(198,255,82,.12)}.ghost{border:1px solid rgba(255,255,255,.38);color:white;background:rgba(255,255,255,.03)}.darkbtn{background:var(--g);color:white}.menu{display:none;background:none;border:0;color:white}.mobileNav{display:none}
.hero{min-height:760px;background:linear-gradient(120deg,#0E4D4A 0%,#0A3F3C 100%);color:white;position:relative;overflow:hidden;padding:145px clamp(22px,5.6vw,90px) 70px}.hero:before{content:"";position:absolute;right:-9vw;top:12%;width:42vw;height:42vw;border-radius:50%;background:radial-gradient(circle,rgba(198,255,82,.13),rgba(198,255,82,0) 68%);pointer-events:none}.heroTop{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1fr) minmax(430px,1fr);gap:52px;align-items:center;max-width:1450px;margin:auto}.heroCopy{padding-top:10px}.eyebrow{font-size:10px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--l);margin-bottom:22px}.eyebrow.dark{color:var(--g)}h1{font-size:clamp(54px,7vw,96px);line-height:.92;letter-spacing:-.07em;margin:0;max-width:900px;font-weight:800}.hero p{font-size:16px;line-height:1.78;max-width:650px;color:rgba(255,255,255,.74);margin-top:28px}.actions{display:flex;gap:11px;margin-top:30px}.heroVisual{height:580px;position:relative;display:flex;align-items:flex-end;justify-content:center}.heroCharacter{display:block;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 30px 28px rgba(0,0,0,.18));transform:none!important;animation:none!important}.hv-home .heroCharacter{max-height:520px}.hero-she .heroVisual,.hero-wok .heroVisual,.hero-circle .heroVisual,.hero-research .heroVisual,.hero-minds .heroVisual,.hero-honours .heroVisual,.hero-leadership .heroVisual,.hero-funding .heroVisual{height:610px}.hero-she .heroCharacter,.hero-wok .heroCharacter,.hero-circle .heroCharacter,.hero-research .heroCharacter,.hero-minds .heroCharacter,.hero-honours .heroCharacter,.hero-leadership .heroCharacter,.hero-funding .heroCharacter{max-width:680px}
.statbar{display:grid;grid-template-columns:repeat(4,1fr);max-width:1280px;margin:-42px auto 0;position:relative;z-index:5;background:white;box-shadow:0 25px 70px rgba(14,77,74,.14);border-radius:20px;padding:28px 35px}.statbar div{display:flex;align-items:baseline;gap:10px;border-right:1px solid var(--line);padding-left:28px}.statbar div:last-child{border:0}.statbar strong{font-size:42px;letter-spacing:-.05em}.statbar span{font-size:11px;font-weight:800;opacity:.48;text-transform:uppercase;letter-spacing:.08em}
.manifesto,.programmeIntro{padding:120px 30px;max-width:1320px;margin:auto;display:grid;grid-template-columns:120px 1.15fr .85fr;gap:55px;align-items:start}.programmeIntro{grid-template-columns:1fr .8fr}.manifestoMark{width:100px;height:100px;border-radius:50%;background:var(--l);display:grid;place-items:center;font-size:58px;font-weight:800;letter-spacing:-.08em;transform:rotate(-8deg)}.manifesto h3,.programmeIntro h3,.impactCopy h3,.voices h3,.honours h3,.partner h3,.ctaBand h3,.application h3,.certificateScene h3,.store h3{font-size:clamp(38px,4.8vw,66px);line-height:1.02;letter-spacing:-.06em;margin:0}.manifesto p,.programmeIntro p,.impactCopy p,.partner p,.application p,.store p{font-size:16px;line-height:1.8}.lead{font-size:19px!important;font-weight:650}.pulseLine{margin-top:26px;display:flex;gap:10px;align-items:center;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.pulseLine span{width:28px;height:2px;background:var(--l);box-shadow:0 0 0 5px rgba(198,255,82,.15)}
.programGrid{max-width:1320px;margin:auto;padding:0 30px 120px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.program{height:420px;border-radius:24px;position:relative;overflow:hidden;background:var(--g);color:white;isolation:isolate;transition:.35s}.programArt{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:.5s;z-index:-2}.p1 .programArt,.p3 .programArt{object-fit:contain;padding:55px;background:#ecf3eb}.p2 .programArt{object-fit:contain;padding:38px;background:#0a3432}.programShade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,42,40,.05),rgba(5,42,40,.92));z-index:-1}.program:hover{transform:translateY(-7px)}.program:hover .programArt{transform:scale(1.05)}.programTop{display:flex;justify-content:space-between;align-items:center;padding:24px}.ico{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--l);color:var(--g)}.programTop>span{font-size:9px;font-weight:800;letter-spacing:.13em;opacity:.65}.programCopy{position:absolute;left:28px;right:28px;bottom:26px}.program h4{font-size:34px;letter-spacing:-.05em;margin:0 0 8px}.program p{font-size:13px;max-width:260px;opacity:.75;line-height:1.55}.program .go{position:absolute;right:0;bottom:0}
.impactScene{max-width:1320px;margin:0 auto 130px;padding:0 30px;display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.impactPhoto{height:600px;position:relative;border-radius:28px;overflow:hidden;background:var(--g)}.impactPhoto>img{width:100%;height:100%;object-fit:cover;filter:saturate(.75) contrast(1.07)}.mapGrid{position:absolute;inset:0;background-image:linear-gradient(rgba(198,255,82,.14) 1px,transparent 1px),linear-gradient(90deg,rgba(198,255,82,.14) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(90deg,transparent,black)}.play{position:absolute;top:24px;left:24px;border:0;border-radius:999px;background:white;color:var(--g);padding:11px 15px;font-size:10px;font-weight:800;display:flex;gap:8px;align-items:center}.impactBadge{position:absolute;right:22px;bottom:22px;background:var(--l);color:var(--g);border-radius:16px;padding:14px;display:flex;gap:11px;align-items:center}.impactBadge span{font-size:9px;display:flex;flex-direction:column;line-height:1.5}.impactBadge b{font-size:11px}.impactCopy h3{font-size:50px}.textlink{display:inline-flex;gap:8px;align-items:center;font-size:12px;font-weight:800;border-bottom:1px solid;padding-bottom:6px;margin-top:18px}
.facesRail{background:var(--gd);color:white;padding:95px max(26px,calc((100vw - 1320px)/2));display:grid;grid-template-columns:1.15fr repeat(3,.7fr) 1fr;gap:12px;align-items:stretch}.railIntro{padding:20px 28px 20px 0}.railIntro h3{font-size:clamp(38px,4vw,58px);line-height:1;letter-spacing:-.06em;margin:0 0 20px}.railIntro p{font-size:13px;line-height:1.7;color:rgba(255,255,255,.62)}.faceCard,.characterCard{position:relative;min-height:360px;border-radius:20px;overflow:hidden;background:#123e3c}.faceCard img,.characterCard img{width:100%;height:100%;object-fit:cover}.characterCard img{object-fit:contain;padding:15px}.faceCard:after,.characterCard:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(2,31,29,.85))}.faceCard span,.characterCard span{position:absolute;z-index:3;left:18px;bottom:18px;font-size:9px;font-weight:800;letter-spacing:.13em;color:var(--l)}
.voices{padding:110px max(30px,calc((100vw - 1260px)/2));background:#eef4ef}.voicesHead{display:grid;grid-template-columns:1fr auto;align-items:end;gap:30px}.voiceOrb{width:120px;height:120px;border-radius:50%;border:1px solid var(--g);display:grid;place-items:center;position:relative}.voiceOrb svg{position:absolute;opacity:.18;width:72px;height:72px}.voiceOrb span{font-size:30px;line-height:.75;font-weight:800;text-align:center;letter-spacing:-.04em}.voiceOrb small{font-size:8px;letter-spacing:.08em;text-transform:uppercase}.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:50px}.quotes article{background:white;border-radius:18px;padding:30px;min-height:280px;display:flex;flex-direction:column;box-shadow:0 10px 30px rgba(14,77,74,.04)}.quotes article svg{color:var(--g);opacity:.2}.quotes p{font-size:18px;line-height:1.6;font-weight:700}.quotes span{font-size:10px;opacity:.5;margin-top:auto}
.honours{background:var(--g);color:white;display:grid;grid-template-columns:.75fr 1.25fr;align-items:center;padding:90px max(30px,calc((100vw - 1320px)/2));gap:55px}.honourCopy p{font-size:16px;opacity:.72;line-height:1.75}.honourCount{margin-top:45px;font-size:58px;font-weight:800;letter-spacing:-.06em;color:var(--l)}.honourCount span{display:block;font-size:9px;letter-spacing:.11em;text-transform:uppercase;color:white;opacity:.5}.honourWall{display:grid;grid-template-columns:1fr 1fr;gap:10px;transform:rotate(2deg)}.honourWall img{width:100%;height:240px;object-fit:cover;border-radius:14px;background:#f4f4ee}.honourWall img:nth-child(2),.honourWall img:nth-child(4){transform:translateY(24px)}
.partner,.application{max-width:1260px;margin:auto;padding:120px 30px;display:grid;grid-template-columns:1fr 1fr;gap:90px}.partnerLine{display:flex;gap:10px;align-items:center;margin-top:32px;font-size:11px;font-weight:800;color:var(--muted)}.partner form,.application form{display:grid;gap:12px}.partner input,.partner select,.partner textarea,.application input,.application textarea{border:0;border-bottom:1px solid var(--line);padding:17px 4px;background:transparent;font:600 14px Manrope;outline:none}.partner textarea,.application textarea{min-height:110px}.partner button,.application button{justify-self:start;margin-top:12px}
.galleryTriptych{max-width:1320px;margin:0 auto 110px;padding:0 30px;display:grid;grid-template-columns:1.4fr .8fr .8fr;grid-template-rows:260px 260px;gap:12px}.galleryTriptych figure{margin:0;border-radius:22px;overflow:hidden;position:relative;background:#edf3ec}.galleryTriptych .gBig{grid-row:1/3}.galleryTriptych figure img{width:100%;height:100%;object-fit:cover}.galleryTriptych figure:nth-child(2) img,.galleryTriptych figure:nth-child(3) img{object-fit:contain;padding:18px}.galleryTriptych figcaption{position:absolute;left:18px;bottom:18px;background:var(--l);color:var(--g);border-radius:999px;padding:9px 12px;font-size:9px;font-weight:800;letter-spacing:.08em}.featureList{max-width:1260px;margin:0 auto 120px;padding:0 30px;border-top:1px solid var(--line)}.feature{display:grid;grid-template-columns:70px 1fr auto;align-items:center;padding:28px 5px;border-bottom:1px solid var(--line);transition:.25s}.feature:hover{padding-left:20px;background:#f2f7f3}.feature span{font-size:9px;font-weight:800;opacity:.45;letter-spacing:.1em}.feature h4{font-size:clamp(23px,3vw,40px);margin:0;letter-spacing:-.04em}.certificateScene,.ctaBand{background:var(--g);color:white;max-width:1260px;margin:0 auto 110px;border-radius:26px;padding:58px;display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center;position:relative;overflow:hidden}.certificateScene:before,.ctaBand:before{content:"";position:absolute;right:-90px;top:-90px;width:260px;height:260px;border-radius:50%;border:1px solid rgba(198,255,82,.25);box-shadow:0 0 0 45px rgba(198,255,82,.03)}.certificateScene img{width:100%;max-height:340px}.certificateScene p{opacity:.66;line-height:1.7}.ctaBand{grid-template-columns:1fr auto}.leadershipFaces{max-width:1260px;margin:0 auto 110px;padding:0 30px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.leadershipFaces article{height:390px;position:relative;border-radius:20px;overflow:hidden}.leadershipFaces img{width:100%;height:100%;object-fit:cover}.leadershipFaces article:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(3,42,40,.86))}.leadershipFaces article div{position:absolute;z-index:2;left:18px;bottom:18px;color:white}.leadershipFaces span{font-size:8px;color:var(--l);font-weight:800;letter-spacing:.12em}.leadershipFaces h4{margin:4px 0 0;font-size:21px;letter-spacing:-.04em}.store{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;max-width:1120px;margin:0 auto 120px;padding:0 30px}.productStage{background:var(--gd);border-radius:28px;padding:45px;position:relative}.productStage img{width:100%}.productStage span{position:absolute;left:22px;top:22px;background:var(--l);padding:8px 10px;border-radius:999px;font-size:8px;font-weight:800}.merchMini{display:flex;gap:10px;margin:24px 0}.merchMini img{width:90px;height:90px;object-fit:contain;background:#eff4ef;border-radius:12px;padding:7px}.miniProof{display:flex;align-items:center;gap:9px;margin-top:25px;font-size:11px;font-weight:800;color:var(--g)}
footer{background:#062f2d;color:white;padding:78px clamp(24px,6vw,90px) 24px}.footbrand{display:grid;grid-template-columns:auto 1fr auto;gap:55px;align-items:start;border-bottom:1px solid rgba(255,255,255,.14);padding-bottom:55px}.footbrand>img{width:150px;filter:brightness(0) invert(1)}.footbrand h3{font-size:clamp(32px,4vw,54px);max-width:720px;margin:0;letter-spacing:-.055em}.footOrb{width:140px;height:140px;border-radius:50%;border:1px solid rgba(198,255,82,.4);display:flex;align-items:center;justify-content:center;gap:10px;color:var(--l)}.footOrb span{font-size:8px;line-height:1.8;letter-spacing:.1em;text-transform:uppercase}.footlinks{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;padding:55px 0}.footlinks div{display:flex;flex-direction:column;gap:11px;font-size:11px;color:rgba(255,255,255,.65)}.footlinks b{color:var(--l);font-size:9px;text-transform:uppercase;letter-spacing:.15em;margin-bottom:8px}.bottom{border-top:1px solid rgba(255,255,255,.14);padding-top:22px;display:flex;justify-content:space-between;font-size:9px;opacity:.5}
@media(max-width:1080px){nav,.headright{display:none}.menu{display:block;margin-left:auto}.mobileNav{display:flex;position:absolute;z-index:70;top:84px;left:0;right:0;background:#062f2d;color:white;padding:18px 24px 28px;flex-direction:column}.mobileNav a{display:flex;justify-content:space-between;padding:15px 0;border-bottom:1px solid rgba(255,255,255,.1);font-weight:800}.heroTop{grid-template-columns:1fr}.heroVisual{height:470px}.hero{padding-bottom:30px}.manifesto{grid-template-columns:90px 1fr}.manifesto>div:last-child{grid-column:2}.programGrid{grid-template-columns:repeat(2,1fr)}.impactScene,.partner,.application,.programmeIntro{grid-template-columns:1fr}.facesRail{grid-template-columns:1fr 1fr 1fr}.railIntro{grid-column:1/-1}.characterCard{display:none}.honours{grid-template-columns:1fr}.galleryTriptych{grid-template-columns:1fr 1fr}.galleryTriptych .gBig{grid-row:auto;grid-column:1/-1}.leadershipFaces{grid-template-columns:repeat(2,1fr)}.store{grid-template-columns:1fr}.footbrand{grid-template-columns:1fr}.footOrb{display:none}}
@media(max-width:650px){.globalHeader{height:72px;padding:0 20px}.brand img{width:112px}.brand span{display:none}.mobileNav{top:72px}.hero{padding:118px 20px 34px;min-height:760px}.hero h1{font-size:52px}.hero p{font-size:14px}.actions{flex-direction:column;align-items:stretch;max-width:280px}.heroVisual{height:390px;margin-top:16px}.heroCharacter{max-width:100%;filter:drop-shadow(0 18px 18px rgba(0,0,0,.14))}.statbar{grid-template-columns:repeat(2,1fr);margin:-18px 16px 0;padding:12px}.statbar div{padding:14px;border-bottom:1px solid var(--line)}.statbar strong{font-size:31px}.manifesto,.programmeIntro{padding:80px 20px;grid-template-columns:1fr;gap:28px}.manifestoMark{width:72px;height:72px;font-size:40px}.manifesto>div:last-child{grid-column:auto}.programGrid{grid-template-columns:1fr;padding:0 16px 80px}.program{height:360px}.impactScene{padding:0 16px;margin-bottom:80px;gap:36px}.impactPhoto{height:430px}.impactCopy h3{font-size:39px}.facesRail{padding:70px 16px;grid-template-columns:1fr 1fr}.railIntro{grid-column:1/-1}.faceCard{min-height:270px}.f3{display:none}.voices{padding:75px 16px}.voicesHead{grid-template-columns:1fr}.voiceOrb{display:none}.quotes{grid-template-columns:1fr}.honours{padding:70px 20px}.honourWall{gap:6px}.honourWall img{height:160px}.partner,.application{padding:80px 20px;gap:38px}.galleryTriptych{padding:0 16px;grid-template-columns:1fr;grid-template-rows:none}.galleryTriptych .gBig{grid-column:auto;height:390px}.galleryTriptych figure{height:260px}.featureList{padding:0 16px;margin-bottom:80px}.feature{grid-template-columns:45px 1fr auto;padding:23px 3px}.certificateScene,.ctaBand{margin:0 16px 75px;padding:34px 24px;border-radius:20px;grid-template-columns:1fr}.leadershipFaces{padding:0 16px;grid-template-columns:1fr 1fr}.leadershipFaces article{height:300px}.store{padding:0 16px}.footbrand{gap:30px}.footlinks{grid-template-columns:1fr 1fr}.bottom{flex-direction:column;gap:8px}}
/* V4 â€” WOMATE editorial direction: people first, no grid/floating decoration */
.hero:before,.mapGrid,.voiceOrb,.footOrb,.certificateScene:before,.ctaBand:before{display:none!important}
.heroCopy>p,.hero .eyebrow{display:none!important}
.hero{background:#0E4D4A}
.heroTop{gap:28px}
.heroVisual{justify-content:flex-end}
.heroCharacter{filter:drop-shadow(0 24px 24px rgba(0,0,0,.14))}
.program:hover,.pill:hover,.feature:hover{transform:none}
.program:hover .programArt{transform:none}
.program,.pill,.feature{transition:border-color .2s,background-color .2s,color .2s}
.honourWall{transform:none}
.honourWall img:nth-child(2),.honourWall img:nth-child(4){transform:none}

/* V4.2 â€” global desktop navigation. Mobile navigation intentionally unchanged. */
@media(min-width:1081px){
  .globalHeader{height:104px;padding:0 clamp(28px,4vw,68px);gap:42px;background:rgba(6,47,45,.93);border-bottom:1px solid rgba(255,255,255,.14);backdrop-filter:blur(18px)}
  .globalHeader .brand{gap:15px;flex:0 0 auto}
  .globalHeader .brand img{width:158px}
  .globalHeader .brand span{font-size:10px;line-height:1.15;letter-spacing:.17em;max-width:72px;opacity:.7}
  .desktopNav{display:flex;align-items:center;justify-content:center;gap:8px;align-self:stretch}
  .desktopNav>a,.navTrigger{height:100%;display:flex;align-items:center;gap:7px;padding:0 16px;background:none;border:0;color:white;font:800 13px Manrope,sans-serif;letter-spacing:-.01em;white-space:nowrap;cursor:pointer;opacity:.92}
  .desktopNav>a:hover,.navTrigger:hover,.navGroup:focus-within>.navTrigger,.navGroup:hover>.navTrigger{color:var(--l);opacity:1}
  .navGroup{height:100%;display:flex;align-items:center;position:relative}
  .navTrigger svg{transition:transform .2s ease}
  .navGroup:hover>.navTrigger svg,.navGroup:focus-within>.navTrigger svg{transform:rotate(180deg)}
  .megaMenu{position:absolute;top:calc(100% - 1px);left:0;width:min(920px,calc(100vw - 80px));background:#fff;color:var(--g);border:1px solid rgba(14,77,74,.1);box-shadow:0 26px 70px rgba(3,42,40,.24);border-radius:0 0 22px 22px;padding:28px;display:grid;grid-template-columns:230px 1fr 210px;gap:28px;opacity:0;visibility:hidden;transform:translateY(8px);pointer-events:none;transition:opacity .16s ease,transform .16s ease,visibility .16s;z-index:100}
  .navGroup:hover>.megaMenu,.navGroup:focus-within>.megaMenu{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto}
  .megaIntro{padding:4px 22px 4px 2px;border-right:1px solid var(--line)}
  .megaIntro>span,.megaLabel,.megaFeature>span{display:block;font-size:9px;font-weight:800;letter-spacing:.16em;color:#5d7774;margin-bottom:13px}
  .megaIntro strong{display:block;font-size:24px;line-height:1.08;letter-spacing:-.045em;color:var(--g)}
  .megaIntro p{margin:14px 0 0;font-size:12px;line-height:1.65;color:#617572}
  .megaLinks{display:grid;grid-template-columns:1fr 1fr;gap:25px}
  .megaLinks>div{display:flex;flex-direction:column}
  .megaLinks a,.orgLinks a{display:flex;flex-direction:column;gap:3px;padding:11px 12px;border-radius:10px;color:var(--g);opacity:1}
  .megaLinks a:hover,.orgLinks a:hover{background:#f2f7f3;color:var(--g)}
  .megaLinks b,.orgLinks b{font-size:13px;letter-spacing:-.015em}
  .megaLinks small,.orgLinks small{font-size:10px;line-height:1.45;color:#73827f;font-weight:600}
  .megaFeature{align-self:stretch;border-radius:16px;background:var(--g);color:#fff!important;padding:21px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;min-height:180px;opacity:1!important;overflow:hidden}
  .megaFeature:before{content:"W";position:absolute;right:-9px;top:-25px;font-size:128px;line-height:1;font-weight:800;color:rgba(198,255,82,.1);letter-spacing:-.1em}
  .megaFeature>span{color:var(--l);margin-bottom:8px}
  .megaFeature strong{font-size:23px;line-height:1.05;max-width:150px;letter-spacing:-.045em}
  .megaFeature svg{position:absolute;right:20px;bottom:20px;color:var(--l)}
  .orgMenu{left:auto;right:-90px;width:650px;grid-template-columns:230px 1fr}
  .orgLinks{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px;align-content:start}
  .headright{margin-left:auto;display:flex;align-items:center}
  .headerJoin{display:inline-flex;align-items:center;gap:9px;background:var(--l);color:var(--g);padding:15px 19px;border-radius:999px;font-size:12px;font-weight:800;white-space:nowrap;box-shadow:0 8px 24px rgba(0,0,0,.08)}
  .headerJoin:hover{background:white;color:var(--g)}
  .hero{padding-top:150px}
}

/* V4.3 â€” 2025 Annual Impact Report flipbook */
body.reportOpen{overflow:hidden}.impactReportLaunch{max-width:1260px;margin:26px auto 0;padding:0 30px}.impactReportLaunch>button{width:100%;border:0;background:#fff;color:var(--g);display:flex;align-items:center;justify-content:space-between;text-align:left;padding:24px 28px;border-radius:18px;box-shadow:0 14px 38px rgba(3,42,40,.10);cursor:pointer;font:800 clamp(18px,2.1vw,28px) Manrope,sans-serif;letter-spacing:-.035em}.impactReportLaunch small{display:block;margin-bottom:7px;color:#71827f;font-size:9px;letter-spacing:.16em}.launchIcon{display:flex;align-items:center;gap:8px;background:var(--l);padding:14px 16px;border-radius:999px}.launchIcon svg{width:18px}.reportOverlay{position:fixed;inset:0;z-index:999;background:rgba(2,31,29,.76);display:grid;place-items:center;padding:22px;backdrop-filter:blur(12px)}.reportBackdrop{position:absolute;inset:0;border:0;background:transparent}.reportShell{position:relative;z-index:2;width:min(1080px,96vw);height:min(760px,92vh);display:grid;grid-template-rows:54px 1fr 64px;background:#f3f6f1;border-radius:24px;overflow:hidden;box-shadow:0 42px 120px rgba(0,0,0,.42)}.reportTopbar,.reportControls{display:flex;align-items:center;justify-content:space-between;padding:0 22px;background:#062f2d;color:#fff}.reportTopbar>div{display:flex;align-items:center;gap:10px;font-size:9px;font-weight:800;letter-spacing:.13em}.reportTopbar button{border:0;background:rgba(255,255,255,.09);color:#fff;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;cursor:pointer}.reportTopbar svg{width:18px}.reportPage{position:relative;overflow:auto;padding:clamp(34px,5vw,70px);animation:reportTurn .35s cubic-bezier(.2,.75,.25,1);transform-origin:left center}.reportPageNo{position:absolute;right:30px;bottom:24px;font-size:9px;font-weight:800;letter-spacing:.13em;opacity:.48}@keyframes reportTurn{from{opacity:.35;transform:perspective(1000px) rotateY(-5deg) translateX(12px)}to{opacity:1;transform:none}}.report-cover{background:var(--g);color:#fff}.report-cover:after{content:'W';position:absolute;right:-45px;bottom:-120px;font-size:min(38vw,420px);line-height:.8;font-weight:800;color:rgba(198,255,82,.08);letter-spacing:-.12em}.reportEst,.reportKicker{display:block;font-size:10px;font-weight:800;letter-spacing:.18em;color:var(--l);margin-bottom:22px}.reportWordmark{font-size:13px;font-weight:800;letter-spacing:.22em;margin-bottom:46px}.report-cover h2{position:relative;z-index:2;font-size:clamp(50px,8vw,94px);line-height:.84;letter-spacing:-.07em;margin:0;max-width:830px}.reportRule{height:1px;background:rgba(255,255,255,.3);margin:38px 0 24px}.report-cover h3{font-size:clamp(16px,2vw,25px);max-width:630px;line-height:1.3;color:var(--l);margin:0}.reportCoverFoot{position:absolute;left:clamp(34px,5vw,70px);right:clamp(34px,5vw,70px);bottom:28px;display:flex;justify-content:space-between;font-size:8px;font-weight:800;letter-spacing:.12em;opacity:.72}.report-blueprint{background:#fff;color:var(--g)}.report-blueprint blockquote{font-size:clamp(25px,4vw,49px);line-height:1.08;letter-spacing:-.055em;margin:0 0 22px;font-weight:800;max-width:850px}.report-blueprint>p{max-width:700px;font-size:15px;line-height:1.72;color:#5f716e}.legacyTitle{font-size:10px;font-weight:800;letter-spacing:.16em;margin:38px 0 16px}.legacyGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.legacyGrid>div{background:#edf4ee;border-radius:14px;padding:22px}.legacyGrid b{display:block;font-size:43px;letter-spacing:-.06em}.legacyGrid span{font-size:10px;font-weight:700;line-height:1.45;color:#60716e}.report-pillars{background:#0b4542;color:#fff}.reportPillars{display:grid;grid-template-columns:1fr 1fr;gap:11px}.reportPillars article{padding:25px;border:1px solid rgba(255,255,255,.13);border-radius:16px;min-height:180px}.reportPillars article b{color:var(--l);font-size:11px}.reportPillars h3{font-size:27px;letter-spacing:-.045em;margin:22px 0 9px}.reportPillars p{font-size:12px;line-height:1.65;color:rgba(255,255,255,.7);margin:0}.report-technology{background:#fff;color:var(--g)}.report-technology h2,.report-sdg h2{font-size:clamp(40px,6vw,72px);line-height:.94;letter-spacing:-.065em;margin:0 0 22px}.report-technology h2 em{font-style:normal;color:#63816d}.report-technology>p{max-width:720px;font-size:15px;line-height:1.72;color:#60716e}.report-technology>blockquote{margin:30px 0;font-size:21px;font-weight:800;max-width:690px;letter-spacing:-.035em}.whyPanel{background:var(--l);padding:25px 28px;border-radius:16px;display:grid;grid-template-columns:110px 1fr 1fr;gap:24px;align-items:start}.whyPanel>span{font-size:9px;font-weight:800;letter-spacing:.15em}.whyPanel h3{font-size:19px;line-height:1.25;margin:0}.whyPanel strong{font-size:14px;line-height:1.45}.report-sdg{background:#f6f7f1;color:var(--g)}.report-sdg>p{max-width:650px;color:#63736f;font-size:13px}.sdgGrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin:28px 0}.sdgGrid>div{background:#fff;padding:18px 15px;border-radius:13px;min-height:125px;display:flex;flex-direction:column}.sdgGrid span{font-size:24px;margin-bottom:auto}.sdgGrid b{font-size:12px;margin-top:18px}.sdgGrid small{font-size:9px;line-height:1.35;color:#6a7b77;margin-top:4px}.reportConnect{display:flex;align-items:end;justify-content:space-between;border-top:1px solid rgba(14,77,74,.16);padding-top:22px}.reportConnect>div>span{font-size:8px;font-weight:800;letter-spacing:.15em;color:#73837f}.reportConnect h3{font-size:27px;margin:4px 0}.reportConnect p{margin:0;font-size:11px;color:#697976}.reportConnect a{display:inline-flex;align-items:center;gap:8px;background:var(--g);color:#fff;padding:14px 18px;border-radius:999px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}.reportControls>button{border:0;background:transparent;color:#fff;display:flex;align-items:center;gap:7px;font:800 10px Manrope,sans-serif;text-transform:uppercase;letter-spacing:.08em;cursor:pointer}.reportControls>button:disabled{opacity:.25;cursor:default}.reportDots{display:flex;gap:7px}.reportDots button{width:7px;height:7px;border-radius:50%;border:0;padding:0;background:rgba(255,255,255,.3);cursor:pointer}.reportDots button.active{background:var(--l);transform:scale(1.35)}
@media(max-width:650px){.impactReportLaunch{padding:0 16px}.impactReportLaunch>button{padding:19px;font-size:18px}.launchIcon{padding:11px}.reportOverlay{padding:0}.reportShell{width:100vw;height:100dvh;border-radius:0;grid-template-rows:50px 1fr 58px}.reportPage{padding:32px 22px 70px}.reportCoverFoot{left:22px;right:22px;bottom:24px}.report-cover h2{font-size:53px}.legacyGrid{grid-template-columns:1fr 1fr}.legacyGrid>div{padding:17px}.legacyGrid b{font-size:34px}.reportPillars{grid-template-columns:1fr}.reportPillars article{min-height:auto;padding:17px}.reportPillars h3{font-size:22px;margin:12px 0 6px}.whyPanel{grid-template-columns:1fr;gap:10px}.sdgGrid{grid-template-columns:1fr 1fr}.sdgGrid>div:last-child{grid-column:1/-1}.reportConnect{align-items:start;flex-direction:column;gap:18px}.reportTopbar>div span{font-size:7px}.reportControls{padding:0 14px}.reportControls>button{font-size:8px}.reportPageNo{bottom:18px;right:20px}}

/* v4.4 homepage/header refinements */
.globalHeader .brand{min-width:158px}
.globalHeader .brand img{width:172px;height:auto;display:block}
.heroExplore{border:0;font-family:inherit;cursor:pointer}
.hero-home .heroVisual{align-items:flex-end;justify-content:flex-end;overflow:visible}
.hero-home .heroCharacter{width:min(650px,48vw);max-height:690px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 26px 40px rgba(0,0,0,.18))}
.statbar .animatedStat{position:relative;overflow:hidden}
.statbar .animatedStat i{position:absolute;left:0;bottom:0;width:0;height:3px;background:var(--l);transition:width 1.35s cubic-bezier(.2,.8,.2,1)}
.statbar .animatedStat:has(strong) i{width:100%}
@media(max-width:650px){.globalHeader .brand{min-width:0}.globalHeader .brand img{width:112px}.hero-home .heroCharacter{width:min(520px,108vw);max-height:390px}.hero-home .heroVisual{justify-content:center}}


/* V4.5 â€” homepage visual polish, moving alumni voices, global footer */
.statbar .animatedStat{overflow:visible}
.statbar .animatedStat i{display:none!important}
.statbar .animatedStat:after{display:none!important}

/* Homepage programme cards: preserve full character compositions without affecting programme heroes */
.program{background:#0b4542}
.programArt{object-fit:contain!important;object-position:center 22%!important;padding:18px 18px 0!important;background:linear-gradient(180deg,#dfe8e1 0%,#cbd9d1 52%,#0b4542 100%)!important;transform:none!important}
.program.p0 .programArt{object-position:center 18%!important}
.program.p1 .programArt{object-position:center 18%!important;padding:22px 24px 0!important}
.program.p2 .programArt{object-position:center 18%!important;background:#0a3c39!important;padding:20px 24px 0!important}
.program.p3 .programArt{object-position:center 15%!important;padding:20px 30px 0!important}
.program.p4 .programArt{object-position:center 17%!important;padding:18px 20px 0!important;background:#0a3d3a!important}
.program.p5 .programArt{object-position:center 16%!important;padding:16px 18px 0!important;background:#0a3b38!important}
.programShade{background:linear-gradient(180deg,rgba(5,42,40,0) 40%,rgba(5,42,40,.42) 60%,rgba(5,42,40,.97) 100%)}

/* Animated Africa network is the sole homepage hero visual */
.hero-home .heroCharacter{width:min(690px,50vw);max-height:700px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 28px 42px rgba(0,0,0,.16))}

/* Moving editorial alumni voices */
.voicesLive{padding:105px 0 115px;overflow:hidden;background:#f4f7f2}
.voicesLive .voicesHead{max-width:1260px;margin:0 auto 46px;padding:0 30px;display:grid;grid-template-columns:1fr auto;align-items:end;gap:50px}
.voicesKicker{display:block;font-size:9px;font-weight:800;letter-spacing:.18em;color:#627572;margin-bottom:18px}
.voicesLive .voicesHead h3{max-width:850px;margin:0;font-size:clamp(39px,5.2vw,72px);line-height:.96;letter-spacing:-.065em;color:var(--g)}
.voicesMeta{display:flex;align-items:flex-end;gap:12px;padding-bottom:7px;color:var(--g)}
.voicesMeta strong{font-size:46px;line-height:.85;letter-spacing:-.06em}
.voicesMeta span{font-size:8px;font-weight:800;line-height:1.45;letter-spacing:.08em;text-transform:uppercase;opacity:.55}
.voiceViewport{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.voiceTrack{width:max-content;display:flex;gap:14px;padding:8px 0 22px;animation:womateVoices 46s linear infinite}
.voiceViewport:hover .voiceTrack{animation-play-state:paused}
@keyframes womateVoices{from{transform:translateX(0)}to{transform:translateX(calc(-50% - 7px))}}
.voiceCard{width:390px;min-height:365px;flex:0 0 auto;background:#fff;border:1px solid rgba(14,77,74,.09);border-radius:24px;padding:28px;display:flex;flex-direction:column;box-shadow:0 20px 50px rgba(14,77,74,.055)}
.voiceCard:nth-child(3n+2){background:var(--g);color:#fff;transform:translateY(14px)}
.voiceCard:nth-child(3n+2) .voicePerson span{color:rgba(255,255,255,.57)}
.voiceCard:nth-child(3n+2) .voiceCardTop svg{color:var(--l)}
.voiceCardTop{display:flex;justify-content:space-between;align-items:start}
.voiceCardTop img{width:58px;height:58px;border-radius:50%;object-fit:cover;background:#edf2ed}
.voiceCardTop svg{color:var(--g);opacity:.28}
.voiceCard p{font-size:18px;line-height:1.55;font-weight:700;letter-spacing:-.025em;margin:30px 0 28px;max-width:325px}
.voicePerson{margin-top:auto;padding-top:18px;border-top:1px solid rgba(14,77,74,.12);display:flex;flex-direction:column;gap:4px}
.voiceCard:nth-child(3n+2) .voicePerson{border-color:rgba(255,255,255,.16)}
.voicePerson strong{font-size:12px}.voicePerson span{font-size:9px;font-weight:700;color:#70817e;text-transform:uppercase;letter-spacing:.08em}
.voiceHint{max-width:1260px;margin:16px auto 0;padding:0 30px;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#6d7f7b;display:flex;align-items:center;gap:9px}.voiceHint span{width:24px;height:1px;background:var(--g)}

/* Global-standard footer */
.globalFooter{background:#052e2c;color:#fff;padding:0 clamp(24px,6vw,92px)}
.footerLead{max-width:1420px;margin:auto;padding:82px 0 68px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:100px;border-bottom:1px solid rgba(255,255,255,.15)}
.footerIdentity img{width:178px;filter:brightness(0) invert(1);margin-bottom:34px}
.footerIdentity h3{font-size:clamp(38px,5vw,70px);line-height:.96;letter-spacing:-.065em;margin:0;max-width:900px;font-weight:800}
.footerAction{align-self:end;border-left:1px solid rgba(255,255,255,.15);padding-left:34px}
.footerAction>span,.footerLabel{display:block;color:var(--l);font-size:9px;font-weight:800;letter-spacing:.16em;margin-bottom:16px}
.footerAction p{font-size:13px;line-height:1.7;color:rgba(255,255,255,.64);max-width:390px;margin:0 0 25px}
.footerCta{display:inline-flex;align-items:center;gap:10px;background:var(--l);color:var(--g)!important;border-radius:999px;padding:14px 18px;font-size:11px;font-weight:800}
.footerDirectory{max-width:1420px;margin:auto;padding:54px 0 58px;display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:55px}
.footerDirectory>div{display:flex;flex-direction:column;align-items:flex-start;gap:11px}
.footerDirectory a{color:rgba(255,255,255,.73);font-size:12px;font-weight:650;display:inline-flex;align-items:center;gap:5px;transition:color .2s}
.footerDirectory a:hover{color:var(--l)}
.footerOffice strong{font-size:21px;line-height:1.3;letter-spacing:-.035em;margin-bottom:8px}.footerOffice>a:first-of-type{color:#fff;font-size:13px}
.footerBottom{max-width:1420px;margin:auto;padding:21px 0 25px;border-top:1px solid rgba(255,255,255,.15);display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:30px;color:rgba(255,255,255,.47);font-size:8px;font-weight:700;letter-spacing:.07em;text-transform:uppercase}
.footerBottom>div{display:flex;gap:8px}.footerBottom>div span{border:1px solid rgba(198,255,82,.22);border-radius:999px;padding:7px 9px;color:rgba(255,255,255,.62)}.footerBottom>span:last-child{text-align:right}

@media(max-width:1080px){
  .footerLead{grid-template-columns:1fr;gap:44px}.footerAction{border-left:0;border-top:1px solid rgba(255,255,255,.14);padding:30px 0 0}.footerDirectory{grid-template-columns:1.3fr 1fr 1fr}.footerDirectory>div:last-child{grid-column:2/4}.voiceCard{width:350px}
}
@media(max-width:650px){
  .hero-home .heroCharacter{width:min(570px,112vw);max-height:410px}
  .program{height:390px}.programArt{padding:14px 10px 0!important;object-position:center 16%!important}
  .program.p1 .programArt,.program.p2 .programArt,.program.p3 .programArt,.program.p4 .programArt,.program.p5 .programArt{padding:14px 12px 0!important;object-position:center 14%!important}
  .voicesLive{padding:78px 0 84px}.voicesLive .voicesHead{grid-template-columns:1fr;padding:0 20px;margin-bottom:34px}.voicesMeta{display:none}.voiceViewport{-webkit-mask-image:none;mask-image:none}.voiceCard{width:310px;min-height:340px;padding:23px}.voiceCard p{font-size:16px}.voiceHint{padding:0 20px}
  .globalFooter{padding:0 20px}.footerLead{padding:64px 0 50px}.footerIdentity img{width:145px}.footerIdentity h3{font-size:39px}.footerDirectory{padding:45px 0;grid-template-columns:1fr 1fr;gap:38px 22px}.footerDirectory>div:last-child{grid-column:auto}.footerOffice{grid-column:1/-1}.footerBottom{grid-template-columns:1fr;gap:13px}.footerBottom>div{flex-wrap:wrap}.footerBottom>span:last-child{text-align:left}
}
@media(prefers-reduced-motion:reduce){.voiceTrack{animation:none;transform:none}.voiceViewport{overflow-x:auto}}

/* V4.6 â€” homepage hero community layer, honours symbol, footer refinement */
.hero-home .heroVisual{position:relative}
.hero-home .heroCharacter{max-height:535px}
.communityOverlay{position:absolute;right:2%;bottom:6%;width:min(360px,78%);background:rgba(5,46,44,.88);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:16px 18px;color:#fff;box-shadow:0 22px 60px rgba(0,0,0,.22);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.communityPulse{display:flex;align-items:center;gap:8px;color:var(--l);font-size:8px;font-weight:800;letter-spacing:.14em;margin-bottom:13px}.communityPulse svg{filter:drop-shadow(0 0 7px rgba(198,255,82,.6))}
.communityRow{display:grid;grid-template-columns:auto 1fr;gap:13px;align-items:center}.communityAvatars{display:flex}.communityAvatars img{width:35px;height:35px;border-radius:50%;object-fit:cover;background:#dbe6df;border:2px solid #083b38;margin-left:-8px}.communityAvatars img:first-child{margin-left:0}.communityRow strong{display:block;font-size:11px;line-height:1.3;letter-spacing:-.015em}.communityRow small{display:block;font-size:8px;line-height:1.45;color:rgba(255,255,255,.58);margin-top:3px}
.reportPage{animation:none!important;transform:none!important;opacity:1!important}
.footerIdentity h3{font-size:clamp(30px,3.7vw,52px);line-height:1.02;max-width:820px}
.honourSymbol{display:flex;align-items:center;justify-content:center;min-height:480px}.honourSymbol img{display:block;width:min(560px,100%);max-height:560px;object-fit:contain;filter:drop-shadow(0 28px 34px rgba(0,0,0,.2))}
@media(max-width:1080px){.communityOverlay{right:6%;bottom:4%}.honourSymbol{min-height:360px}}
@media(max-width:650px){.communityOverlay{right:4%;bottom:2%;width:92%;padding:13px 14px;border-radius:15px}.communityRow strong{font-size:10px}.communityRow small{font-size:7px}.communityAvatars img{width:31px;height:31px}.footerIdentity h3{font-size:31px}.honourSymbol{min-height:300px}.honourSymbol img{max-height:360px}}


/* V4.7 â€” responsive honours, verified alumni mapping, homepage card fit, real WoK field collage */
/* Keep the honours title editorial and on one line on wide screens, while preserving generous whitespace. */
@media(min-width:1081px){
  .honours{grid-template-columns:minmax(610px,.95fr) minmax(420px,1.05fr);gap:72px;padding-top:98px;padding-bottom:98px}
  .honours .honourCopy{max-width:700px}
  .honours .honourCopy h3{white-space:nowrap;font-size:clamp(48px,4.25vw,66px);letter-spacing:-.06em}
  .honours .honourCopy p{max-width:620px;font-size:17px;line-height:1.78}
  .honours .honourCount{margin-top:38px}
}
@media(max-width:1080px){
  .honours .honourCopy{max-width:760px}
  .honours .honourCopy h3{white-space:normal;max-width:760px}
  .honours .honourCopy p{max-width:650px}
}

/* Homepage programme cards 04â€“06: preserve complete characters and keep copy legible. */
.program.p3,.program.p4,.program.p5{background:#0b4542}
.program.p3 .programArt,.program.p4 .programArt,.program.p5 .programArt{
  width:100%!important;height:82%!important;top:0!important;bottom:auto!important;
  object-fit:contain!important;object-position:center top!important;padding:18px 18px 0!important;
  background:linear-gradient(180deg,#eaf0eb 0%,#dbe5de 56%,#0b4542 100%)!important;
}
.program.p4 .programArt,.program.p5 .programArt{background:linear-gradient(180deg,#0d4d49 0%,#0b4542 100%)!important}
.program.p3 .programShade,.program.p4 .programShade,.program.p5 .programShade{background:linear-gradient(180deg,rgba(5,42,40,0) 30%,rgba(5,42,40,.22) 56%,rgba(5,42,40,.97) 88%)}
@media(max-width:650px){
  .program.p3 .programArt,.program.p4 .programArt,.program.p5 .programArt{height:80%!important;padding:12px 10px 0!important;object-position:center top!important}
}

/* Give alumni testimony space to breathe rather than compressing the copy into narrow cards. */
.voicesLive .voicesHead{grid-template-columns:minmax(0,1fr) auto}
.voicesLive .voicesHead h3{max-width:none;font-size:clamp(40px,4.55vw,64px);line-height:1;letter-spacing:-.055em}
.voiceCard{width:460px;min-height:340px;padding:30px 32px}
.voiceCard p{max-width:none;font-size:17px;line-height:1.62;margin:30px 0 30px}
@media(max-width:1080px){.voiceCard{width:400px}.voicesLive .voicesHead h3{font-size:clamp(38px,5.2vw,58px)}}
@media(max-width:650px){
  .voiceCard{width:min(86vw,350px);min-height:330px;padding:24px}
  .voicesLive .voicesHead h3{font-size:39px;line-height:1.02}
}

/* The supplied WoK field collage is documentary proof, not a decorative crop. */
.impactPhoto>img{object-fit:cover;object-position:center center;filter:none}

/* V4.8 â€” climate actors artwork refresh */
.facesRail{grid-template-columns:1.08fr repeat(4,minmax(0,.82fr));gap:14px;align-items:stretch}
.faceCard,.characterCard{min-height:420px;background:linear-gradient(180deg,#174f4b 0%,#0a3936 100%);border:1px solid rgba(198,255,82,.08);border-radius:24px}
.faceCard img,.characterCard img{width:100%;height:100%;object-fit:contain;object-position:center bottom;padding:18px 8px 0;filter:drop-shadow(0 20px 24px rgba(0,0,0,.16))}
.faceCard:after,.characterCard:after{background:linear-gradient(180deg,transparent 62%,rgba(2,31,29,.82) 100%)}
.faceCard span,.characterCard span{left:22px;bottom:20px;font-size:10px;letter-spacing:.16em}
@media(max-width:1080px){.facesRail{grid-template-columns:1fr 1fr}.railIntro{grid-column:1/-1}.characterCard{display:block}.faceCard,.characterCard{min-height:360px}}
@media(max-width:650px){.facesRail{grid-template-columns:1fr 1fr}.faceCard,.characterCard{min-height:300px}.f3{display:block}.characterCard{display:block}.faceCard img,.characterCard img{padding:10px 2px 0}}

/* She Leads flagship page */
.sheHero .actions button{font-family:inherit}.sheHero .heroCopy{max-width:760px}.shePage{background:#fff}.sheIntro{max-width:1320px;margin:auto;padding:110px 30px;display:grid;grid-template-columns:140px 1.15fr .75fr;gap:54px;align-items:start}.sheIntroMark{font-size:12px;font-weight:800;letter-spacing:.12em;line-height:1.35;color:var(--g);border-top:3px solid var(--l);padding-top:16px}.sheIntro h2,.shePillars h2,.shePrestige h2,.sheFellows h2{font-size:clamp(40px,5vw,70px);line-height:.98;letter-spacing:-.06em;margin:0}.sheIntro p{font-size:18px;line-height:1.8;color:rgba(14,77,74,.76);margin:0}.shePillars{scroll-margin-top:120px;padding:115px max(30px,calc((100vw - 1320px)/2));background:#f4f8f5}.shePillars header{display:grid;grid-template-columns:170px 1fr 430px;gap:40px;align-items:end;margin-bottom:55px}.shePillars header>span,.prestigeCopy>span,.sheFellows>div>span{font-size:10px;font-weight:800;letter-spacing:.14em;color:var(--g)}.shePillars header p{margin:0;font-size:16px;line-height:1.7;color:rgba(14,77,74,.68)}.shePillarGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.shePillarGrid article{min-height:330px;background:white;border-radius:22px;padding:28px;display:flex;flex-direction:column;position:relative;overflow:hidden;transition:transform .28s ease,box-shadow .28s ease}.shePillarGrid article:hover{transform:translateY(-5px);box-shadow:0 24px 60px rgba(8,61,58,.1)}.pillarTop{display:flex;align-items:center;justify-content:space-between;color:var(--g)}.pillarTop span{font-size:11px;font-weight:800;letter-spacing:.12em}.pillarTop svg{background:var(--l);width:42px;height:42px;padding:10px;border-radius:50%}.shePillarGrid h3{font-size:clamp(25px,2.3vw,34px);line-height:1.04;letter-spacing:-.045em;margin:auto 0 16px;color:var(--g)}.shePillarGrid p{font-size:14px;line-height:1.68;color:rgba(14,77,74,.68);margin:0 0 20px}.pillarLine{height:4px;background:linear-gradient(90deg,var(--l) 0 35%,#dce9df 35% 100%);border-radius:4px}.shePrestige{max-width:1260px;margin:115px auto;display:grid;grid-template-columns:.95fr 1.05fr;gap:70px;align-items:center;background:var(--g);border-radius:30px;padding:70px;color:#fff}.prestigeCopy>span{color:var(--l)}.prestigeCopy p{font-size:17px;line-height:1.8;color:rgba(255,255,255,.7);max-width:580px}.prestigeProof{margin-top:28px;display:flex;align-items:center;gap:10px;font-size:11px;font-weight:800;color:var(--l)}.prestigeCert{background:#fff;border-radius:22px;padding:22px;transform:rotate(1.5deg);box-shadow:0 26px 70px rgba(0,0,0,.18)}.prestigeCert img{display:block;width:100%;max-height:430px;object-fit:contain}.sheFellows{max-width:1260px;margin:0 auto 120px;padding:0 30px;display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:center}.sheFellows p{font-size:17px;line-height:1.8;color:rgba(14,77,74,.7);margin:25px 0}.sheFellows figure{margin:0;background:#eef4ef;border-radius:28px;padding:20px;overflow:hidden}.sheFellows figure img{display:block;width:100%;height:auto;border-radius:18px}.formModal{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:24px}.formBackdrop{position:absolute;inset:0;border:0;background:rgba(3,34,32,.76);backdrop-filter:blur(7px);cursor:pointer}.formPanel{position:relative;width:min(920px,96vw);height:min(820px,92vh);background:white;border-radius:24px;overflow:hidden;box-shadow:0 35px 100px rgba(0,0,0,.32);display:flex;flex-direction:column}.formPanelHead{height:82px;flex:none;padding:0 24px 0 28px;background:var(--g);color:white;display:flex;justify-content:space-between;align-items:center}.formPanelHead div{display:flex;flex-direction:column;gap:4px}.formPanelHead span{font-size:9px;font-weight:800;letter-spacing:.13em;color:var(--l)}.formPanelHead strong{font-size:20px;letter-spacing:-.025em}.formPanelHead button{border:0;background:rgba(255,255,255,.1);color:#fff;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;cursor:pointer}.formPanel iframe{border:0;width:100%;height:100%;background:#fff}
@media(max-width:1080px){.sheIntro{grid-template-columns:110px 1fr}.sheIntro>p{grid-column:2}.shePillars header{grid-template-columns:1fr 2fr}.shePillars header p{grid-column:2}.shePillarGrid{grid-template-columns:repeat(2,1fr)}.shePrestige,.sheFellows{grid-template-columns:1fr}.prestigeCert{max-width:660px;margin:auto}.sheFellows{gap:38px}}
@media(max-width:650px){.sheHero .actions{max-width:none}.sheIntro{padding:75px 20px;grid-template-columns:1fr;gap:24px}.sheIntro>p{grid-column:auto}.sheIntro h2{font-size:40px}.shePillars{padding:80px 16px;scroll-margin-top:85px}.shePillars header{grid-template-columns:1fr;gap:18px;margin-bottom:35px}.shePillars header p{grid-column:auto}.shePillarGrid{grid-template-columns:1fr}.shePillarGrid article{min-height:280px}.shePrestige{margin:75px 16px;padding:38px 24px;border-radius:22px;gap:36px}.prestigeCert{padding:12px}.sheFellows{padding:0 16px;margin-bottom:80px}.formModal{padding:0}.formPanel{width:100vw;height:100dvh;max-height:none;border-radius:0}.formPanelHead{height:72px;padding:0 16px 0 20px}}

/* V4.9.1 â€” She Leads header bug fix + true-alpha certificate reveal */
.shePillars>header{position:static!important;inset:auto!important;height:auto!important;z-index:auto!important;padding:0!important;color:var(--ink)!important;border:0!important;backdrop-filter:none!important;background:none!important;display:grid!important}
.prestigeCert{background:transparent;border-radius:0;padding:0;transform:none;box-shadow:none;overflow:visible}
.prestigeCert img{width:100%;max-height:620px;object-fit:contain;filter:drop-shadow(0 26px 42px rgba(0,0,0,.24))}
@media(max-width:650px){.prestigeCert img{max-height:480px}.shePillars>header{display:grid!important}}

/* V4.10 â€” WoK.Action flagship project page */
.wokHero{min-height:calc(100vh - 104px);background:var(--g);color:#fff;display:grid;grid-template-columns:1.02fr .98fr;align-items:center;padding:70px max(34px,calc((100vw - 1400px)/2));overflow:hidden}
.wokHeroCopy{position:relative;z-index:2;max-width:760px}.wokHeroCopy>span{display:block;font-size:10px;font-weight:800;letter-spacing:.16em;color:var(--l);margin-bottom:28px}.wokHeroCopy h1{font-size:clamp(72px,9vw,138px);line-height:.82;letter-spacing:-.075em;margin:0 0 30px}.wokHeroCopy p{font-size:18px;line-height:1.75;color:rgba(255,255,255,.72);max-width:650px;margin:0 0 34px}.wokHero .actions{display:flex;gap:12px;flex-wrap:wrap}.wokHero .actions button{font-family:inherit}.wokHeroArt{height:100%;display:flex;align-items:flex-end;justify-content:center}.wokHeroArt img{width:min(650px,47vw);max-height:760px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 28px 42px rgba(0,0,0,.16))}
.wokPage{background:#fff;color:var(--g)}.wokTheme{max-width:1320px;margin:auto;padding:105px 30px;display:grid;grid-template-columns:240px 1fr;gap:70px;border-bottom:1px solid rgba(14,77,74,.13)}.wokThemeMeta{display:flex;flex-direction:column;gap:12px;padding-top:8px}.wokThemeMeta span{font-size:10px;font-weight:800;letter-spacing:.15em;color:#71837d}.wokThemeMeta strong{font-size:12px;line-height:1.5}.wokTheme h2{font-size:clamp(42px,5.6vw,76px);line-height:.98;letter-spacing:-.06em;margin:0 0 28px;max-width:980px}.wokTheme p{font-size:18px;line-height:1.75;color:rgba(14,77,74,.68);max-width:780px;margin:0}
.wokPillars{scroll-margin-top:120px;padding:115px max(30px,calc((100vw - 1320px)/2));background:#f3f7f3}.wokSectionHead{display:grid;grid-template-columns:210px 1fr;gap:60px;align-items:start;margin-bottom:55px}.wokSectionHead>span,.wokEvidenceLead>span,.wokFund span{font-size:10px;font-weight:800;letter-spacing:.15em;color:#71837d;padding-top:10px}.wokSectionHead h2,.wokEvidenceLead h2,.wokFund h2{font-size:clamp(42px,5vw,70px);line-height:.98;letter-spacing:-.06em;margin:0;max-width:940px}.wokPillarGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.wokPillarGrid article{min-height:320px;background:#fff;border-radius:22px;padding:28px;display:flex;flex-direction:column;position:relative;transition:transform .25s ease,box-shadow .25s ease}.wokPillarGrid article:hover{transform:translateY(-5px);box-shadow:0 22px 55px rgba(8,61,58,.09)}.wokPillarTop{display:flex;justify-content:space-between;align-items:center}.wokPillarTop span{width:42px;height:42px;border-radius:50%;background:var(--l);display:grid;place-items:center;font-size:11px;font-weight:800}.wokPillarTop small{font-size:9px;font-weight:800;letter-spacing:.13em;color:#7b8b86}.wokPillarGrid h3{font-size:31px;line-height:1.03;letter-spacing:-.045em;margin:auto 0 14px}.wokPillarGrid p{font-size:14px;line-height:1.68;color:rgba(14,77,74,.68);margin:0 0 24px}.wokPillarGrid article>svg{color:var(--g);margin-left:auto}
.wokEvidence{max-width:1320px;margin:auto;padding:120px 30px}.wokEvidenceLead{display:grid;grid-template-columns:210px 1fr;gap:60px;margin-bottom:48px}.wokEvidenceLead p{grid-column:2;font-size:17px;line-height:1.75;color:rgba(14,77,74,.68);max-width:790px;margin:0}.wokCollage{margin:0;background:#e8efe9;border-radius:30px;overflow:hidden;position:relative}.wokCollage img{display:block;width:100%;max-height:780px;object-fit:cover}.wokCollage figcaption{position:absolute;left:24px;bottom:24px;background:rgba(7,52,49,.9);color:#fff;padding:12px 16px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.08em}.wokEvidenceTiles{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.wokEvidenceTiles figure{margin:0;min-height:420px;border-radius:24px;overflow:hidden;background:#eef3ee;position:relative}.wokEvidenceTiles img{width:100%;height:100%;object-fit:cover;display:block}.wokEvidenceTiles span{position:absolute;left:18px;bottom:18px;background:var(--g);color:white;border-radius:999px;padding:10px 14px;font-size:9px;font-weight:800;letter-spacing:.11em}
.wokProof{max-width:1320px;margin:0 auto 110px;padding:0 30px;display:grid;grid-template-columns:180px 180px 180px 1fr;gap:18px;align-items:stretch}.wokProof>div{background:var(--g);color:#fff;border-radius:22px;padding:28px;display:flex;flex-direction:column;justify-content:flex-end;min-height:190px}.wokProof b{font-size:40px;letter-spacing:-.06em;color:var(--l)}.wokProof span{font-size:10px;font-weight:800;letter-spacing:.1em;color:rgba(255,255,255,.66)}.wokProof blockquote{margin:0;background:#f3f7f3;border-radius:22px;padding:34px;font-size:22px;font-weight:800;letter-spacing:-.035em;line-height:1.35}.wokProof cite{display:block;font-style:normal;font-size:10px;font-weight:700;letter-spacing:.06em;color:#75847f;margin-top:28px}
.wokFund{margin:0 auto 115px;max-width:1320px;background:var(--g);color:#fff;border-radius:30px;padding:72px;display:flex;align-items:end;justify-content:space-between;gap:50px}.wokFund span{color:var(--l)}.wokFund h2{max-width:900px;margin-top:16px}.wokFund p{font-size:16px;line-height:1.72;color:rgba(255,255,255,.68);max-width:710px}.wokFund>a{flex:none}
@media(max-width:950px){.wokHero{grid-template-columns:1fr;padding-top:80px}.wokHeroArt{height:460px}.wokHeroArt img{width:min(650px,88vw);max-height:500px}.wokTheme,.wokSectionHead,.wokEvidenceLead{grid-template-columns:1fr;gap:24px}.wokEvidenceLead p{grid-column:1}.wokPillarGrid{grid-template-columns:1fr 1fr}.wokProof{grid-template-columns:repeat(3,1fr)}.wokProof blockquote{grid-column:1/-1}.wokFund{margin-left:20px;margin-right:20px;padding:50px;align-items:flex-start;flex-direction:column}}
@media(max-width:650px){.wokHero{min-height:auto;padding:70px 22px 0}.wokHeroCopy h1{font-size:68px}.wokHeroCopy p{font-size:16px}.wokHeroArt{height:390px}.wokHeroArt img{width:105vw;max-height:410px}.wokTheme{padding:76px 22px}.wokPillars{padding:80px 20px}.wokPillarGrid{grid-template-columns:1fr}.wokPillarGrid article{min-height:285px}.wokEvidence{padding:80px 20px}.wokEvidenceTiles{grid-template-columns:1fr}.wokEvidenceTiles figure{min-height:340px}.wokProof{padding:0 20px;grid-template-columns:1fr}.wokProof blockquote{grid-column:auto}.wokProof>div{min-height:130px}.wokFund{margin:0 16px 85px;padding:34px 24px}.wokCollage img{min-height:420px;object-fit:cover}}

/* V4.10.1 â€” restore classic WoK hero + non-clickable pillar treatment */
.wokHeroClassic{min-height:760px!important;padding:145px clamp(22px,5.6vw,90px) 70px!important;background:#0E4D4A!important}
.wokHeroClassic .heroTop{grid-template-columns:minmax(0,1fr) minmax(430px,1fr)!important;gap:52px!important}
.wokHeroClassic .heroCopy h1{font-size:clamp(54px,7vw,96px)!important;line-height:.92!important;letter-spacing:-.07em!important;max-width:900px!important}
.wokHeroClassic .heroVisual{height:610px!important;justify-content:flex-end!important}
.wokHeroClassic .heroCharacter{max-width:680px!important}
.wokHeroClassic .actions{margin-top:30px!important}
.wokPillarGrid article>svg{display:none!important}
.wokCollage img{object-fit:cover;object-position:center 42%;max-height:720px}
@media(max-width:950px){.wokHeroClassic .heroTop{grid-template-columns:1fr!important}.wokHeroClassic .heroVisual{height:500px!important;justify-content:center!important}}
@media(max-width:650px){.wokHeroClassic{min-height:auto!important;padding:110px 22px 0!important}.wokHeroClassic .heroTop{gap:24px!important}.wokHeroClassic .heroCopy h1{font-size:58px!important}.wokHeroClassic .heroVisual{height:410px!important}.wokHeroClassic .actions{flex-wrap:wrap!important}.wokCollage img{min-height:420px;object-position:center center}}

/* V4.11 â€” Research flagship page */
.researchPage{background:#fff;color:var(--g)}
.researchIntro{max-width:1320px;margin:auto;padding:110px 30px;display:grid;grid-template-columns:250px 1fr;gap:70px;border-bottom:1px solid rgba(14,77,74,.12)}
.researchIntroLabel,.researchSectionHead>span,.researchVisual>div>span,.researchInquiryCopy>span{font-size:10px;font-weight:800;letter-spacing:.15em;color:#75857f;padding-top:10px}
.researchIntro h2,.researchSectionHead h2,.researchBridge h2,.researchVisual h2,.researchInquiry h2{font-size:clamp(44px,5.4vw,76px);line-height:.97;letter-spacing:-.06em;margin:0;max-width:980px}
.researchIntro p{font-size:18px;line-height:1.78;color:rgba(14,77,74,.68);max-width:800px;margin:28px 0 0}
.researchServices{padding:110px max(30px,calc((100vw - 1320px)/2));background:#f4f7f4}.researchSectionHead{display:grid;grid-template-columns:210px 1fr;gap:60px;align-items:start;margin-bottom:55px}
.researchServiceGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.researchServiceGrid article{background:#fff;border-radius:24px;padding:34px;min-height:340px;display:flex;flex-direction:column;border:1px solid rgba(14,77,74,.08)}
.researchServiceTop{display:flex;justify-content:space-between;align-items:center}.researchServiceTop>span{width:42px;height:42px;border-radius:50%;background:var(--l);display:grid;place-items:center;font-size:11px;font-weight:800}.researchServiceTop small{font-size:9px;font-weight:800;letter-spacing:.13em;color:#778780}
.researchServiceGrid h3{font-size:34px;line-height:1.02;letter-spacing:-.045em;margin:54px 0 14px}.researchServiceGrid p{font-size:15px;line-height:1.72;color:rgba(14,77,74,.68);margin:0 0 24px;max-width:590px}
.researchTags{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto}.researchTags span{border:1px solid rgba(14,77,74,.15);border-radius:999px;padding:8px 11px;font-size:9px;font-weight:800;letter-spacing:.04em;color:rgba(14,77,74,.78)}
.researchBridge{max-width:1320px;margin:auto;padding:120px 30px}.researchBridge>div:first-child{display:grid;grid-template-columns:210px 1fr;gap:60px;align-items:start}.researchBridge>div:first-child>span{font-size:10px;font-weight:800;letter-spacing:.15em;color:#75857f;padding-top:10px}.researchBridgeSteps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:55px}.researchBridgeSteps>div{background:var(--g);color:#fff;border-radius:24px;padding:32px;min-height:250px;display:flex;flex-direction:column}.researchBridgeSteps b{color:var(--l);font-size:12px}.researchBridgeSteps strong{font-size:30px;margin:auto 0 12px;letter-spacing:-.04em}.researchBridgeSteps p{font-size:14px;line-height:1.66;color:rgba(255,255,255,.67);margin:0}
.researchVisual{max-width:1320px;margin:0 auto 120px;padding:0 30px;display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center}.researchVisual figure{margin:0;min-height:620px;background:#eef3ee;border-radius:30px;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}.researchVisual figure img{width:100%;height:100%;max-height:690px;object-fit:contain;object-position:center bottom}.researchVisual>div>span{display:block;padding:0;margin-bottom:24px}.researchVisual p{font-size:17px;line-height:1.75;color:rgba(14,77,74,.68);max-width:620px}.researchSignals{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.researchSignals span{background:#edf4ed;border-radius:999px;padding:10px 14px;font-size:10px;font-weight:800}
.researchInquiry{scroll-margin-top:120px;background:var(--g);color:#fff;margin:0 auto 110px;max-width:1320px;border-radius:30px;padding:72px;display:grid;grid-template-columns:.9fr 1.1fr;gap:80px}.researchInquiryCopy>span{color:var(--l);display:block;padding:0;margin-bottom:20px}.researchInquiryCopy p{font-size:16px;line-height:1.72;color:rgba(255,255,255,.68);max-width:570px}.researchInquiry form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.researchInquiry label{display:flex;flex-direction:column;gap:8px;font-size:10px;font-weight:800;letter-spacing:.06em;color:rgba(255,255,255,.72)}.researchInquiry label:nth-child(4){grid-column:1/-1}.researchInquiry input,.researchInquiry textarea{font:inherit;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.07);color:#fff;border-radius:14px;padding:15px 16px;outline:none}.researchInquiry textarea{min-height:150px;resize:vertical}.researchInquiry input::placeholder,.researchInquiry textarea::placeholder{color:rgba(255,255,255,.4)}.researchInquiry button{grid-column:1/-1;justify-self:start;border:0;font-family:inherit;cursor:pointer}
@media(max-width:950px){.researchIntro,.researchSectionHead,.researchBridge>div:first-child,.researchVisual,.researchInquiry{grid-template-columns:1fr;gap:28px}.researchServiceGrid{grid-template-columns:1fr}.researchBridgeSteps{grid-template-columns:1fr}.researchVisual{gap:36px}.researchVisual figure{min-height:500px}.researchInquiry{margin-left:20px;margin-right:20px;padding:50px}}
@media(max-width:650px){.researchIntro{padding:76px 22px}.researchServices{padding:80px 20px}.researchServiceGrid article{padding:26px;min-height:310px}.researchServiceGrid h3{font-size:30px}.researchBridge{padding:80px 20px}.researchVisual{padding:0 20px;margin-bottom:80px}.researchVisual figure{min-height:430px}.researchInquiry{margin:0 16px 80px;padding:34px 22px;border-radius:22px}.researchInquiry form{grid-template-columns:1fr}.researchInquiry label:nth-child(4),.researchInquiry button{grid-column:auto}}

/* CIRCLE â€” premium community architecture */
.circlePage{background:#f7f8f3;color:var(--g)}
.circleIntro{padding:7rem 5vw 6rem;display:grid;grid-template-columns:.7fr 1.3fr;gap:8vw;border-bottom:1px solid rgba(14,77,74,.15)}
.circleIntro>span,.circleSectionHead span,.circlePathCopy>span,.circleJoinCopy>span{font-size:.72rem;font-weight:800;letter-spacing:.16em;color:#52706d}
.circleIntro h2{font-size:clamp(2.6rem,5vw,5.6rem);line-height:.92;letter-spacing:-.06em;margin:0 0 1.5rem;max-width:900px}
.circleIntro p{font-size:1.15rem;line-height:1.7;max-width:720px;color:#49615f}
.circlePromise{padding:6rem 5vw;background:var(--g);color:white}
.circleSectionHead{display:grid;grid-template-columns:.65fr 1.35fr;gap:5vw;align-items:end;margin-bottom:3.5rem}.circleSectionHead span{color:var(--lime)}
.circleSectionHead h2{font-size:clamp(2.3rem,4.6vw,5rem);line-height:.95;letter-spacing:-.05em;margin:0;max-width:900px}
.circlePromiseGrid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,.25)}
.circlePromiseGrid article{padding:3rem 2.4rem 3.5rem 0;border-right:1px solid rgba(255,255,255,.18);min-height:310px}.circlePromiseGrid article+article{padding-left:2.4rem}.circlePromiseGrid article:last-child{border-right:0}
.circlePromiseGrid b{display:block;color:var(--lime);font-size:.75rem;letter-spacing:.14em;margin-bottom:4rem}.circlePromiseGrid h3{font-size:2rem;margin:0 0 1rem}.circlePromiseGrid p{color:#cbd9d6;line-height:1.65;margin:0}
.circlePathways{padding:7rem 5vw}.circlePathways .circleSectionHead span{color:#52706d}.circleTierGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}
.circleTier{background:white;border:1px solid rgba(14,77,74,.15);border-radius:28px;padding:2.2rem;display:flex;flex-direction:column;min-height:510px}.circleTier.featured{background:#eaffae;border-color:#b9e33f}.circleTierTop{display:flex;justify-content:space-between;align-items:center;margin-bottom:3.4rem}.circleTierTop span{font-size:.72rem;font-weight:900;letter-spacing:.14em}.circleTierTop b{font-size:.75rem;border:1px solid currentColor;border-radius:999px;padding:.45rem .7rem}.circleTier h3{font-size:2.2rem;margin:0 0 .4rem}.circlePrice{font-size:1.05rem;font-weight:800;margin-bottom:2rem}.circleTier ul{list-style:none;padding:0;margin:0 0 2rem;display:grid;gap:.9rem}.circleTier li{padding-bottom:.9rem;border-bottom:1px solid rgba(14,77,74,.12);line-height:1.4}.circleTier .pill{margin-top:auto;align-self:flex-start}
.circlePath{padding:7rem 5vw;background:#e8eee8;display:grid;grid-template-columns:.9fr 1.1fr;gap:8vw}.circlePathCopy h2{font-size:clamp(2.6rem,4.8vw,5rem);line-height:.94;letter-spacing:-.05em;margin:1rem 0}.circlePathCopy p{font-size:1.1rem;line-height:1.7;color:#49615f}.circleSteps{display:grid}.circleSteps div{display:grid;grid-template-columns:70px 1fr;gap:1rem;padding:1.8rem 0;border-bottom:1px solid rgba(14,77,74,.18)}.circleSteps b{color:#6b817e}.circleSteps strong{font-size:1.35rem}.circleSteps p{grid-column:2;margin:.3rem 0 0;color:#526966;line-height:1.55}
.circleJoin{padding:7rem 5vw;background:#0b3432;color:white;display:grid;grid-template-columns:.9fr 1.1fr;gap:8vw}.circleJoinCopy>span{color:var(--lime)}.circleJoinCopy h2{font-size:clamp(2.6rem,4.8vw,5rem);line-height:.94;letter-spacing:-.05em;margin:1rem 0}.circleJoinCopy p{color:#c9d9d5;line-height:1.7;max-width:580px}.circleJoinForm{display:grid;gap:1rem}.circleJoinForm label{display:grid;gap:.45rem;font-size:.72rem;font-weight:800;letter-spacing:.08em;color:#c9d9d5}.circleJoinForm input,.circleJoinForm select,.circleJoinForm textarea{width:100%;box-sizing:border-box;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.22);border-radius:14px;padding:1rem 1.1rem;color:white;font:inherit}.circleJoinForm select option{color:#123}.circleJoinForm textarea{min-height:130px;resize:vertical}.circleJoinForm .pill{justify-self:start;border:0}
@media(max-width:900px){.circleIntro,.circleSectionHead,.circlePath,.circleJoin{grid-template-columns:1fr}.circlePromiseGrid,.circleTierGrid{grid-template-columns:1fr}.circlePromiseGrid article,.circlePromiseGrid article+article{padding:2.5rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.18);min-height:0}.circleTier{min-height:0}.circleIntro,.circlePromise,.circlePathways,.circlePath,.circleJoin{padding:4.5rem 6vw}}
/* Circle production integration */
.circleAccess{padding:6rem 5vw;background:#0e4d4a;color:#fff;display:grid;grid-template-columns:1.1fr .9fr;gap:6vw;align-items:end}.circleAccessCopy>span,.circleInquiry>div>span{font-size:.72rem;font-weight:800;letter-spacing:.16em;color:var(--lime)}.circleAccess h2,.circleInquiry h2{font-size:clamp(2.6rem,4.7vw,5rem);line-height:.94;letter-spacing:-.05em;margin:1rem 0}.circleAccess p{color:#cbd9d6;max-width:650px;line-height:1.7}.circleAccessActions{display:flex;gap:.8rem;justify-content:flex-end;flex-wrap:wrap}.circleAccess .ghost{border-color:rgba(255,255,255,.45);color:#fff}.circleInquiry{padding:7rem 5vw;background:#eef2eb;display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.circleInquiry p{color:#526966;line-height:1.7}.circleInquiry form{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.circleInquiry input,.circleInquiry select,.circleInquiry textarea{width:100%;box-sizing:border-box;border:1px solid rgba(14,77,74,.18);background:#fff;border-radius:14px;padding:1rem 1.1rem;font:inherit;color:#123}.circleInquiry textarea{grid-column:1/-1;min-height:150px;resize:vertical}.circleInquiry .pill{grid-column:1/-1;justify-self:start;border:0}.circleSuccess{background:#fff;border-radius:24px;padding:2rem;align-self:start;display:grid;gap:.7rem}.circleSuccess svg{color:var(--g)}.circleSuccess strong{font-size:1.6rem}.circleModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:2vw}.circleModalBackdrop{position:absolute;inset:0;background:rgba(5,28,27,.78);border:0;backdrop-filter:blur(9px)}.circleModalPanel{position:relative;width:min(1180px,96vw);height:min(820px,92vh);background:#f8f8f3;border-radius:28px;overflow:hidden;box-shadow:0 28px 100px rgba(0,0,0,.35);display:grid;grid-template-rows:auto 1fr}.circleModalHead{padding:1.25rem 1.5rem;border-bottom:1px solid rgba(14,77,74,.13);display:flex;justify-content:space-between;align-items:center}.circleModalHead span{font-size:.68rem;letter-spacing:.16em;font-weight:900;color:#66817e}.circleModalHead h2{font-size:1.5rem;margin:.25rem 0 0}.circleModalHead button{border:0;background:#e8eee8;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:var(--g);cursor:pointer}.circleModalBody{min-height:0;display:grid;grid-template-columns:1.45fr .55fr}.circleFormFrame{min-height:0;background:#fff}.circleFormFrame iframe{width:100%;height:100%;border:0}.circleModalBody aside{background:var(--g);color:#fff;padding:2.5rem;display:flex;flex-direction:column;align-items:flex-start}.circleModalBody aside>span{font-size:.68rem;letter-spacing:.16em;font-weight:900;color:var(--lime)}.circleModalBody aside h3{font-size:2.2rem;line-height:1;margin:1rem 0}.circleModalBody aside p{color:#cedbd8;line-height:1.65}.circleModalBody aside .pill{margin-top:1rem;border:0}.circleModalBody aside small{margin-top:auto;color:#9fb6b2;line-height:1.5}
@media(max-width:900px){.circleAccess,.circleInquiry{grid-template-columns:1fr;padding:4.5rem 6vw}.circleAccessActions{justify-content:flex-start}.circleInquiry form{grid-template-columns:1fr}.circleInquiry textarea,.circleInquiry .pill{grid-column:auto}.circleModal{padding:0}.circleModalPanel{width:100vw;height:100dvh;border-radius:0}.circleModalBody{grid-template-columns:1fr;grid-template-rows:minmax(55vh,1fr) auto}.circleModalBody aside{padding:1.4rem}.circleModalBody aside h3{font-size:1.7rem}.circleModalBody aside small{margin-top:1rem}}

/* RESILIENT MINDS â€” restoration / guardianship */
.healPage{background:#f7f8f3;color:var(--g)}
.healIntro{padding:7rem 5vw 6.5rem;display:grid;grid-template-columns:.62fr 1.38fr;gap:8vw;border-bottom:1px solid rgba(14,77,74,.14)}
.healIntro>span,.healSectionHead span,.healWhyCopy>span,.healGuardianStory span,.healInquiry>div>span{font-size:.72rem;font-weight:900;letter-spacing:.16em;color:#58736f}
.healIntro h2{font-size:clamp(2.8rem,5vw,5.7rem);line-height:.92;letter-spacing:-.06em;margin:0 0 1.5rem;max-width:1000px}
.healIntro p{font-size:1.12rem;line-height:1.78;color:#4d6662;max-width:790px}
.healPath{padding:7rem 5vw;background:#0e4d4a;color:#fff}.healSectionHead{display:grid;grid-template-columns:.62fr 1.38fr;gap:5vw;align-items:end;margin-bottom:3.6rem}.healPath .healSectionHead span{color:var(--lime)}.healSectionHead h2{font-size:clamp(2.7rem,4.9vw,5.3rem);line-height:.93;letter-spacing:-.055em;margin:0}
.healPathGrid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid rgba(255,255,255,.24)}.healPathGrid article{padding:2.5rem 2.4rem 3.4rem 0;min-height:360px;border-right:1px solid rgba(255,255,255,.17)}.healPathGrid article+article{padding-left:2.4rem}.healPathGrid article:last-child{border-right:0}.healPathGrid b{font-size:.72rem;letter-spacing:.14em;color:var(--lime)}.healIcon{width:54px;height:54px;border:1px solid rgba(198,255,82,.5);border-radius:50%;display:grid;place-items:center;color:var(--lime);margin:4rem 0 1.8rem}.healPathGrid h3{font-size:2.1rem;margin:0 0 .8rem}.healPathGrid p{color:#c9d9d6;line-height:1.68;max-width:430px}
.healWhy{padding:7rem 5vw;display:grid;grid-template-columns:1fr 1fr;gap:7vw;align-items:center}.healWhyVisual{min-height:620px;background:#e8eee7;border-radius:30px;overflow:hidden;display:grid;place-items:center}.healWhyVisual img{width:100%;height:100%;object-fit:contain;object-position:center bottom}.healWhyCopy h2{font-size:clamp(2.5rem,4.5vw,4.9rem);line-height:.94;letter-spacing:-.055em;margin:1rem 0 1.5rem}.healWhyCopy p{font-size:1.08rem;color:#526966;line-height:1.75;max-width:650px}.healSignals{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2rem}.healSignals span{background:#e8eee8;border-radius:999px;padding:.7rem .95rem;font-size:.72rem;font-weight:800}
.healGuardians{scroll-margin-top:120px;padding:7rem 5vw;background:#ecf1ea}.healGuardians .healSectionHead{margin-bottom:1.2rem}.healGuardianLead{color:#526966;line-height:1.7;max-width:750px;margin:0 0 3.4rem auto;width:68%}.healTierGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.healTier{background:#fff;border:1px solid rgba(14,77,74,.15);border-radius:28px;padding:2.25rem;min-height:440px;display:flex;flex-direction:column}.healTier.featured{background:#eaffae;border-color:#b6df3d}.healTierTop{display:flex;justify-content:space-between;align-items:center;margin-bottom:3.5rem}.healTierTop span{font-size:.72rem;font-weight:900;letter-spacing:.16em}.healTierTop b{font-size:.68rem;border:1px solid currentColor;padding:.45rem .68rem;border-radius:999px}.healTier h3{font-size:2.2rem;margin:0 0 .4rem}.healPrice{font-size:1.35rem;margin-bottom:1.6rem}.healTier p{color:#526966;line-height:1.65}.healTier .pill{margin-top:auto;align-self:flex-start;border:0}
.healGuardianStory{padding:7rem 5vw;background:#0b3432;color:#fff;display:grid;grid-template-columns:1fr 1fr;gap:8vw}.healGuardianStory span{color:var(--lime)}.healGuardianStory h2{font-size:clamp(2.6rem,4.7vw,5.1rem);line-height:.93;letter-spacing:-.055em;margin:1rem 0}.healGuardianStory p{font-size:1.08rem;color:#cbd9d6;line-height:1.75;max-width:620px;margin-bottom:2rem}.healGuardianStory .pill{border:0}
.healInquiry{padding:7rem 5vw;background:#f7f8f3;display:grid;grid-template-columns:.8fr 1.2fr;gap:8vw}.healInquiry h2{font-size:clamp(2.5rem,4.5vw,4.8rem);line-height:.94;letter-spacing:-.055em;margin:1rem 0}.healInquiry p{color:#526966;line-height:1.7}.healInquiry form{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.healInquiry input,.healInquiry textarea{box-sizing:border-box;width:100%;border:1px solid rgba(14,77,74,.18);background:#fff;border-radius:14px;padding:1rem 1.1rem;font:inherit}.healInquiry textarea{grid-column:1/-1;min-height:160px;resize:vertical}.healInquiry .pill{grid-column:1/-1;justify-self:start;border:0}.healInquiry small{grid-column:1/-1;color:#526966}
.healModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:2vw}.healModalBackdrop{position:absolute;inset:0;border:0;background:rgba(5,28,27,.8);backdrop-filter:blur(8px)}.healModalPanel{position:relative;width:min(1040px,95vw);height:min(780px,92vh);background:#f8f8f3;border-radius:28px;overflow:hidden;display:grid;grid-template-rows:auto 1fr;box-shadow:0 30px 100px rgba(0,0,0,.38)}.healModalHead{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;border-bottom:1px solid rgba(14,77,74,.13)}.healModalHead span{font-size:.68rem;font-weight:900;letter-spacing:.16em;color:#66817e}.healModalHead h2{font-size:1.45rem;margin:.2rem 0 0}.healModalHead button{border:0;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:#e8eee8;color:var(--g);cursor:pointer}.healModalBody{min-height:0;background:#fff}.healModalBody iframe{width:100%;height:100%;border:0}.healFormFallback{height:100%;box-sizing:border-box;display:grid;place-content:center;text-align:center;justify-items:center;padding:3rem;color:var(--g)}.healFormFallback h3{font-size:2rem;margin:1rem 0 .5rem}.healFormFallback p{max-width:590px;color:#526966;line-height:1.65}.healFormFallback code{background:#edf2ec;padding:.15rem .35rem;border-radius:5px}
@media(max-width:900px){.healIntro,.healSectionHead,.healWhy,.healGuardianStory,.healInquiry{grid-template-columns:1fr}.healPathGrid,.healTierGrid{grid-template-columns:1fr}.healPathGrid article,.healPathGrid article+article{padding:2.5rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.18);min-height:0}.healIcon{margin:2.2rem 0 1.3rem}.healGuardianLead{width:auto;margin-left:0}.healWhyVisual{min-height:520px}.healInquiry form{grid-template-columns:1fr}.healInquiry textarea,.healInquiry .pill,.healInquiry small{grid-column:auto}.healIntro,.healPath,.healWhy,.healGuardians,.healGuardianStory,.healInquiry{padding:4.8rem 6vw}}
@media(max-width:650px){.healWhyVisual{min-height:420px}.healTier{min-height:0}.healModal{padding:0}.healModalPanel{width:100vw;height:100dvh;border-radius:0}}

/* V4.14 â€” Climate Honours flagship page */
.honoursPage{background:#f7f8f3;color:var(--g)}
.hero-honours .actions button{font-family:inherit;border:0}
.honoursIntro{padding:7rem 5vw 6.5rem;display:grid;grid-template-columns:.52fr 1.48fr .48fr;gap:5vw;align-items:start;border-bottom:1px solid rgba(14,77,74,.14)}
.honoursIntro>span,.honoursSectionHead>span,.honoursArchiveHead span,.honoursBenefits>div>span,.honoursNominate>div>span{font-size:.7rem;font-weight:900;letter-spacing:.16em;color:#58736f}
.honoursIntro h2,.honoursSectionHead h2,.honoursArchiveHead h2,.honoursBenefits h2,.honoursNominate h2{font-size:clamp(2.8rem,5vw,5.7rem);line-height:.92;letter-spacing:-.06em;margin:0}
.honoursIntro p{font-size:1.08rem;line-height:1.78;color:#536a66;max-width:800px;margin:1.7rem 0 0}
.honoursIntro aside{border-left:1px solid rgba(14,77,74,.18);padding-left:2rem;display:flex;flex-direction:column;align-items:flex-start}
.honoursIntro aside b{font-size:clamp(4.8rem,7vw,7.8rem);line-height:.8;letter-spacing:-.08em;color:var(--g)}
.honoursIntro aside span{font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;line-height:1.5;margin:1rem 0 2rem}
.honoursIntro aside button{border:0;background:none;padding:0;font:inherit;font-size:.78rem;font-weight:900;color:var(--g);text-decoration:underline;text-underline-offset:5px;cursor:pointer}
.honoursJourney{padding:7rem 5vw;background:#0e4d4a;color:#fff}.honoursSectionHead{display:grid;grid-template-columns:.55fr 1.2fr .7fr;gap:4vw;align-items:end;margin-bottom:4rem}.honoursJourney .honoursSectionHead>span,.honoursNominate>div>span{color:var(--lime)}.honoursSectionHead p{margin:0;color:#c7d8d4;line-height:1.7;max-width:560px}
.honoursJourneyGrid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.22)}.honoursJourneyGrid article{min-height:330px;padding:2.4rem 2rem 2.8rem 0;border-right:1px solid rgba(255,255,255,.17)}.honoursJourneyGrid article+article{padding-left:2rem}.honoursJourneyGrid article:last-child{border-right:0}.honoursJourneyGrid b{font-size:.7rem;letter-spacing:.14em;color:var(--lime)}.honoursJourneyGrid h3{font-size:2rem;margin:5rem 0 1rem}.honoursJourneyGrid p{color:#c7d8d4;line-height:1.65}
.honoursArchive{scroll-margin-top:120px;padding:7rem 5vw;background:#f7f8f3}.honoursArchiveHead{display:grid;grid-template-columns:1.25fr .75fr;gap:6vw;align-items:end;margin-bottom:3.8rem}.honoursArchiveHead div>span{display:block;margin-bottom:1rem}.honoursArchiveHead p{font-size:1.04rem;line-height:1.75;color:#536a66;margin:0}
.honoursArchiveGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:.8rem}.honoursArchiveGrid figure{margin:0;background:#e8eee8;border-radius:20px;overflow:hidden;min-height:310px;position:relative}.honoursArchiveGrid img{width:100%;height:270px;display:block;object-fit:cover;object-position:center}.honoursArchiveGrid figcaption{padding:1rem 1rem 1.1rem;display:flex;justify-content:space-between;gap:.5rem;align-items:center}.honoursArchiveGrid figcaption span{font-size:.68rem;font-weight:900;color:#6a807c}.honoursArchiveGrid figcaption b{font-size:.7rem;text-transform:uppercase;letter-spacing:.05em}
.honoursPathways{padding:7rem 5vw;background:#edf2eb}.honoursPathways .honoursSectionHead{color:var(--g)}.honoursPathways .honoursSectionHead p{color:#536a66}.honoursPathwayGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.honoursPathwayGrid article{background:white;border:1px solid rgba(14,77,74,.12);border-radius:26px;padding:2.4rem;min-height:340px}.honoursPathwayGrid span{font-size:.7rem;font-weight:900;letter-spacing:.14em;color:#627b76}.honoursPathwayGrid h3{font-size:2.25rem;letter-spacing:-.04em;margin:5rem 0 1rem}.honoursPathwayGrid p{line-height:1.7;color:#536a66;max-width:430px}
.honoursBenefits{padding:7rem 5vw;background:#fff;display:grid;grid-template-columns:.85fr 1.15fr;gap:8vw}.honoursBenefits h2{margin-top:1rem}.honoursBenefitList{border-top:1px solid rgba(14,77,74,.17)}.honoursBenefitList p{margin:0;padding:1.45rem 0;border-bottom:1px solid rgba(14,77,74,.17);font-size:1.05rem;font-weight:700}
.honoursNominate{padding:7rem 5vw;background:#0b3432;color:#fff;display:grid;grid-template-columns:1fr auto;gap:5vw;align-items:end}.honoursNominate h2{max-width:950px;margin-top:1rem}.honoursNominate p{max-width:700px;color:#c8d8d5;line-height:1.75;font-size:1.05rem}.honoursNominate>.pill{border:0;white-space:nowrap}
.honoursModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:2vw}.honoursModalBackdrop{position:absolute;inset:0;border:0;background:rgba(5,28,27,.82);backdrop-filter:blur(9px)}.honoursModalPanel{position:relative;width:min(1040px,96vw);height:min(840px,93vh);background:#fff;border-radius:28px;overflow:hidden;display:grid;grid-template-rows:auto 1fr;box-shadow:0 30px 110px rgba(0,0,0,.4)}.honoursModalHead{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 1.5rem;background:#0e4d4a;color:#fff}.honoursModalHead span{font-size:.66rem;font-weight:900;letter-spacing:.16em;color:var(--lime)}.honoursModalHead h2{font-size:1.45rem;margin:.2rem 0 0}.honoursModalHead button{border:0;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.12);color:#fff;cursor:pointer}.honoursModalPanel iframe{width:100%;height:100%;border:0;background:#fff}
@media(max-width:1100px){.honoursIntro{grid-template-columns:1fr 1.5fr}.honoursIntro aside{grid-column:2}.honoursSectionHead{grid-template-columns:1fr 1.5fr}.honoursSectionHead p{grid-column:2}.honoursJourneyGrid{grid-template-columns:repeat(2,1fr)}.honoursJourneyGrid article:nth-child(2){border-right:0}.honoursArchiveGrid{grid-template-columns:repeat(3,1fr)}.honoursArchiveHead,.honoursBenefits{grid-template-columns:1fr}}
@media(max-width:700px){.honoursIntro,.honoursSectionHead,.honoursArchiveHead,.honoursBenefits,.honoursNominate{grid-template-columns:1fr}.honoursIntro,.honoursJourney,.honoursArchive,.honoursPathways,.honoursBenefits,.honoursNominate{padding:4.8rem 6vw}.honoursIntro aside{grid-column:auto;border-left:0;border-top:1px solid rgba(14,77,74,.18);padding:2rem 0 0}.honoursSectionHead p{grid-column:auto}.honoursJourneyGrid,.honoursPathwayGrid{grid-template-columns:1fr}.honoursJourneyGrid article,.honoursJourneyGrid article+article{min-height:0;padding:2rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.18)}.honoursJourneyGrid h3{margin:2.3rem 0 .8rem}.honoursArchiveGrid{grid-template-columns:repeat(2,1fr)}.honoursArchiveGrid figure{min-height:0}.honoursArchiveGrid img{height:220px}.honoursPathwayGrid article{min-height:280px}.honoursPathwayGrid h3{margin:3.2rem 0 1rem}.honoursNominate{align-items:start}.honoursModal{padding:0}.honoursModalPanel{width:100vw;height:100dvh;border-radius:0}.honoursModalHead{padding:1rem 1.1rem}}

/* Honours archive year system */
.honoursYearTabs{display:flex;gap:.65rem;flex-wrap:wrap;margin:-1.3rem 0 2.4rem;padding-bottom:1.4rem;border-bottom:1px solid rgba(14,77,74,.14)}
.honoursYearTabs button{border:1px solid rgba(14,77,74,.2);background:transparent;color:#0E4D4A;border-radius:999px;padding:.8rem 1.15rem;font:800 .78rem/1 Manrope,sans-serif;letter-spacing:.04em;cursor:pointer;display:flex;align-items:center;gap:.65rem;transition:.2s ease}
.honoursYearTabs button small{font-size:.6rem;font-weight:800;letter-spacing:.03em;opacity:.65;text-transform:uppercase}
.honoursYearTabs button.active,.honoursYearTabs button:hover{background:#0E4D4A;color:#fff;border-color:#0E4D4A}
.honoursLockedYear{min-height:420px;border-radius:28px;background:#0E4D4A;color:#fff;padding:clamp(2rem,5vw,5rem);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;position:relative;overflow:hidden}
.honoursLockedYear:after{content:'2026';position:absolute;right:-.04em;bottom:-.22em;font-weight:900;font-size:clamp(8rem,24vw,25rem);line-height:1;color:rgba(198,255,82,.07);letter-spacing:-.08em;pointer-events:none}
.honoursLockedYear>span{font-weight:900;letter-spacing:.16em;font-size:.75rem;color:#C6FF52}
.honoursLockedYear h3{font-size:clamp(2.5rem,5vw,5rem);line-height:.95;letter-spacing:-.055em;max-width:760px;margin:1.1rem 0}
.honoursLockedYear p{max-width:680px;font-size:1.02rem;line-height:1.7;color:rgba(255,255,255,.72);margin:0 0 1.8rem}
@media(max-width:700px){.honoursYearTabs{margin-top:0}.honoursYearTabs button{flex:1;justify-content:center}.honoursLockedYear{min-height:360px;border-radius:20px}.honoursLockedYear:after{font-size:11rem}}

.honoursArchive{position:relative;overflow:hidden}
.honoursArchiveSymbol{position:absolute;right:clamp(22px,6vw,96px);top:clamp(24px,5vw,70px);width:clamp(120px,17vw,260px);height:clamp(120px,17vw,260px);pointer-events:none;z-index:0;opacity:.96}
.honoursArchiveSymbol img{width:100%;height:100%;object-fit:contain;display:block}
.honoursArchiveHead,.honoursYearTabs,.honoursArchiveGrid,.honoursLockedYear{position:relative;z-index:1}
.honoursArchiveHead{padding-right:clamp(150px,22vw,330px)}
@media(max-width:760px){.honoursArchiveSymbol{position:relative;right:auto;top:auto;width:112px;height:112px;margin:0 0 18px auto}.honoursArchiveHead{padding-right:0}}


/* V4.15 â€” Leadership institutional page */
.leadershipPage{background:#f7f8f3;color:var(--g)}
.hero-leadership .actions button{font-family:inherit;border:0;cursor:pointer}
.leadershipMandate{padding:7rem 5vw;display:grid;grid-template-columns:1.05fr .95fr;gap:8vw;border-bottom:1px solid rgba(14,77,74,.15)}
.leadershipMandate span,.leadershipSectionHead>span,.leadershipImpact>div>span,.leadershipPartner>div>span{font-size:.7rem;font-weight:900;letter-spacing:.16em;color:#607b76}
.leadershipMandate h2,.leadershipSectionHead h2,.leadershipImpact h2,.leadershipPartner h2{font-size:clamp(2.8rem,5vw,5.6rem);line-height:.94;letter-spacing:-.06em;margin:1rem 0 0}
.leadershipMandate p{font-size:1.08rem;line-height:1.8;color:#526964;margin:0 0 1.15rem;max-width:720px}
.leadershipTeam{padding:7rem 5vw;background:#fff}
.leadershipSectionHead{display:grid;grid-template-columns:.5fr 1.15fr .7fr;gap:4vw;align-items:end;margin-bottom:4rem}.leadershipSectionHead p{margin:0;color:#5b706c;line-height:1.7;max-width:560px}
.leadershipProfileGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.1rem}.leadershipProfile{display:grid;grid-template-columns:minmax(230px,.85fr) 1.15fr;min-height:420px;background:#f0f4ef;border-radius:28px;overflow:hidden}.leadershipProfile figure{position:relative;margin:0;min-height:420px;background:#dfe8df}.leadershipProfile figure img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}.leadershipProfile figure:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 62%,rgba(6,45,43,.82))}.leadershipProfile figcaption{position:absolute;z-index:2;left:1.15rem;right:1.15rem;bottom:1rem;color:#fff;display:flex;justify-content:space-between;align-items:center}.leadershipProfile figcaption span,.leadershipProfile figcaption b{font-size:.66rem;letter-spacing:.14em}.leadershipProfile figcaption b{color:var(--l)}.leadershipProfileCopy{padding:2.1rem;display:flex;flex-direction:column;justify-content:flex-end}.leadershipProfileCopy>span{font-size:.68rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase;color:#65807a}.leadershipProfileCopy h3{font-size:clamp(2rem,3vw,3.4rem);line-height:.96;letter-spacing:-.055em;margin:.75rem 0 1.1rem}.leadershipProfileCopy p{font-size:.98rem;line-height:1.7;color:#536a66;margin:0}
.leadershipDisciplines{padding:7rem 5vw;background:#0e4d4a;color:#fff}.leadershipDisciplines .leadershipSectionHead>span{color:var(--l)}.leadershipDisciplines .leadershipSectionHead{grid-template-columns:.5fr 1.5fr}.leadershipDisciplineGrid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.2)}.leadershipDisciplineGrid article{padding:2.3rem 2rem 2.8rem 0;min-height:330px;border-right:1px solid rgba(255,255,255,.17)}.leadershipDisciplineGrid article+article{padding-left:2rem}.leadershipDisciplineGrid article:last-child{border-right:0}.leadershipDisciplineGrid b{font-size:.7rem;color:var(--l);letter-spacing:.14em}.leadershipDisciplineGrid h3{font-size:2.1rem;margin:5rem 0 1rem}.leadershipDisciplineGrid p{color:#c9d9d6;line-height:1.7;margin:0}
.leadershipImpact{padding:7rem 5vw;background:#edf2eb;display:grid;grid-template-columns:.9fr 1.1fr;gap:7vw}.leadershipImpact h2{margin-top:1rem}.leadershipImpactProof{border-top:1px solid rgba(14,77,74,.18)}.leadershipImpactProof article{display:grid;grid-template-columns:170px 1fr;gap:2rem;padding:1.5rem 0;border-bottom:1px solid rgba(14,77,74,.18);align-items:start}.leadershipImpactProof strong{font-size:1.25rem}.leadershipImpactProof p{margin:0;color:#586e69;line-height:1.65}
.leadershipPartner{padding:7rem 5vw;background:#0a3432;color:#fff;display:grid;grid-template-columns:.9fr 1.1fr;gap:8vw}.leadershipPartner>div>span{color:var(--l)}.leadershipPartner h2{margin:1rem 0 1.5rem}.leadershipPartner>div p{color:#c8d8d5;line-height:1.75;max-width:650px}.leadershipPartner>div a{display:inline-block;color:var(--l);font-weight:800;margin-top:1rem}.leadershipPartner form{display:grid;grid-template-columns:1fr 1fr;gap:.85rem}.leadershipPartner input,.leadershipPartner select,.leadershipPartner textarea{width:100%;box-sizing:border-box;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.07);color:#fff;border-radius:14px;padding:1rem 1.05rem;font:600 .92rem/1.3 Manrope,sans-serif}.leadershipPartner input::placeholder,.leadershipPartner textarea::placeholder{color:rgba(255,255,255,.58)}.leadershipPartner select option{color:#123;background:#fff}.leadershipPartner textarea{grid-column:1/-1;min-height:150px;resize:vertical}.leadershipPartner button,.leadershipPartner small{grid-column:1/-1}.leadershipPartner small{color:#c9d8d5}.leadershipPartner .formError{color:#ffd1d1}
@media(max-width:1050px){.leadershipMandate,.leadershipImpact,.leadershipPartner{grid-template-columns:1fr}.leadershipSectionHead{grid-template-columns:1fr 1.4fr}.leadershipSectionHead p{grid-column:2}.leadershipProfileGrid{grid-template-columns:1fr}.leadershipDisciplineGrid{grid-template-columns:repeat(2,1fr)}.leadershipDisciplineGrid article:nth-child(2){border-right:0}}
@media(max-width:700px){.leadershipMandate,.leadershipTeam,.leadershipDisciplines,.leadershipImpact,.leadershipPartner{padding:4.8rem 6vw}.leadershipSectionHead{grid-template-columns:1fr}.leadershipSectionHead p{grid-column:auto}.leadershipProfile{grid-template-columns:1fr;min-height:0}.leadershipProfile figure{min-height:420px}.leadershipProfileCopy{padding:1.7rem 1.5rem 2rem}.leadershipDisciplineGrid{grid-template-columns:1fr}.leadershipDisciplineGrid article,.leadershipDisciplineGrid article+article{min-height:0;padding:2rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.17)}.leadershipDisciplineGrid h3{margin:2.4rem 0 .8rem}.leadershipImpactProof article{grid-template-columns:1fr;gap:.55rem}.leadershipPartner form{grid-template-columns:1fr}.leadershipPartner textarea,.leadershipPartner button,.leadershipPartner small{grid-column:auto}}

.leadershipLinkedin{display:inline-flex;align-items:center;gap:.45rem;margin-top:1rem;font-size:.78rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:inherit;border-bottom:1px solid currentColor;padding-bottom:.2rem;opacity:.82}.leadershipLinkedin:hover{opacity:1}

/* WOMATEER flagship page */
.womateerPage{background:#fff;color:#0E4D4A}
.womateerIntro,.womateerRoles,.womateerStandard,.womateerJourney,.womateerWhy,.womateerInquiry{padding:clamp(72px,8vw,128px) clamp(22px,6vw,96px)}
.womateerIntro{display:grid;grid-template-columns:.7fr 1.5fr;gap:clamp(30px,7vw,120px);align-items:start;border-bottom:1px solid rgba(14,77,74,.14)}
.womateerIntro>span,.womateerSectionHead>span,.womateerStandard>div:first-child>span,.womateerWhy>div:nth-child(2)>span,.womateerInquiry>div>span{font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
.womateerIntro h2,.womateerSectionHead h2,.womateerStandard h2,.womateerJourney h2,.womateerWhy h2,.womateerInquiry h2{font-size:clamp(38px,5vw,70px);line-height:.98;letter-spacing:-.055em;margin:0 0 24px;font-weight:800}
.womateerIntro p,.womateerSectionHead p,.womateerWhy p,.womateerInquiry p{font-size:clamp(17px,1.6vw,21px);line-height:1.65;max-width:850px;color:rgba(14,77,74,.78)}
.womateerRoles{background:#f4f7f5}
.womateerSectionHead{display:grid;grid-template-columns:1fr 1.6fr;column-gap:50px;margin-bottom:54px}.womateerSectionHead>span{grid-row:1/4}.womateerSectionHead h2,.womateerSectionHead p{grid-column:2}
.womateerRoleGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.womateerRoleGrid article{background:#fff;border-radius:26px;padding:32px;min-height:390px;display:flex;flex-direction:column;border:1px solid rgba(14,77,74,.12);transition:transform .25s ease,box-shadow .25s ease}.womateerRoleGrid article:hover{transform:translateY(-4px);box-shadow:0 18px 50px rgba(14,77,74,.1)}
.womateerRoleTop{display:flex;justify-content:space-between;gap:20px;align-items:center}.womateerRoleTop>span{font-size:13px;font-weight:800}.womateerRoleTop small{font-size:11px;text-transform:uppercase;letter-spacing:.12em;font-weight:800;background:#C6FF52;padding:9px 12px;border-radius:999px}.womateerRoleGrid h3{font-size:clamp(28px,3vw,44px);letter-spacing:-.04em;margin:50px 0 14px}.womateerRoleGrid p{line-height:1.65;color:rgba(14,77,74,.72);font-size:16px}.womateerSkills{display:flex;flex-wrap:wrap;gap:7px;margin-top:auto;padding-top:28px}.womateerSkills span{border:1px solid rgba(14,77,74,.2);border-radius:999px;padding:8px 11px;font-size:11px;font-weight:700}.womateerRoleGrid article>button{border:0;background:none;text-align:left;padding:20px 0 0;font:inherit;font-weight:800;color:#0E4D4A;cursor:pointer}
.womateerStandard{background:#0E4D4A;color:#fff}.womateerStandard>div:first-child{display:grid;grid-template-columns:.75fr 1.5fr;gap:40px;margin-bottom:55px}.womateerCommitGrid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid rgba(255,255,255,.2)}.womateerCommitGrid article{padding:30px 24px 20px 0;border-right:1px solid rgba(255,255,255,.18);min-height:260px}.womateerCommitGrid article+article{padding-left:24px}.womateerCommitGrid b{color:#C6FF52;font-size:13px}.womateerCommitGrid h3{font-size:23px;margin:54px 0 12px}.womateerCommitGrid p{color:rgba(255,255,255,.7);line-height:1.6;font-size:15px}
.womateerJourney{background:#fff}.womateerJourneyGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:34px}.womateerJourneyGrid>div{padding:26px;border-radius:20px;background:#eff4f1;min-height:230px}.womateerJourneyGrid b{font-size:12px}.womateerJourneyGrid strong{display:block;font-size:21px;margin:52px 0 12px}.womateerJourneyGrid p{font-size:14px;line-height:1.55;color:rgba(14,77,74,.7)}
.womateerWhy{display:grid;grid-template-columns:.45fr 1.25fr 1fr;gap:45px;background:#C6FF52;align-items:center}.womateerWhyMark{font-size:clamp(100px,13vw,210px);font-weight:800;line-height:.8;opacity:.22}.womateerProof{display:grid;grid-template-columns:1fr 1fr;gap:8px}.womateerProof span{background:#0E4D4A;color:#fff;padding:18px;border-radius:14px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:.08em}
.womateerInquiry{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,8vw,120px);background:#f4f7f5}.womateerInquiry form{display:grid;gap:10px}.womateerInquiry input,.womateerInquiry select,.womateerInquiry textarea{width:100%;border:1px solid rgba(14,77,74,.2);background:#fff;border-radius:13px;padding:16px;font:inherit;color:#0E4D4A}.womateerInquiry textarea{min-height:140px;resize:vertical}.womateerInquiry small{font-size:12px;color:rgba(14,77,74,.7)}
.womateerModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:24px}.womateerBackdrop{position:absolute;inset:0;border:0;background:rgba(3,28,27,.78);backdrop-filter:blur(10px)}.womateerModalPanel{position:relative;width:min(1040px,95vw);height:min(860px,92vh);background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 30px 90px rgba(0,0,0,.35);display:flex;flex-direction:column}.womateerModalHead{padding:22px 26px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid rgba(14,77,74,.12)}.womateerModalHead span{font-size:10px;font-weight:800;letter-spacing:.14em}.womateerModalHead h2{font-size:28px;margin:3px 0}.womateerModalHead p{margin:0;font-size:13px;color:rgba(14,77,74,.65)}.womateerModalHead>button{border:0;background:#eff4f1;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;color:#0E4D4A;cursor:pointer}.womateerModal iframe{border:0;width:100%;height:100%;flex:1}
@media(max-width:900px){.womateerIntro,.womateerSectionHead,.womateerStandard>div:first-child,.womateerInquiry{grid-template-columns:1fr}.womateerSectionHead>span,.womateerSectionHead h2,.womateerSectionHead p{grid-column:auto;grid-row:auto}.womateerRoleGrid,.womateerJourneyGrid,.womateerCommitGrid{grid-template-columns:1fr 1fr}.womateerWhy{grid-template-columns:.3fr 1fr}.womateerProof{grid-column:1/-1}.womateerCommitGrid article{border-bottom:1px solid rgba(255,255,255,.18)}}
@media(max-width:620px){.womateerRoleGrid,.womateerJourneyGrid,.womateerCommitGrid,.womateerWhy{grid-template-columns:1fr}.womateerCommitGrid article,.womateerCommitGrid article+article{padding-left:0;border-right:0}.womateerWhyMark{font-size:90px}.womateerModal{padding:0}.womateerModalPanel{width:100vw;height:100dvh;max-height:none;border-radius:0}.hero-volunteer .actions{flex-wrap:wrap}}
/* V4.19 â€” The Vault */
.merchHero{min-height:720px}.merchHero .heroTop{align-items:center}.merchHeroStack{height:560px;position:relative;display:flex;align-items:end;justify-content:center}.merchHeroStack img{position:absolute;max-height:520px;max-width:62%;object-fit:contain;filter:drop-shadow(0 26px 28px rgba(0,0,0,.18))}.merchHeroStack img:first-child{left:2%;transform:rotate(-5deg);z-index:2}.merchHeroStack img:last-child{right:1%;transform:rotate(6deg)}
.merchPage{background:#fff}.merchIntro{max-width:1260px;margin:auto;padding:110px 30px 80px;display:grid;grid-template-columns:180px 1fr 180px;gap:50px;align-items:start}.merchIntro>span,.vaultBuy>span{font-size:10px;font-weight:850;letter-spacing:.13em;color:var(--g)}.merchIntro h2{font-size:clamp(50px,6.4vw,86px);line-height:.94;letter-spacing:-.07em;margin:0 0 22px;color:var(--g)}.merchIntro p{max-width:760px;font-size:18px;line-height:1.75;color:rgba(14,77,74,.72)}.merchIntro aside{border-left:1px solid var(--line);padding-left:28px}.merchIntro aside b{font-size:34px;color:var(--g);display:block}.merchIntro aside small{font-size:11px;text-transform:uppercase;letter-spacing:.1em;opacity:.55}
.vaultShop{max-width:1260px;margin:0 auto 100px;padding:0 30px;display:grid;grid-template-columns:1.08fr .92fr;gap:68px;align-items:center}.vaultStage{min-width:0}.vaultImage{height:660px;border-radius:34px;position:relative;overflow:hidden;display:grid;place-items:center;padding:40px}.vaultImage.whiteStage{background:#eef2ed}.vaultImage.greenStage{background:#082f2d}.vaultImage img{width:100%;height:100%;object-fit:contain;transition:.25s}.vaultImage>span{position:absolute;left:24px;top:24px;background:var(--l);color:var(--g);border-radius:999px;padding:9px 12px;font-size:9px;font-weight:850;letter-spacing:.1em}.vaultViewToggle{display:flex;gap:8px;margin-top:14px}.vaultViewToggle button{border:1px solid var(--line);background:#fff;padding:11px 18px;border-radius:999px;font-weight:800;color:var(--g)}.vaultViewToggle button.active{background:var(--g);color:#fff;border-color:var(--g)}
.vaultBuy h2{font-size:clamp(42px,5vw,68px);line-height:.95;letter-spacing:-.065em;margin:12px 0 25px;color:var(--g)}.vaultBuy>p{font-size:16px;line-height:1.75;color:rgba(14,77,74,.68);margin:25px 0}.vaultVariants{display:grid;grid-template-columns:1fr 1fr;gap:10px}.vaultVariants>button{display:grid;grid-template-columns:72px 1fr;gap:12px;align-items:center;text-align:left;padding:10px;border:1px solid var(--line);border-radius:17px;background:#fff;color:var(--g)}.vaultVariants>button.active{border:2px solid var(--g);background:#f5f8f4}.vaultVariants img{width:72px;height:82px;object-fit:contain}.vaultVariants b,.vaultVariants small{display:block}.vaultVariants small{margin-top:4px;opacity:.55}.vaultOption,.vaultQty{margin-top:24px}.vaultOption>label,.vaultQty>label{display:block;font-size:10px;font-weight:850;letter-spacing:.11em;text-transform:uppercase;margin-bottom:10px;color:var(--g)}.vaultOption>div{display:flex;gap:7px;flex-wrap:wrap}.vaultOption button{width:48px;height:42px;border:1px solid var(--line);border-radius:10px;background:#fff;font-weight:800;color:var(--g)}.vaultOption button.active{background:var(--g);color:#fff;border-color:var(--g)}.vaultQty>div{display:flex;align-items:center;gap:0}.vaultQty button,.vaultQty strong{height:42px;min-width:44px;border:1px solid var(--line);display:grid;place-items:center;background:#fff;color:var(--g)}.vaultQty button:first-child{border-radius:10px 0 0 10px}.vaultQty button:last-child{border-radius:0 10px 10px 0}.vaultTotal{display:flex;justify-content:space-between;align-items:end;margin:28px 0 18px;padding-top:20px;border-top:1px solid var(--line);color:var(--g)}.vaultTotal span{font-size:11px;text-transform:uppercase;font-weight:850;letter-spacing:.1em}.vaultTotal strong{font-size:34px;letter-spacing:-.04em}.vaultCheckout{width:100%;justify-content:center}.vaultNote{display:block;margin-top:12px;opacity:.55;line-height:1.5}
.vaultDetails{max-width:1260px;margin:0 auto 120px;padding:0 30px;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.vaultDetails article{padding:38px 34px 38px 0;border-right:1px solid var(--line)}.vaultDetails article+article{padding-left:34px}.vaultDetails article:last-child{border-right:0}.vaultDetails span{font-size:10px;font-weight:850;letter-spacing:.12em;color:var(--g);opacity:.45}.vaultDetails h3{font-size:28px;letter-spacing:-.045em;color:var(--g);margin:18px 0 12px}.vaultDetails p{line-height:1.7;color:rgba(14,77,74,.68)}
.vaultModal{position:fixed;inset:0;z-index:130;display:grid;place-items:center;padding:24px}.vaultModalBackdrop{position:absolute;inset:0;border:0;background:rgba(2,30,29,.78);backdrop-filter:blur(8px)}.vaultModalPanel{position:relative;z-index:2;width:min(580px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:26px;padding:28px}.vaultModalHead{display:flex;justify-content:space-between;align-items:start}.vaultModalHead span{font-size:9px;font-weight:850;letter-spacing:.12em;color:var(--g)}.vaultModalHead h2{font-size:36px;letter-spacing:-.055em;margin:5px 0 0;color:var(--g)}.vaultModalHead button{border:0;background:#eef3ed;width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--g)}.vaultOrderSummary{display:grid;grid-template-columns:90px 1fr;gap:16px;align-items:center;margin:24px 0;padding:14px;border-radius:18px;background:#f0f4ef}.vaultOrderSummary img{width:90px;height:90px;object-fit:contain}.vaultOrderSummary b,.vaultOrderSummary span,.vaultOrderSummary strong{display:block;color:var(--g)}.vaultOrderSummary span{font-size:12px;opacity:.6;margin:4px 0}.vaultOrderSummary strong{font-size:22px}.vaultModal form{display:grid;gap:10px}.vaultModal input,.vaultModal textarea{border:1px solid var(--line);border-radius:12px;padding:14px 15px;font:inherit;color:var(--g)}.vaultModal textarea{min-height:100px;resize:vertical}.vaultModal form>small{color:var(--g);line-height:1.5}
@media(max-width:900px){.merchIntro{grid-template-columns:1fr}.merchIntro aside{border-left:0;border-top:1px solid var(--line);padding:20px 0 0}.vaultShop{grid-template-columns:1fr}.vaultImage{height:560px}.vaultDetails{grid-template-columns:1fr}.vaultDetails article,.vaultDetails article+article{border-right:0;border-bottom:1px solid var(--line);padding:28px 0}.merchHeroStack{height:440px}}
@media(max-width:650px){.merchHero{min-height:730px}.merchHeroStack{height:330px;margin-top:25px}.merchHeroStack img{max-height:310px;max-width:68%}.merchIntro{padding:75px 20px 50px}.vaultShop{padding:0 16px;gap:35px}.vaultImage{height:430px;border-radius:22px;padding:22px}.vaultVariants{grid-template-columns:1fr}.vaultDetails{padding:0 20px;margin-bottom:80px}.vaultModal{padding:12px}.vaultModalPanel{border-radius:20px;padding:20px}}

/* Funding 2027 */
.fundingHero{background:#073f3b;color:#fff;min-height:86vh}.fundingHero .heroTop{align-items:center}.fundingHero .heroCopy{max-width:780px}.fundingHero .heroCopy h1{font-size:clamp(3.6rem,7vw,7.8rem);line-height:.88;letter-spacing:-.065em;margin:.8rem 0 1.2rem}.fundingHero .heroCopy>p{max-width:620px;color:#d2e2dc;font-size:1.12rem}.fundingKicker{font-size:.7rem;letter-spacing:.18em;color:#baff38}.fundingOrb{min-height:590px;display:grid;place-items:center;position:relative}.fundingOrb:before,.fundingOrb:after{content:"";position:absolute;border:1px solid #baff38;border-radius:50%;width:82%;height:45%;transform:rotate(-22deg)}.fundingOrb:after{width:58%;height:76%;transform:rotate(38deg);opacity:.5}.fundingTicket{position:relative;z-index:2;width:min(360px,70%);aspect-ratio:.72;background:linear-gradient(145deg,#f8f5e9,#dfe7d8);color:#073f3b;border-radius:24px;box-shadow:0 35px 90px #0007;padding:2.5rem;display:flex;flex-direction:column;justify-content:center;transform:rotate(6deg)}.fundingTicket small{letter-spacing:.25em}.fundingTicket strong{font-size:clamp(2.2rem,4vw,4rem);line-height:.9;margin:1rem 0}.fundingTicket span{border-top:1px solid #073f3b55;padding-top:1rem;font-size:.7rem;letter-spacing:.14em}.fundingPage{background:#f5f7f2;color:#073f3b}.fundingClosed{padding:1.25rem clamp(1.5rem,7vw,8rem);background:#baff38;display:flex;gap:2rem;align-items:center}.fundingClosed p{margin:0;max-width:850px}.fundingIntro{padding:8rem clamp(1.5rem,7vw,8rem) 4rem;max-width:1500px;margin:auto}.fundingIntro>span,.fundingRegister span,.fundingCTA>span{font-size:.7rem;letter-spacing:.17em}.fundingIntro h2,.fundingRegister h2,.fundingCTA h2{font-size:clamp(2.8rem,5vw,5.8rem);line-height:.94;letter-spacing:-.055em;max-width:1050px;margin:.8rem 0 1.4rem}.fundingIntro p{max-width:850px;line-height:1.75;color:#506861;font-size:1.08rem}.fundingSupportGrid{max-width:1500px;margin:auto;padding:2rem clamp(1.5rem,7vw,8rem) 8rem;display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#b7c6bd}.fundingSupportGrid article{background:#f5f7f2;padding:2.2rem;min-height:270px}.fundingSupportGrid article>span{font-size:.7rem;color:#6a817a}.fundingSupportGrid h3{margin:4rem 0 .8rem;font-size:1.45rem}.fundingSupportGrid p{line-height:1.65;color:#526a63}.fundingRegister{padding:8rem clamp(1.5rem,7vw,8rem);background:#dfe7dd;display:grid;grid-template-columns:1fr 1fr;gap:6rem}.fundingSteps p{padding:1.5rem 0;border-top:1px solid #073f3b35;line-height:1.65}.fundingCTA{text-align:center;padding:9rem 1.5rem;background:#073f3b;color:#fff}.fundingCTA h2{margin:1rem auto}.fundingCTA p{color:#c8dad3;margin-bottom:2rem}.fundingForm{position:relative;z-index:2;width:min(720px,94vw);max-height:90vh;overflow:auto;background:#f7f8f3;color:#073f3b;padding:clamp(1.5rem,4vw,3.5rem);border-radius:1.4rem}.fundingClose{position:absolute;right:1.2rem;top:1rem;border:0;background:none;font-size:2rem}.fundingForm>span{font-size:.7rem;letter-spacing:.17em}.fundingForm h2{font-size:clamp(2rem,4vw,3.6rem);letter-spacing:-.05em;margin:.5rem 0}.fundingForm form{display:grid;gap:.8rem;margin-top:1.5rem}.fundingForm input,.fundingForm select,.fundingForm textarea{padding:1rem;border:1px solid #b7c7c0;border-radius:.65rem;background:#fff;font:inherit}.fundingConsent{display:flex;gap:.6rem;font-size:.82rem;align-items:flex-start}.fundingConsent input{width:auto}.fundingForm small{font-weight:700}
@media(max-width:900px){.fundingHero .heroTop,.fundingRegister{grid-template-columns:1fr}.fundingOrb{min-height:500px}.fundingSupportGrid{grid-template-columns:1fr 1fr}.fundingRegister{gap:2rem}.fundingClosed{align-items:flex-start;flex-direction:column;gap:.4rem}}@media(max-width:600px){.fundingSupportGrid{grid-template-columns:1fr}.fundingOrb{min-height:430px}.fundingSupportGrid article{min-height:220px}.fundingSupportGrid h3{margin-top:2.5rem}}

/* Restore original Funding hero artwork */
.fundingHeroArtwork:before,.fundingHeroArtwork:after{display:none!important}
.fundingHeroArtwork img{width:min(100%,720px);height:auto;max-height:680px;object-fit:contain;object-position:center;display:block;position:relative;z-index:2}
@media(max-width:900px){.fundingHeroArtwork img{max-height:520px}}

/* Native Resilient Minds Guardian form */
.healNativeGuardian{display:grid;gap:.9rem;padding:clamp(1rem,3vw,2.4rem)}
.guardianFormIntro{display:flex;gap:1rem;align-items:flex-start;margin-bottom:.4rem}
.guardianFormIntro h3{margin:0 0 .35rem;font-size:1.5rem}.guardianFormIntro p{margin:0;line-height:1.55;color:#587069}
.healNativeGuardian input,.healNativeGuardian select,.healNativeGuardian textarea{width:100%;padding:1rem;border:1px solid #b8c9c2;border-radius:.65rem;background:#fff;color:#073f3b;font:inherit}
.healNativeGuardian textarea{min-height:110px;resize:vertical}.guardianConsent{display:flex;gap:.65rem;align-items:flex-start;font-size:.82rem;line-height:1.45}.guardianConsent input{width:auto;margin-top:.15rem}
.guardianSuccess{display:grid;gap:.2rem;padding:1rem;background:#dff2d5;border-radius:.7rem}.guardianSuccess span{font-size:.85rem}.guardianError{font-weight:700}


/* WOMATE DONATE PAGE · PATCH */
.donatePage{background:#f6f5ef;color:#103f3c;min-height:70vh}
.donateHero{min-height:76vh;padding:clamp(120px,14vw,190px) clamp(24px,6vw,96px) 80px;background:#0E4D4A;color:#fff;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:clamp(44px,8vw,120px);align-items:end}
.donateHeroCopy{max-width:850px}.donateHeroCopy>span,.donatePromise>span,.donateStatement>span,.donateModel>div>span,.donateFinal span{font-size:11px;letter-spacing:.18em;font-weight:800}
.donateHero h1{font-size:clamp(48px,7vw,102px);line-height:.94;letter-spacing:-.055em;margin:18px 0 28px;max-width:980px}
.donateHeroCopy>p{font-size:clamp(18px,2vw,24px);line-height:1.55;max-width:760px;color:rgba(255,255,255,.82)}
.donateHeroActions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:34px}.donateTextLink{color:#fff;display:inline-flex;align-items:center;gap:5px;font-weight:750;text-decoration:none}
.donatePromise{border-top:1px solid rgba(255,255,255,.45);padding-top:22px;align-self:end}.donatePromise strong{font-size:clamp(28px,3vw,43px);line-height:1.08;display:block;margin:18px 0}.donatePromise p{color:rgba(255,255,255,.72);line-height:1.65}
.donateStatement{padding:100px clamp(24px,6vw,96px) 58px;display:grid;grid-template-columns:.45fr 1.55fr;gap:40px}.donateStatement h2{font-size:clamp(38px,5vw,72px);line-height:1.02;letter-spacing:-.045em;margin:0;max-width:1050px}
.donateImpactGrid{padding:0 clamp(24px,6vw,96px) 110px;display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid rgba(14,77,74,.18)}
.donateImpactGrid article{display:grid;grid-template-columns:60px 1fr;gap:22px;padding:38px 26px 38px 0;border-bottom:1px solid rgba(14,77,74,.18)}.donateImpactGrid article:nth-child(odd){border-right:1px solid rgba(14,77,74,.18)}.donateImpactGrid article:nth-child(even){padding-left:32px}
.donateImpactGrid b{font-size:12px;letter-spacing:.14em}.donateImpactGrid h3{font-size:clamp(24px,2.4vw,36px);margin:0 0 12px;letter-spacing:-.03em}.donateImpactGrid p{margin:0;line-height:1.7;color:#466b68}
.donateModel{padding:110px clamp(24px,6vw,96px);background:#C6FF52;display:grid;grid-template-columns:.7fr 1.3fr;gap:70px}.donateModel h2{font-size:clamp(40px,5vw,72px);line-height:1;letter-spacing:-.045em;margin:18px 0 0}
.donateModelRail{display:grid;gap:0;border-top:1px solid rgba(14,77,74,.35)}.donateModelRail article{display:grid;grid-template-columns:100px 1fr 1fr;gap:20px;padding:24px 0;border-bottom:1px solid rgba(14,77,74,.35);align-items:start}.donateModelRail strong{font-size:11px;letter-spacing:.12em}.donateModelRail h3{font-size:24px;margin:0}.donateModelRail p{margin:0;color:#315c58;line-height:1.55}
.donateFinal{padding:90px clamp(24px,6vw,96px);background:#072f2d;color:#fff;display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.donateFinal h2{font-size:clamp(48px,6vw,86px);line-height:.98;letter-spacing:-.05em;margin:14px 0 18px}.donateFinal p{color:rgba(255,255,255,.72);font-size:18px;max-width:700px}.donateFinal>div:last-child{display:grid;gap:15px;justify-items:start}.donateFinal small{color:rgba(255,255,255,.62);max-width:420px;line-height:1.5}
@media(max-width:850px){.donateHero,.donateStatement,.donateModel,.donateFinal{grid-template-columns:1fr}.donateHero{padding-top:110px}.donateImpactGrid{grid-template-columns:1fr}.donateImpactGrid article:nth-child(odd){border-right:0}.donateImpactGrid article:nth-child(even){padding-left:0}.donateModelRail article{grid-template-columns:80px 1fr}.donateModelRail p{grid-column:2}.donateStatement{padding-top:72px}.donateImpactGrid{padding-bottom:75px}}


