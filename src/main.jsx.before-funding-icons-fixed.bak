import React,{useState,useEffect,useRef}from'react';
import{createRoot}from'react-dom/client';
import{Helmet,HelmetProvider}from'react-helmet-async';
import{ArrowUpRight,Menu,X,ChevronRight,ChevronDown,ChevronLeft,Leaf,Users,Award,Microscope,Quote,Sparkles,ShieldCheck,Brain,MoveRight,Play,Heart,Radio,Globe2,BookOpen}from'lucide-react';
import'./style.css';
import CanopyApp from'./canopy/CanopyApp.jsx';

const pages={
'/':{k:'WOMATE',title:'Women leading climate action.',accent:'Driving inclusive climate action with technology.',intro:'We equip African women to understand climate systems, lead resilient communities and shape the institutions building our shared future.',type:'home'},
'/she-leads':{k:'SHE LEADS',title:'She Leads Climate Mentorship.',accent:'Climate knowledge. Leadership. Agency.',intro:'A learning and leadership pathway designed for young African women ready to move from climate concern to credible action.',type:'she'},
'/wok-action':{k:'WoK Action',title:'Women’s local knowledge for climate adaptation.',accent:'Knowledge held by women is climate infrastructure.',intro:'We document, protect and activate women’s community knowledge as living evidence for locally grounded adaptation.',type:'wok'},
'/circle':{k:'THE WOMATE CIRCLE',title:'A climate community for women.',accent:'Belong. Build. Lead.',intro:'A professional and community network where women access opportunities, peers, learning, visibility and long-term climate leadership support.',type:'circle'},
'/research':{k:'RESEARCH',title:'We Research. You Lead.',accent:'Evidence built for better climate decisions.',intro:'Gender-responsive climate intelligence, programme design and evidence support for institutions working across Africa.',type:'research'},
'/resilient-minds':{k:'RESILIENT MINDS',title:'To See What Is Hidden.',accent:'Climate resilience must include mental health.',intro:'Support, research and care pathways addressing the emotional and psychological costs of climate disruption.',type:'minds'},
'/honours':{k:'CLIMATE HONOURS',title:'Amplify the Untold.',accent:'Recognising women moving Africa’s climate future forward.',intro:'An annual platform documenting, celebrating and connecting women whose climate leadership deserves to be seen.',type:'honours'},
'/leadership':{k:'LEADERSHIP',title:'Driving Inclusive Climate Action with Technology.',accent:'Women-led. Africa-rooted. Future-facing.',intro:'A multidisciplinary leadership team connecting climate science, technology, research, community practice and storytelling.',type:'leadership'},
'/funding':{k:'FUNDING SUPPORT',title:'2027 Climate Funding Readiness',accent:'Build a stronger case for climate capital.',intro:'Grant-readiness support for African women founders building credible climate initiatives.',type:'funding'},
'/womateer':{k:'WOMATEER',title:'Elevate Your Impact as a WOMATEER',accent:'Volunteer talent. Serious climate impact.',intro:'Contribute professional skill to a women-led climate organisation building knowledge, visibility and resilience across Africa.',type:'volunteer'},
'/merchandise':{k:'THE VAULT',title:'Wear the work.',accent:'WOMATE objects for climate community.',intro:'Limited pieces that carry the identity, conversations and conviction of women leading climate action.',type:'merch'},
'/donate':{k:'DONATE',title:'Back women-led climate leadership.',accent:'Give access. Grow leadership.',intro:'Support research, climate, health and leadership programmes for women across Africa.',type:'donate'}
};

const seo={
'/':{title:'WOMATE | African Women Leading Climate Action',description:"WOMATE is an organization that equips African women with technology, training and community support to move from climate participation to climate leadership."},
'/she-leads':{title:'She Leads Climate Mentorship | WOMATE',description:'She Leads equips young African women with climate knowledge, leadership skills and practical pathways to lead credible climate action.'},
'/wok-action':{title:'WoK Action | Women’s Climate Knowledge | WOMATE',description:"WoK Action documents, protects and activates women's local and indigenous climate knowledge for community resilience and adaptation."},
'/circle':{title:'The WOMATE Circle | Climate Community for Women',description:'Join a professional climate community connecting African women to learning, opportunities, peer networks, visibility and long-term climate leadership.'},
'/research':{title:'Climate Research & Gender Intelligence | WOMATE',description:'WOMATE provides gender-responsive climate research, evidence, programme design, MEL and strategic intelligence for institutions working across Africa.'},
'/resilient-minds':{title:'Resilient Minds | Climate, Wellbeing & Women | WOMATE',description:'Resilient Minds connects climate resilience with mental health, care, restoration and pathways to dignity for vulnerable young women.'},
'/honours':{title:'Climate Honours | African Women Climate Leaders | WOMATE',description:"WOMATE Climate Honours documents, celebrates and connects women whose leadership is shaping Africa's climate future."},
'/leadership':{title:'Leadership & Organisation | WOMATE',description:'Meet the WOMATE leadership team connecting climate action, sustainable technology, research, programmes, advocacy and community practice.'},
'/funding':{title:'2027 Climate Funding Readiness | WOMATE',description:'WOMATE supports African women founders to strengthen climate funding applications, grant readiness, documentation and competitive positioning.'},
'/womateer':{title:'Become a WOMATEER | Volunteer with WOMATE',description:'Contribute your professional skills to WOMATE and help advance women-led climate action, research, technology and community impact across Africa.'},
'/merchandise':{title:'The Vault | WOMATE Merchandise',description:'Explore WOMATE merchandise created for the community of women, allies and leaders advancing climate action across Africa.'},
'/donate':{title:'Donate to WOMATE | Support Women in Climate',description:'Support WOMATE, a nonprofit organisation equipping African women with technology, training, research, community and climate leadership opportunities.'}
};

const WOMATE_OG_IMAGE='https://www.womate.org/og-womate.png';

const organizationSchema={
'@context':'https://schema.org',
'@type':'Organization',
name:'WOMATE',
alternateName:'Women in Climate',
url:'https://www.womate.org/',
logo:'https://www.womate.org/favicon.png',
image:WOMATE_OG_IMAGE,
email:'womatead@gmail.com',
slogan:'Driving inclusive climate action with technology',
description:"WOMATE is an organization that equips African women with technology, training and community support to move from climate participation to climate leadership.",
areaServed:'Africa',
sameAs:[
'https://www.instagram.com/women_in_climate',
'https://web.facebook.com/people/Womate/61593879721366/',
'https://www.linkedin.com/company/womeninclimategh'
]
};

function PageSEO({path}){
const data=seo[path]||seo['/'];
const canonical=`https://www.womate.org${path==='/'?'':path}`;
return <Helmet>
<title>{data.title}</title>
<meta name="description" content={data.description}/>
<link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="WOMATE"/>
<meta property="og:title" content={data.title}/>
<meta property="og:description" content={data.description}/>
<meta property="og:url" content={canonical}/>
<meta property="og:image" content={WOMATE_OG_IMAGE}/>
<meta property="og:image:alt" content="WOMATE — African women leading climate action"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="twitter:title" content={data.title}/>
<meta name="twitter:description" content={data.description}/>
<meta name="twitter:image" content={WOMATE_OG_IMAGE}/>
<script type="application/ld+json">{JSON.stringify(organizationSchema)}</script>
</Helmet>
}

const nav=[['She Leads','/she-leads'],['WoK Action','/wok-action'],['Circle','/circle'],['Research','/research'],['Resilient Minds','/resilient-minds'],['Honours','/honours']];
function Link({to,children,className=''}){return <a className={className} href={to}>{children}</a>}
function Header(){
 const[open,setOpen]=useState(false);
 const close=()=>setOpen(false);
 return <>
  <header className="globalHeader">
   <Link to="/" className="brand" onClick={close}><img src="/assets/img/logo.svg" alt="WOMATE"/></Link>
   <nav className="desktopNav">
    <div className="navGroup"><button className="navTrigger" type="button" aria-haspopup="true">Our work <ChevronDown size={15}/></button><div className="megaMenu workMenu"><div className="megaIntro"><span>WOMATE ECOSYSTEM</span><strong>Women leading climate action.</strong></div><div className="megaLinks"><div><span className="megaLabel">LEARN & LEAD</span><Link to="/she-leads"><b>She Leads</b><small>Climate mentorship & leadership</small></Link><Link to="/circle"><b>The WOMATE Circle</b><small>Community & professional network</small></Link></div><div><span className="megaLabel">KNOWLEDGE & CARE</span><Link to="/wok-action"><b>WoK Action</b><small>Women’s local climate knowledge</small></Link><Link to="/research"><b>Research</b><small>Gender-responsive evidence</small></Link><Link to="/resilient-minds"><b>Resilient Minds</b><small>Climate & mental-health support</small></Link></div></div><Link to="/honours" className="megaFeature"><span>CLIMATE HONOURS</span><strong>Amplify the Untold.</strong><ArrowUpRight size={18}/></Link></div></div>
    <Link to="/honours" className="desktopDirect">Climate Honours</Link>
    <div className="navGroup"><button className="navTrigger" type="button" aria-haspopup="true">Organisation <ChevronDown size={15}/></button><div className="megaMenu orgMenu"><div className="megaIntro"><span>ABOUT WOMATE</span><strong>Africa-rooted. Future-facing.</strong></div><div className="orgLinks"><Link to="/leadership"><b>Our organisation</b><small>Leadership & institutional direction</small></Link><Link to="/funding"><b>Funding support</b><small>Grant application programme</small></Link><Link to="/womateer"><b>WOMATEER</b><small>Volunteer your professional skill</small></Link><Link to="/merchandise"><b>The Vault</b><small>WOMATE merchandise</small></Link></div></div></div>
   </nav>
   <div className="headright"><Link to="/donate" className="headerJoin">Donate <ArrowUpRight size={16}/></Link></div>
   <button className="menu" type="button" aria-label={open?'Close navigation':'Open navigation'} aria-expanded={open} onClick={()=>setOpen(!open)}>{open?<X/>:<Menu/>}</button>
  </header>
  {open&&<nav className="mobileNav mobileNavCategorised" aria-label="Mobile navigation">
   <div className="mobileNavTop"><span>EXPLORE WOMATE</span><button type="button" onClick={close} aria-label="Close navigation"><X size={20}/></button></div>
   <div className="mobileNavGroup"><span className="mobileNavLabel">LEARN & COMMUNITY</span><Link onClick={close} to="/she-leads">She Leads <ChevronRight size={16}/></Link><Link onClick={close} to="/circle">The WOMATE Circle <ChevronRight size={16}/></Link></div>
   <div className="mobileNavGroup"><span className="mobileNavLabel">KNOWLEDGE & CARE</span><Link onClick={close} to="/wok-action">WoK Action <ChevronRight size={16}/></Link><Link onClick={close} to="/research">Research <ChevronRight size={16}/></Link><Link onClick={close} to="/resilient-minds">Resilient Minds <ChevronRight size={16}/></Link><Link onClick={close} to="/honours">Climate Honours <ChevronRight size={16}/></Link></div>
   <div className="mobileNavGroup"><span className="mobileNavLabel">ORGANISATION</span><Link onClick={close} to="/leadership">Our organisation <ChevronRight size={16}/></Link><Link onClick={close} to="/funding">Funding support <ChevronRight size={16}/></Link><Link onClick={close} to="/womateer">WOMATEER <ChevronRight size={16}/></Link><Link onClick={close} to="/merchandise">The Vault <ChevronRight size={16}/></Link></div>
   <Link onClick={close} to="/donate" className="mobileDonate">Donate to WOMATE <ArrowUpRight size={17}/></Link>
  </nav>}
 </>;
}

const heroAssets={
home:'/assets/hero/home-africa-map.png',
she:'/assets/hero/she-leads.png',
wok:'/assets/hero/wok-action.png',
circle:'/assets/hero/circle.png',
research:'/assets/hero/research.png',
minds:'/assets/hero/resilient-minds.png',
honours:'/assets/hero/honours.png',
leadership:'/assets/hero/leadership.png',
funding:'/assets/hero/funding.png',
volunteer:'/assets/hero/womateer.png.svg',
merch:'/assets/img/merch/13.png'
};

const stats=[
{value:40,label:'graduates'},
{value:15,label:'countries'},
{value:18,label:'honourees',suffix:'+'},
{value:1000,label:'lives reached',compact:true,suffix:'+'}
];
function AnimatedStat({value,label,suffix='',compact=false}){const ref=useRef(null);const[count,setCount]=useState(0);const[started,setStarted]=useState(false);useEffect(()=>{const el=ref.current;if(!el)return;const observer=new IntersectionObserver(([entry])=>{if(entry.isIntersecting){setStarted(true);observer.disconnect()}},{threshold:.45});observer.observe(el);return()=>observer.disconnect()},[]);useEffect(()=>{if(!started)return;let frame;const duration=1350;const start=performance.now();const tick=now=>{const progress=Math.min(1,(now-start)/duration);const eased=1-Math.pow(1-progress,3);setCount(Math.round(value*eased));if(progress<1)frame=requestAnimationFrame(tick)};frame=requestAnimationFrame(tick);return()=>cancelAnimationFrame(frame)},[started,value]);let display=compact&&count>=1000?'1k':count.toLocaleString();return <div ref={ref} className="animatedStat"><strong>{display}{suffix}</strong><span>{label}</span></div>}
const programs=[
['She Leads','Climate knowledge and leadership for young African women.','/she-leads',<Users size={22}/>,heroAssets?.she],
['WoK Action','Women’s local knowledge as living climate infrastructure.','/wok-action',<Leaf size={22}/>,heroAssets?.wok],
['The WOMATE Circle','A professional climate community built around women.','/circle',<Globe2 size={22}/>,heroAssets?.circle],
['Research','Gender-responsive climate evidence for better decisions.','/research',<Microscope size={22}/>,heroAssets?.research],
['Resilient Minds','Climate resilience that includes mental health and care.','/resilient-minds',<Brain size={22}/>,heroAssets?.minds],
['Climate Honours','Recognition for women moving Africa’s climate future forward.','/honours',<Award size={22}/>,heroAssets?.honours]
];

const impactReportPages=[
{n:'01',kind:'cover',content:<><span className="reportEst">EST. 2025</span><div className="reportWordmark">WOMATE</div><h2>ANNUAL<br/>IMPACT REPORT</h2><div className="reportRule"/><h3>DRIVING INCLUSIVE CLIMATE ACTION WITH TECHNOLOGY</h3><div className="reportCoverFoot"><span>AFRICA · WOMEN · CLIMATE · TECHNOLOGY</span><span>2025</span></div></>},
{n:'02',kind:'blueprint',content:<><span className="reportKicker">THE BLUEPRINT</span><blockquote>“To build a world where African women lead climate action through innovative, tech-driven solutions.”</blockquote><p>We equip women with the technology, training, and community support required to flip the script on climate leadership.</p><div className="legacyTitle">2025 Legacy</div><div className="legacyGrid"><div><b>40</b><span>She Leads<br/>Graduates</span></div><div><b>15</b><span>African<br/>Countries</span></div><div><b>18+</b><span>Climate<br/>Honors</span></div><div><b>1k+</b><span>Lives<br/>Impacted</span></div></div></>},
{n:'03',kind:'pillars',content:<><span className="reportKicker">HOW WOMATE MOVES</span><div className="reportPillars"><article><b>01.</b><h3>Community</h3><p>Safe digital hubs on LinkedIn & WhatsApp for mentorship and collaboration.</p></article><article><b>02.</b><h3>Storytelling</h3><p>Creative media spotlighting the remarkable work of African women innovators.</p></article><article><b>03.</b><h3>Capacity Building</h3><p>Fellowships and webinars tailored for women navigating climate leadership paths.</p></article><article><b>04.</b><h3>Advocacy</h3><p>Partnering with NGOs and tech hubs to influence gender-responsive policies.</p></article></div></>},
{n:'04',kind:'technology',content:<><span className="reportKicker">TECH INTEGRATION</span><h2>Local climate intelligence.<br/><em>Digital possibility.</em></h2><p>We bridge local climate issues with digital solutions—from precision agriculture projects to inclusive education platforms.</p><blockquote>“Putting the mic, the power, and the future in the hands of women.”</blockquote><div className="whyPanel"><span>THE “WHY”</span><h3>Climate change hits women the hardest, yet they are the least included.</h3><strong>We don't believe in token inclusion. We believe in full leadership.</strong></div></>},
{n:'05',kind:'sdg',content:<><span className="reportKicker">GLOBAL ALIGNMENT</span><h2>Five goals.<br/>One connected future.</h2><p>WOMATE's 2026 ecosystem directly accelerates five critical UN Sustainable Development Goals.</p><div className="sdgGrid"><div><span>âš–ï¸</span><b>SDG 5</b><small>Gender Equality</small></div><div><span>ðŸ’»</span><b>SDG 9</b><small>Industry, Innovation & Tech</small></div><div><span>ðŸŒ</span><b>SDG 13</b><small>Climate Action</small></div><div><span>ðŸ¤</span><b>SDG 17</b><small>Partnerships for the Goals</small></div><div><span>ðŸŽ“</span><b>SDG 4</b><small>Quality Education & Training</small></div></div><div className="reportConnect"><div><span>BRIDGE THE GAP</span><h3>Let's align for the SDGs.</h3><p>We are calling for like-minded partners to lead 2026.</p></div><a href="https://www.linkedin.com/company/womeninclimategh" target="_blank" rel="noreferrer">Connect with us <ArrowUpRight size={17}/></a></div></>}
];
function ImpactReport({open,onClose}){const[page,setPage]=useState(0);useEffect(()=>{if(!open)return;setPage(0);const key=e=>{if(e.key==='Escape')onClose();if(e.key==='ArrowRight')setPage(v=>Math.min(impactReportPages.length-1,v+1));if(e.key==='ArrowLeft')setPage(v=>Math.max(0,v-1))};document.addEventListener('keydown',key);document.body.classList.add('reportOpen');return()=>{document.removeEventListener('keydown',key);document.body.classList.remove('reportOpen')}},[open,onClose]);if(!open)return null;const p=impactReportPages[page];return <div className="reportOverlay" role="dialog" aria-modal="true" aria-label="WOMATE 2025 Annual Impact Report"><button className="reportBackdrop" onClick={onClose} aria-label="Close report"/><div className="reportShell"><div className="reportTopbar"><div><BookOpen size={17}/><span>WOMATE · ANNUAL IMPACT REPORT · 2025</span></div><button onClick={onClose} aria-label="Close report"><X/></button></div><div className={'reportPage report-'+p.kind} key={page}>{p.content}<span className="reportPageNo">{p.n} / 05</span></div><div className="reportControls"><button onClick={()=>setPage(v=>Math.max(0,v-1))} disabled={page===0}><ChevronLeft/> Previous</button><div className="reportDots">{impactReportPages.map((_,i)=><button key={i} className={i===page?'active':''} onClick={()=>setPage(i)} aria-label={'Go to report page '+(i+1)}/>)}</div><button onClick={()=>setPage(v=>Math.min(impactReportPages.length-1,v+1))} disabled={page===impactReportPages.length-1}>Next <ChevronRight/></button></div></div></div>}

function HeroVisual({type}){let src=heroAssets[type]||heroAssets.home;return <div className={'heroVisual hv-'+type}><img className="heroCharacter" src={src} alt=""/>{type==='home'&&<div className="communityOverlay"><div className="communityPulse"><Radio size={14}/><span>WOMATE CIRCLE · LIVE COMMUNITY</span></div><div className="communityRow"><div className="communityAvatars"><img src="/assets/img/team/r.jpg" alt="WOMATE community member"/><img src="/assets/img/team/asaa.jpeg" alt="WOMATE community member"/><img src="/assets/img/testi/19.svg" alt="WOMATE community member"/></div><div><strong>Women connecting across 15 countries</strong><small>WhatsApp mentorship · peer exchange · opportunities</small></div></div></div>}</div>}
function Hero({p,onExplore}){return <section className={'hero hero-'+p.type}><div className="heroTop"><div className="heroCopy"><h1>{p.title}</h1><div className="actions">{onExplore?<button type="button" onClick={onExplore} className="pill lime heroExplore">Explore the work <BookOpen size={16}/></button>:<a href="#content" className="pill lime">Explore the work <ArrowUpRight size={16}/></a>}<Link to="/circle" className="pill ghost">Join the community</Link></div></div><HeroVisual type={p.type}/></div></section>}

const testimonials=[
['The programme deepened my understanding of climate change, resilience and advocacy, and strengthened my commitment to women and youth engagement.','Betty Mulenga','2025 She Leads Alumni · Zambia','/assets/img/testi/19.svg'],
['The mentorship strengthened my confidence and commitment to keep championing women-led climate solutions in my community and beyond.','Mariam Hamza','2025 She Leads Alumni · Ghana','/assets/img/testi/21.svg'],
['I now feel more equipped to engage in community-based climate action and advocate for inclusive, gender-responsive climate policy.','Zainab Kamara','2025 She Leads Alumni · Sierra Leone','/assets/img/testi/22.svg'],
['I am better equipped to be a climate advocate wherever I find myself — not just in title, but in action.','Makaria Dadzie','2025 She Leads Alumni · Ghana','/assets/img/testi/18.svg'],
['The mentorship, sisterhood and shared purpose reminded me that small actions can create lasting impact.','Ethel Eyram Ahorlu','2025 She Leads Alumni · Ghana','/assets/img/testi/20.svg'],
['The programme is valuable for both climate beginners and experienced advocates, especially women learning to use their voices for action.','Mary Kimani','2025 She Leads Alumni · Kenya','/assets/img/testi/17.svg']
];
function Voices(){const cards=[...testimonials,...testimonials];return <section className="voices voicesLive"><div className="voicesHead"><div><span className="voicesKicker">WORDS OF TRANSFORMATION</span><h3>Leadership sounds different when women are given room to own it.</h3></div><div className="voicesMeta"><strong>06</strong><span>voices from the<br/>WOMATE network</span></div></div><div className="voiceViewport"><div className="voiceTrack">{cards.map(([q,n,r,img],i)=><article className="voiceCard" key={i}><div className="voiceCardTop"><img src={img} alt={n+' — WOMATE She Leads alumna'} loading="lazy"/><Quote size={24}/></div><p>{q}</p><div className="voicePerson"><strong>{n}</strong><span>{r}</span></div></article>)}</div></div><div className="voiceHint"><span/> Hover to pause · alumni voices across Africa</div></section>}

function Home(){const[reportOpen,setReportOpen]=useState(false);return <><Hero p={pages['/']} onExplore={()=>setReportOpen(true)}/><main id="content">
<section className="statbar">{stats.map(s=><AnimatedStat key={s.label} {...s}/>)}</section>
<section className="manifesto"><div className="manifestoMark">W</div><div><h3>We don't believe in token inclusion. We believe in full leadership.</h3></div><div><p className="lead">WOMATE is an organization that equips African women with technology, training and community support to move from climate participation to climate leadership.</p><div className="pulseLine"><span/>Community · Storytelling · Capacity building · Advocacy</div></div></section>
<section className="programGrid">{programs.map((p,i)=><Link to={p[2]} className={'program p'+i} key={p[0]}><img className="programArt" src={p[4]} alt="" aria-hidden="true" loading="lazy"/><div className="programShade"/><div className="programTop"><div className="ico">{p[3]}</div><span>0{i+1}</span></div><div className="programCopy"><h4>{p[0]}</h4><p>{p[1]}</p><ArrowUpRight className="go"/></div></Link>)}</section>
<section className="impactScene"><div className="impactPhoto"><img src="/assets/img/wok-field-collage.png" alt="Women participating in WOMATE climate field work" loading="lazy"/><button className="play"><Play fill="currentColor" size={16}/> Field story</button><div className="impactBadge"><Leaf/><span><b>WoK Action</b>Living climate knowledge</span></div></div><div className="impactCopy"><h3>What women know about land, water and survival should not disappear between generations.</h3><p>WoK Action creates a living archive of women’s climate knowledge while supporting communities to translate that intelligence into resilience, enterprise and local adaptation.</p><Link to="/wok-action" className="textlink">Enter WoK Action <MoveRight/></Link></div></section>
<section className="facesRail"><div className="railIntro"><h3>Not beneficiaries.<br/>Climate actors.</h3><p>WOMATE is built around women as researchers, founders, community leaders, storytellers and decision-makers.</p></div><div className="faceCard f1"><img src="/assets/home/climate-leader.png" alt="African woman climate leader" loading="lazy"/><span>LEAD</span></div><div className="faceCard f2"><img src="/assets/home/climate-builder.png" alt="African woman climate builder" loading="lazy"/><span>BUILD</span></div><div className="faceCard f3"><img src="/assets/home/climate-influence.png" alt="African woman climate advocate" loading="lazy"/><span>INFLUENCE</span></div><div className="characterCard"><img src="/assets/home/climate-researcher.png" alt="African woman climate researcher" loading="lazy"/><span>RESEARCH</span></div></section>
<Voices/>
<Honours/></main><ImpactReport open={reportOpen} onClose={()=>setReportOpen(false)}/></>}
function Honours(){return <section className="honours"><div className="honourCopy"><h3>Amplify the Untold.</h3><p>Nominate a woman whose climate leadership is changing a community, field or institution.</p><Link to="/honours" className="pill lime">Nominate a leader <ArrowUpRight/></Link><div className="honourCount">18+ <span>women already documented</span></div></div><div className="honourSymbol"><img src="/assets/hero/honour-symbol.png" alt="WOMATE Climate Honours symbol"/></div></section>}
const FORM_ENDPOINT='https://formspree.io/f/mykkzrdp';

async function submitWomateForm(event,source,setStatus){
event.preventDefault();
const form=event.currentTarget;
setStatus('sending');
const data=new FormData(form);
data.set('source',source);
try{
const response=await fetch(FORM_ENDPOINT,{method:'POST',body:data,headers:{Accept:'application/json'}});
if(!response.ok)throw new Error('Submission failed');
form.reset();
setStatus('success');
}catch(error){
setStatus('error');
}
}

const details={
she:{items:['Climate foundations','Gender and climate justice','Governance and policy','Advocacy and storytelling','Leadership and community engagement','Climate careers'],title:'Six pillars. One leadership trajectory.',aside:'2026 cohort registration'},
wok:{items:['Indigenous sovereignty','Impact visibility','Economic empowerment','Collective inquiry','Community wealth','Living archives'],title:'Community knowledge, protected and put to work.',aside:'Community-project funding'},
circle:{items:['Membership activation','Member pathways','Community access','Climate Honours access','Peer opportunities','Professional visibility'],title:'A network designed to compound women’s climate agency.',aside:'Registration & payment'},
research:{items:['Climate & gender intelligence','MEL and impact analysis','Evidence support','Community co-creation','Programme design','Knowledge management','Wellbeing & protection','Institutional capacity'],title:'Research made useful, legible and actionable.',aside:'Commission research'},
minds:{items:['Rescue','Restore','Resilience','Peer support pathways','Climate wellbeing research','Guardianship contribution'],title:'The human nervous system belongs in climate strategy.',aside:'Support the programme'},
honours:{items:['The Spotlight','The Circle','The Honour','2025 archive — 18 women','2026 nominations','Journey to October 2026'],title:'Recognition that creates memory, credibility and connection.',aside:'Submit a nomination'},
funding:{items:['Professional application review','Application streamlining','Grant-writing webinar','Technical capacity building','WOMATE community access','Competitive positioning'],title:'From strong idea to stronger application.',aside:'2027 interest register'},
