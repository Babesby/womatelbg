  letter-spacing:-.015em!important;
  color:#0e4d4a!important;
}
.womateerRoles.iconPillarSection .iconPillarHint{
  display:block!important;
  margin:16px auto 0!important;
  padding:0!important;
  text-align:center!important;
  font-size:9px!important;
  line-height:1.2!important;
  font-weight:600!important;
  letter-spacing:.13em!important;
  text-transform:uppercase!important;
  color:#78918f!important;
}
@media(max-width:760px){
 .womateerRoles.iconPillarSection .iconPillarHead{text-align:left!important;margin-bottom:24px!important}
 .womateerRoles.iconPillarSection .iconPillarHead h2{margin-left:0!important;font-size:clamp(30px,8vw,42px)!important;max-width:18ch!important}
 .womateerRoles.iconPillarSection .iconPillarTray{padding:11px!important;border-radius:25px!important}
 .womateerRoles.iconPillarSection .iconPillarGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
 .womateerRoles.iconPillarSection .iconPillarCard{min-height:116px!important;border-radius:18px!important;padding:15px 8px 12px!important}
 .womateerRoles.iconPillarSection .iconPillarGlyph{width:56px!important;height:56px!important;flex-basis:56px!important;border-radius:17px!important}
}

/* WOMATEER open pathways — icon-first, detail on intent */
.womateerPathwayTray{max-width:920px}
.womateerPathwayGrid{grid-template-columns:repeat(4,minmax(0,1fr))}
.womateerPathwayCard{min-height:150px}
.womateerPathwayDialog .womateerPathwayApply{position:static;width:auto;height:auto;margin-top:28px;padding:12px 18px;border-radius:999px;border:0;background:#c6ff52;color:#083f3e;display:inline-flex;font-weight:800}
@media(max-width:760px){.womateerPathwayGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.womateerPathwayCard{min-height:116px}}

.shePillars{padding:clamp(54px,6vw,82px) clamp(18px,5vw,72px) clamp(60px,7vw,92px);background:linear-gradient(180deg,#f5f8f6 0%,#fff 100%)}
.shePillars header{display:block!important;width:100%!important;max-width:1100px!important;margin:0 auto clamp(28px,4vw,44px)!important;padding:0!important;text-align:center!important;grid-template-columns:none!important;grid-template-rows:none!important}
.shePillars header>span{display:block!important;margin:0 0 10px!important;padding:0!important;font-family:inherit!important;font-size:10px!important;line-height:1.2!important;font-weight:800!important;letter-spacing:.17em!important;text-transform:uppercase!important;color:#6c8b89!important}
.shePillars header h2{display:block!important;margin:0 auto!important;padding:0!important;font-family:inherit!important;font-size:clamp(40px,5.1vw,70px)!important;line-height:.98!important;letter-spacing:-.048em!important;font-weight:700!important;color:#0e4d4a!important;text-wrap:balance!important;max-width:15ch!important}
.shePillarTray{max-width:1240px;margin:0 auto;padding:clamp(18px,2vw,26px);border:1px solid rgba(14,77,74,.08);border-radius:34px;background:rgba(255,255,255,.78);box-shadow:0 20px 60px rgba(6,58,55,.065);backdrop-filter:blur(12px)}
.shePillarGrid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.shePillarCard{position:relative;min-width:0;min-height:150px;padding:18px 10px 16px;border:0;border-radius:24px;background:transparent;color:#0e4d4a;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;text-align:center;box-shadow:none;overflow:visible}
.shePillarCard:hover,.shePillarCard:focus-visible{transform:translateY(-3px);background:rgba(14,77,74,.035);box-shadow:none}
.shePillarNo{position:absolute;top:12px;left:14px;font-size:9px;font-weight:850;letter-spacing:.15em;color:#77918f}
.shePillarIcon{width:70px;height:70px;border-radius:22px;display:grid;place-items:center;background:#edf5f1;color:#0e4d4a;box-shadow:0 10px 28px rgba(6,58,55,.07);transition:transform .22s var(--ease-womate),background .22s var(--ease-womate),box-shadow .22s var(--ease-womate)}
.shePillarCard:nth-child(2) .shePillarIcon{background:#f1edf8}.shePillarCard:nth-child(3) .shePillarIcon{background:#eaf4ec}.shePillarCard:nth-child(4) .shePillarIcon{background:#f7efe4}.shePillarCard:nth-child(5) .shePillarIcon{background:#e8f2f2}.shePillarCard:nth-child(6) .shePillarIcon{background:#eff6df}
.shePillarCard:hover .shePillarIcon,.shePillarCard:focus-visible .shePillarIcon{transform:scale(1.06);background:#c6ff52;box-shadow:0 14px 32px rgba(6,58,55,.12)}
.shePillarCard h3{margin:0;font-size:14px;line-height:1.08;letter-spacing:-.02em;font-weight:700;max-width:13ch}
.shePillarHint{display:block;margin:18px auto 0;text-align:center;font-size:10px;letter-spacing:.13em;text-transform:uppercase;color:#78918f}
.shePillarModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:18px}
.shePillarBackdrop{position:absolute;inset:0;border:0;background:rgba(2,30,29,.78);backdrop-filter:blur(12px)}
.shePillarDialog{position:relative;z-index:1;width:min(680px,94vw);padding:clamp(32px,5vw,58px);border-radius:32px;background:#083f3e;color:#fff;box-shadow:0 36px 100px rgba(0,0,0,.4);animation:shePop .22s cubic-bezier(.2,.75,.25,1);border:1px solid rgba(198,255,82,.18)}
.shePillarDialog:before{content:'';position:absolute;left:0;top:36px;width:5px;height:68px;border-radius:0 5px 5px 0;background:#c6ff52}
.shePillarDialog>button{position:absolute;top:16px;right:16px;width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.07);color:#fff;display:grid;place-items:center;cursor:pointer}
.shePillarDialogIcon{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:#c6ff52;color:#083f3e;margin-bottom:22px}
.shePillarDialog span{font-size:11px;font-weight:850;letter-spacing:.16em;color:#c6ff52}
.shePillarDialog h3{margin:14px 46px 18px 0;font-size:clamp(34px,6vw,58px);line-height:.96;letter-spacing:-.045em;max-width:13ch}
.shePillarDialog p{margin:0;max-width:50ch;font-size:clamp(15px,1.6vw,18px);line-height:1.7;color:rgba(255,255,255,.82)}
@media(max-width:1050px){.shePillarGrid{grid-template-columns:repeat(3,minmax(0,1fr))}.shePillarCard{min-height:140px}}
@media(max-width:680px){.shePillars{padding:46px 15px 56px}.shePillars header{margin-bottom:24px!important;text-align:left!important}.shePillars header h2{font-size:clamp(36px,10.5vw,52px)!important;max-width:12ch!important;margin-left:0!important}.shePillarTray{padding:12px;border-radius:26px}.shePillarGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}.shePillarCard{min-height:126px;border-radius:20px;padding:17px 8px 13px}.shePillarIcon{width:58px;height:58px;border-radius:18px}.shePillarCard h3{font-size:13px}.shePillarHint{font-size:9px;margin-top:13px}.shePillarDialog{padding:30px 23px 28px;border-radius:25px}.shePillarDialog h3{font-size:clamp(32px,10vw,46px)}}
@keyframes shePop{from{opacity:0;transform:scale(.94) translateY(8px)}to{opacity:1;transform:scale(1) translateY(0)}}
@media(max-width:900px){.shePillars header h2{font-size:clamp(30px,5vw,42px)!important}.shePillarGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.shePillarCard{min-height:112px}}
@media(max-width:580px){.shePillars{padding:38px 15px 48px}.shePillars header{margin-bottom:18px!important}.shePillars header>span{font-size:9px!important;margin-bottom:7px!important}.shePillars header h2{font-size:clamp(28px,8.5vw,36px)!important;line-height:1.04!important;letter-spacing:-.03em!important}.shePillarGrid{grid-template-columns:1fr;gap:9px}.shePillarCard{min-height:92px;padding:14px 15px 13px;border-radius:16px;grid-template-columns:auto 1fr auto;column-gap:12px;row-gap:7px}.shePillarCard h3{font-size:18px;line-height:1.05;max-width:none}.shePillarOpen{width:30px;height:30px}.shePillarDialog{padding:32px 24px 30px;border-radius:24px}.shePillarDialog h3{font-size:clamp(32px,10vw,46px)}}
`}</style>
<section id="she-pillars" className="shePillars"><header><h2>Six Core Learning Pillars</h2></header><div className="shePillarTray"><div className="shePillarGrid">{shePillars.map(([n,t,d],i)=>{const Icon=shePillarIcons[i];return <button type="button" className="shePillarCard" key={n} onClick={()=>setSelectedPillar({n,t,d,i})} aria-label={`${t}. Open full description`}><span className="shePillarNo">{n}</span><span className="shePillarIcon" aria-hidden="true"><Icon size={27} strokeWidth={1.8}/></span><h3>{shePillarLabels[i]}</h3></button>})}</div><span className="shePillarHint">Select a pillar to explore</span></div></section>
<section className="shePrestige"><div className="prestigeCopy"><h2>The Prestige Awaits You.</h2><div className="prestigeProof"><ShieldCheck size={18}/> Credential · leadership evidence · professional signal</div></div><div className="prestigeCert"><img src="/assets/img/she-leads-certificate-reveal.png" alt="She Leads 2026 Certificate of Participation"/></div></section>
<section className="sheFellows"><div><h2>The cohort becomes a network.</h2><p>Women leave with climate knowledge, shared language for leadership, peers across African countries and a community that continues beyond the programme.</p><button className="pill darkbtn" onClick={()=>setFormOpen(true)}>Join next cohort <ArrowUpRight size={16}/></button></div><figure><SheTestimonialSlider/></figure></section>
</main>
{selectedPillar&&(()=>{const PillarIcon=shePillarIcons[selectedPillar.i];return <div className="shePillarModal" role="dialog" aria-modal="true" aria-labelledby="she-pillar-title"><button className="shePillarBackdrop" aria-label="Close pillar description" onClick={()=>setSelectedPillar(null)}/><article className="shePillarDialog"><button type="button" aria-label="Close" onClick={()=>setSelectedPillar(null)}><X size={20}/></button><div className="shePillarDialogIcon" aria-hidden="true"><PillarIcon size={28} strokeWidth={1.8}/></div><span>{selectedPillar.n} · SHE LEADS LEARNING PILLAR</span><h3 id="she-pillar-title">{selectedPillar.t}</h3><p>{selectedPillar.d}</p></article></div>})()}
{formOpen&&<div className="formModal" role="dialog" aria-modal="true" aria-label="Join the next She Leads cohort"><button className="formBackdrop" aria-label="Close form" onClick={()=>setFormOpen(false)}/><div className="formPanel"><div className="formPanelHead"><div><span>SHE LEADS · NEXT COHORT</span><strong>Join the next cohort</strong></div><button onClick={()=>setFormOpen(false)} aria-label="Close"><X size={22}/></button></div><iframe src={SHE_FORM} title="She Leads cohort interest form" loading="lazy">Loading…</iframe></div></div>}
</>}


const wokPillars=[
['01','DOCUMENTATION','Indigenous Sovereignty','Preserving women’s local and indigenous knowledge systems, traditions, and climate adaptation practices before they are lost.'],
['02','ANALYSIS','Impact Visibility','Examining how climate change reshapes women’s livelihoods, health, and everyday wellbeing across communities.'],
['03','RESILIENCE','Economic Alchemy','Identifying practical skills, trades, and income pathways that strengthen women’s economic and climate resilience.'],
['04','PARTICIPATION','Collective Inquiry','Using participatory research, focus groups, and interviews so women co-lead knowledge creation and decision-making.'],
['05','MOBILIZATION','Community Wealth','Mobilising resources collaboratively to support women-led solutions, skills training, and local adaptation initiatives.'],
['06','STORYTELLING','Living Archives','Documenting insights through storytelling, reports, and shared learning to elevate women’s voices in climate discourse.']
];
const wokPillarIcons=[BookOpen,Microscope,ShieldCheck,Users,Sparkles,Quote];
const wokPillarLabels=['Sovereignty','Visibility','Resilience','Inquiry','Community','Archives'];
function WokAction(){const[selectedWokPillar,setSelectedWokPillar]=useState(null);const goPillars=()=>document.getElementById('wok-pillars')?.scrollIntoView({behavior:'smooth',block:'start'});return <>
<section className="hero hero-wok wokHeroClassic"><div className="heroTop"><div className="heroCopy"><h1>WoK Action</h1><div className="actions"><Link className="pill lime" to="/donate">Support WOMATE <ArrowUpRight size={16}/></Link><button className="pill ghost" onClick={goPillars}>Explore Research</button></div></div><HeroVisual type="wok"/></div></section>
<main className="wokPage">
<section className="wokTheme"><div className="wokThemeMeta"><span>2025 ACTIVE THEME</span><strong>WOMATE · COMMUNITY RESEARCH</strong></div><div><h2>“Rising Together: How Women’s Local Wisdom and Everyday Leadership Shape Adaptation.”</h2><p>Bridging the gap between lived experience and practical solutions through a documented storytelling approach.</p></div></section>
<section id="wok-pillars" className="wokPillars iconPillarSection"><div className="wokSectionHead iconPillarHead"><span>THE ACTION PILLARS</span><h2>Knowledge becomes infrastructure when communities can use it.</h2></div><div className="iconPillarTray"><div className="iconPillarGrid six">{wokPillars.map(([n,k,t,d],i)=>{const Icon=wokPillarIcons[i];return <button type="button" className="iconPillarCard" key={n} onClick={()=>setSelectedWokPillar({n,k,t,d,i})} aria-label={`${t}. Open full description`}><span className="iconPillarNo">{n}</span><span className="iconPillarGlyph"><Icon size={27} strokeWidth={1.8}/></span><strong>{wokPillarLabels[i]}</strong></button>})}</div><span className="iconPillarHint">Select a pillar to explore</span></div></section>
<section className="wokEvidence"><div className="wokEvidenceLead"><span>FIELD DOCUMENTATION</span><h2>Research with women. Not research about women.</h2><p>WoK Action treats communities as knowledge holders and co-creators. Interviews, focus groups, observation and storytelling are used to document adaptation practices while keeping women visible in the evidence.</p></div><figure className="wokCollage"><img src="/assets/img/wok/19.svg" alt="WoK Action community field documentation"/><figcaption>Community documentation · Okere District</figcaption></figure><div className="wokEvidenceTiles"><figure><img src="/assets/img/wok/17.svg"/><span>LOCAL KNOWLEDGE</span></figure><figure><img src="/assets/img/wok/20.svg"/><span>PARTICIPATORY RESEARCH</span></figure></div></section>
<section className="wokProof"><div><b>2025</b><span>Launch year</span></div><div><b>Okere</b><span>Active district</span></div><div><b>100%</b><span>Community led</span></div><blockquote>“To care about climate change, you only need to be one thing — a person living on planet Earth who wants a better future.”<cite>Katharine Hayhoe · Climate scientist & author</cite></blockquote></section>

{selectedWokPillar&&(()=>{const Icon=wokPillarIcons[selectedWokPillar.i];return <div className="iconPillarModal" role="dialog" aria-modal="true" aria-labelledby="wok-pillar-title"><button className="iconPillarBackdrop" aria-label="Close" onClick={()=>setSelectedWokPillar(null)}/><article className="iconPillarDialog"><button type="button" aria-label="Close" onClick={()=>setSelectedWokPillar(null)}><X size={20}/></button><div className="iconPillarDialogIcon"><Icon size={28} strokeWidth={1.8}/></div><span>{selectedWokPillar.n} · {selectedWokPillar.k}</span><h3 id="wok-pillar-title">{selectedWokPillar.t}</h3><p>{selectedWokPillar.d}</p></article></div>})()}
</main></>}



const CIRCLE_WHATSAPP=import.meta.env.VITE_CIRCLE_WHATSAPP_URL||'';
function CirclePage(){
 const openWhatsApp=()=>{if(CIRCLE_WHATSAPP)window.open(CIRCLE_WHATSAPP,'_blank','noopener,noreferrer');else alert('Add VITE_CIRCLE_WHATSAPP_URL to your .env to activate the WOMATE Circle WhatsApp route.');};
 return <>
<section className="hero hero-circle"><div className="heroTop"><div className="heroCopy"><h1>A climate community for women.</h1><div className="actions"><button className="pill lime" onClick={openWhatsApp}>Join the Circle <ArrowUpRight size={16}/></button></div></div><HeroVisual type="circle"/></div></section>
<main className="circlePage">
<section className="circleIntro circleIntroWithWhatsApp"><span>THE INNER RING OF CLIMATE LEADERSHIP</span><div className="circleIntroCopy"><h2>Influence grows faster when women do not have to build alone.</h2><p>The WOMATE Circle is a specialised ecosystem for women architects of sustainability: a place to exchange intelligence, access opportunity, build professional visibility and turn peer connection into collective power.</p></div><CircleWhatsAppWidget/></section>
<section className="circlePromise"><div className="circleSectionHead"><span>FOSTERING VISIBILITY</span><h2>More than a network. A growth accelerator.</h2></div><div className="circlePromiseGrid"><article><b>01 · SHARED LEARNING</b><h3>Stay current together.</h3><p>Capacity-building exchanges, resource sharing and peer intelligence for women navigating climate and sustainability work.</p></article><article><b>02 · DIRECT ACCESS</b><h3>See opportunity sooner.</h3><p>Curated fellowships, grants, projects and speaking opportunities selected for women building credible climate careers.</p></article><article><b>03 · COMMUNITY</b><h3>Build with others.</h3><p>Connect with women working across climate, research, technology, advocacy, health and community leadership.</p></article></div></section>
<section className="circlePath"><div className="circlePathCopy"><h2>The WOMATE Circle is free to join.</h2><p>Enter the community, introduce yourself and connect to learning, opportunities and peers.</p></div><div className="circleSteps"><div><b>01</b><strong>Join the community</strong><p>Use the direct WhatsApp route to enter the WOMATE Circle.</p></div><div><b>02</b><strong>Introduce yourself</strong><p>Share who you are, where you are based and the climate space you are building in.</p></div><div><b>03</b><strong>Participate</strong><p>Access learning, resources, opportunities and peer exchange.</p></div></div></section>

</main>
</>}

const researchServices=[
['01','RESEARCH & POLICY','Climate & Gender Intel','Gender-responsive research informing policy and community action. Vulnerability assessments, resilience studies, and indigenous knowledge documentation.',['Vulnerability Mapping','Policy Briefs','Stakeholder Consultation']],
['02','MEASUREMENT','MEL & Impact Analysis','Measuring results and strengthening accountability through comprehensive Monitoring, Evaluation, and Learning frameworks.',['Impact Frameworks','SDG Integration','Adaptive Management']],
['03','DATA SCIENCE','Evidence Support','Translating complex quantitative and qualitative data into actionable dashboards and visualizations for strategic planning.',['Data Dashboards','Economic Analysis','Synthesis Reports']],
['04','PARTICIPATORY','Community Co-Creation','Participatory approaches that centre women and youth as co-creators of climate solutions and ownership.',['Needs Assessment','Youth Mapping','Participatory Action']],
['05','OPERATIONS','Programme Design','Support across the full project cycle: Theory of Change, implementation, grant management, donor reporting, and risk management.',['Theory of Change','Implementation','Grant Management']],
['06','ADVOCACY','Knowledge Management','Amplifying women’s voices through strategic communications and digital platforms that strengthen visibility and influence.',['Advocacy Campaigns','Learning Products','Multimedia Content']],
['07','SPECIALIZED','Wellbeing & Protection','Research at the intersection of climate impacts, psychosocial mental health, and gender-based social protection.',['Psychosocial Design','Outreach Support','Stigma Reduction']],
['08','TRAINING','Institutional Capacity','Bespoke workshops and mentorship design for organisations strengthening climate and gender leadership.',['Curriculum Design','Leadership Mentorship','Digital Literacy']]
];

const researchServiceIcons=[Microscope,Award,Globe2,Users,BookOpen,Quote,Heart,Sparkles];
const researchServiceLabels=['Research','Measurement','Evidence','Co-Creation','Design','Knowledge','Wellbeing','Capacity'];function ResearchPage(){const[status,setStatus]=useState('idle');const[selectedResearchService,setSelectedResearchService]=useState(null);const goInquiry=()=>document.getElementById('research-inquiry')?.scrollIntoView({behavior:'smooth',block:'start'});return <>
<section className="hero hero-research"><div className="heroTop"><div className="heroCopy"><h1>We Research. You Lead.</h1><div className="actions"><button className="pill lime" onClick={goInquiry}>Inquire <ArrowUpRight size={16}/></button></div></div><HeroVisual type="research"/></div></section>
<main className="researchPage">
<section className="researchIntro"><div className="researchIntroLabel">STRATEGIC INSIGHT & RESEARCH</div><div><h2>Evidence that can survive the boardroom and still make sense on the ground.</h2><p>WOMATE provides organisations and donors with the analytical depth to design, implement and assess gender-responsive climate initiatives across African contexts.</p></div></section>
<section className="researchServices iconPillarSection"><div className="researchSectionHead iconPillarHead"><span>WHAT WE DO</span><h2>From climate intelligence to institutional capacity.</h2></div><div className="iconPillarTray"><div className="iconPillarGrid eight">{researchServices.map(([n,k,t,d,tags],i)=>{const Icon=researchServiceIcons[i];return <button type="button" className="iconPillarCard" key={n} onClick={()=>setSelectedResearchService({n,k,t,d,tags,i})} aria-label={`${t}. Open full description`}><span className="iconPillarNo">{n}</span><span className="iconPillarGlyph"><Icon size={27} strokeWidth={1.8}/></span><strong>{researchServiceLabels[i]}</strong></button>})}</div><span className="iconPillarHint">Select a service to explore</span></div></section>
<section className="researchBridge"><div><span>HOW WOMATE WORKS</span><h2>Lived experience in. Decision-grade evidence out.</h2></div><div className="researchBridgeSteps"><div><b>01</b><strong>Listen</strong><p>Start with communities, context and the questions decision-makers actually need answered.</p></div><div><b>02</b><strong>Analyse</strong><p>Combine qualitative insight, quantitative evidence and gender-responsive interpretation.</p></div><div><b>03</b><strong>Translate</strong><p>Turn findings into useful briefs, frameworks, dashboards, learning products and programme decisions.</p></div></div></section>
<section className="researchVisual"><figure><img src="/assets/hero/research.png" alt="WOMATE climate researcher"/></figure><div><span>RESEARCH THAT MOVES</span><h2>Not research for the shelf.</h2><p>Our work is designed to strengthen programmes, shape policy conversations, improve accountability and make women’s lived climate realities harder to ignore.</p><div className="researchSignals"><span>Gender-responsive</span><span>Participatory</span><span>Evidence-led</span><span>Actionable</span></div></div></section>
<section id="research-inquiry" className="researchInquiry"><div className="researchInquiryCopy"><span>BRIDGE THE GAP</span><h2>Integrate lived experience with policy relevance.</h2><p>Tell us what you are designing, evaluating, researching or trying to understand. WOMATE will review the brief and follow up on the right research or strategic consultation pathway.</p></div><form onSubmit={e=>submitWomateForm(e,'Research inquiry',setStatus)}><input type="hidden" name="source" value="Research inquiry"/><label>Full name<input required name="name" placeholder="Name Surname"/></label><label>Professional email<input required name="email" type="email" placeholder="email@domain.com"/></label><label>Organisation<input name="organisation" placeholder="Organisation / institution"/></label><label>How can we collaborate?<textarea required name="message" placeholder="Tell us about the research, programme, evaluation or evidence need."/></label><label className="researchBriefLink"><span>Research or collaboration brief <b>*</b></span><input required type="url" name="research_brief_link" inputMode="url" pattern="https://.*" placeholder="https://drive.google.com/..." aria-describedby="research-brief-help"/><small id="research-brief-help">Paste a viewable Google Drive, OneDrive or Dropbox link. Please make sure anyone with the link can view it.</small></label><button className="pill lime" disabled={status==='sending'}>{status==='sending'?'Sending…':'Send inquiry'} {status!=='sending'&&<ArrowUpRight size={16}/>}</button>{status==='success'&&<p role="status">Thank you. Your research inquiry has been sent to the WOMATE team.</p>}{status==='error'&&<p role="alert">We could not send your inquiry. Please try again or email womatead@gmail.com.</p>}</form></section>
{selectedResearchService&&(()=>{const Icon=researchServiceIcons[selectedResearchService.i];return <div className="iconPillarModal" role="dialog" aria-modal="true" aria-labelledby="research-service-title"><button className="iconPillarBackdrop" aria-label="Close" onClick={()=>setSelectedResearchService(null)}/><article className="iconPillarDialog"><button type="button" aria-label="Close" onClick={()=>setSelectedResearchService(null)}><X size={20}/></button><div className="iconPillarDialogIcon"><Icon size={28} strokeWidth={1.8}/></div><span>{selectedResearchService.n} · {selectedResearchService.k}</span><h3 id="research-service-title">{selectedResearchService.t}</h3><p>{selectedResearchService.d}</p><div className="iconPillarDialogTags">{selectedResearchService.tags.map(x=><em key={x}>{x}</em>)}</div></article></div>})()}
</main></>}


function ResilientMinds(){
 const goDonate=()=>{window.location.href='/donate'};
 return <>
  <section className="hero hero-minds"><div className="heroTop"><div className="heroCopy"><h1>To See What Is Hidden.</h1></div><HeroVisual type="minds"/></div></section>
  <main className="healPage">
   <section className="healIntro"><span>RESILIENT MINDS · RESILIENT WOMEN</span><div><h2>Climate justice must make room for the mind.</h2><p>Climate shocks, displacement, poverty and social exclusion can compound mental-health distress for women already living in vulnerable conditions. Resilient Minds is WOMATE’s restoration initiative for young women who need more than awareness: medical care, safety, psychosocial support, skills and a credible route back to dignity.</p></div></section>
   <section className="healPath"><div className="healSectionHead"><span>THE RESTORATION PATH</span><h2>Rescue. Restore. Resilience.</h2></div><div className="healPathGrid"><article><b>01</b><div className="healIcon"><Heart size={26}/></div><h3>Rescue</h3><p>Identifying and compassionately moving young women from isolation and street vulnerability into a safer environment for immediate support.</p></article><article><b>02</b><div className="healIcon"><Brain size={26}/></div><h3>Restore</h3><p>Professional psychiatric assessment, clinical care, psychosocial support, nutrition and structured recovery that rebuild the foundations of self.</p></article><article><b>03</b><div className="healIcon"><Leaf size={26}/></div><h3>Resilience</h3><p>Vocational pathways—from tailoring to catering and other practical arts—supporting independence, agency and a future beyond survival.</p></article></div></section>
   <section className="healWhy"><div className="healWhyVisual"><img src="/assets/hero/resilient-minds.png" alt="Resilient Minds — women, care and climate resilience"/></div><div className="healWhyCopy"><span>THE OVERLOOKED INTERSECTION</span><h2>Environmental crisis can become a mental-health crisis.</h2><p>When homes, incomes, food systems and community ties are disrupted, the psychological cost can be profound. WOMATE treats care as part of resilience—not as an afterthought.</p><div className="healSignals"><span>Medical care</span><span>Safe accommodation</span><span>Psychosocial support</span><span>Vocational skills</span></div></div></section>
   <section className="healGuardianStory"><div><span>CARE THAT LASTS</span><h2>Support that stays long enough to matter.</h2></div><div><p>WOMATE is building continuity across rescue, clinical restoration, safe living and skills-building so support does not end at the first intervention, we are inviting hospitals, clinicians, safe-house partners, vocational trainers, donors and organisations to support.</p><button className="pill lime" onClick={goDonate}>Donate to WOMATE <ArrowUpRight size={16}/></button></div></section>
  </main>
 </>;
}

const HONOURS_FORM=import.meta.env.VITE_HONOURS_NOMINATION_FORM_URL||'https://form.jotform.com/260154019157048';
const honoursArchiveByYear={
  2025:[
    {image:'c1.png',name:'Judith Singibala',location:'Tanzania',profile:'Social activist and founder of TUPO Foundation, advancing inclusive development for women, youth and children with disabilities while leading community-based climate justice, tree-planting and land-rights advocacy.',linkedin:'https://www.linkedin.com/in/judithsingibala/'},
    {image:'c2.png',name:'Nouran Aly Farouk',location:'Egypt',profile:'Physician, social entrepreneur and co-founder of Dosy, Egypt’s first tech-based platform empowering women to ride scooters and bicycles. Her work connects sustainable mobility, healthcare, climate resilience and gender equity.',linkedin:'https://www.linkedin.com/in/nouran-aly-farouk-msc-mbbs-31637b195/'},
    {image:'c3.png',name:'Rabiatu Abdul-Aziz',location:'Ghana',profile:'Founder of HerGuided Tours & Cultural Experiences, preserving Northern Ghana’s cultural heritage while building inclusive, climate-smart livelihood opportunities for rural women, including disability-friendly shea processing.',linkedin:'https://www.linkedin.com/in/rabiatu-abdul-aziz-749a98219/'},
    {image:'c5.png',name:'Vanessa Wemekor',location:'Ghana',profile:'Climate activist, social entrepreneur and co-founder of Glassroot Innovations Ghana, transforming discarded glass into sustainable products while training young people in circular-economy entrepreneurship.',linkedin:'https://www.linkedin.com/in/vanessa-wemekor/'},
    {image:'c6.png',name:'Millicent Olale',location:'Kenya',profile:'Youth leader, entrepreneur and environmental champion working across climate activism, policy advocacy, research and programmes that empower children and young people.',linkedin:'https://www.linkedin.com/in/millicent-olale-29b978239/'},
    {image:'c9.png',name:'Judith Mwangi',location:'Kenya',profile:'Water engineer and sustainability advocate advancing climate resilience through sustainable infrastructure, circular-economy training, food security, ecosystem restoration and youth participation in water and climate policy.',linkedin:'https://www.linkedin.com/in/jmwangi01/'},
    {image:'c10.png',name:'Dr Kelly Masoto',location:'Botswana',profile:'Academic, researcher and industry professional combining environmental science, business strategy, geomatics, GIS and remote sensing to support sustainable infrastructure and climate-resilient development.',linkedin:'https://www.linkedin.com/in/dr-kelly-masoto-baa451358/'},
    {image:'c12.png',name:'Ethel Eyram Ahorlu',location:'Ghana',profile:'Renewable Energy Engineering student and founder of EcoVerde, developing climate-smart biodegradable products from agricultural waste while advancing clean energy, circular economy and youth climate education.',linkedin:'https://www.linkedin.com/in/ethel-ahorlu/'},
    {image:'NEW.png',name:'Mwaka Christinah Shivula',location:'Namibia',profile:'Lecturer, youth leader and climate advocate championing environmental awareness, sustainable agriculture, climate resilience and the inclusion of young African voices in global sustainability conversations.',linkedin:'https://www.linkedin.com/in/mwaka-christinah-shivula-b00a35141/'},
    {image:'ch1.jpg',name:'Miradouce Mekwago',location:'Cameroon',profile:'Geographer, geomatics specialist, educator and public servant strengthening climate literacy, responsible land management, environmental governance and the use of geospatial technologies for sustainable development.',linkedin:'https://www.linkedin.com/in/miradouce-mekwago-0a9136247/'},
    {image:'ch2.jpg',name:'Dr Irene Opoku-Ntim',location:'Ghana',profile:'Research scientist whose work connects nuclear science, environmental monitoring, public health and climate change, including research on how climate variability influences radon exposure and radiation risk.',linkedin:'https://www.linkedin.com/in/irene-opoku-ntim-phd-minstp-80473750/'},
    {image:'ch3.jpg',name:'Marese Oduro-Boateng',location:'Ghana',profile:'Meteorology and Climate Science graduate and climate advocate focused on climate justice, women’s leadership, youth engagement and building resilience for women and children in vulnerable communities.',linkedin:'https://www.linkedin.com/in/marese-oduro-boateng-5b8164288/'},
    {image:'66.jpg',name:'Abonia Ellen',location:'Ghana',profile:'Teacher, entrepreneur and climate-change lead connecting education, climate-smart agriculture, local value addition and girl-child empowerment through community-centred action.',linkedin:'https://www.linkedin.com/in/abonia-ellen-35360b325/'},
    {image:'CC.png',name:'Mary Akua Attah',location:'Ghana',profile:'Certified climate activist and Sustainable Development student focused on climate awareness, environmental sustainability, gender equity, youth empowerment and sustainability education.',linkedin:'https://www.linkedin.com/in/mary-akua-attah-15a9752b4/'},
    {image:'36.png',name:'Zelda Gadegbeku',location:'Ghana',profile:'Biodiversity conservation and environmental sustainability advocate working across climate research, community-centred conservation, knowledge sharing and climate-induced non-economic loss and damage.',linkedin:'https://www.linkedin.com/in/zelda-gad/'},
    {image:'c44.png',name:'Carine Esinam Gliku',location:'Ghana',profile:'Renewable Energy student and sustainable-building specialist advancing solar energy, energy-efficient buildings, building energy auditing and low-carbon, climate-resilient infrastructure.',linkedin:'https://www.linkedin.com/in/carine-esinam-gliku/'},
    {image:'c4444.png',name:'Sylvia Hagan',location:'Ghana',profile:'Industrial and Organisational Psychologist and researcher exploring the intersections of climate change, mental health, organisational behaviour, worker well-being and resilient workplaces.',linkedin:'https://www.linkedin.com/in/sylvia-hagan-a1a02317a/'},
    {image:'CHJ.png',name:'Rebecca “Jovial” Hargo Tetteh',location:'Ghana',profile:'Climate advocate, spoken-word artist and youth leader using climate education, creative expression, mentorship and community leadership to make sustainability more relatable and actionable for young people.',linkedin:'https://www.linkedin.com/in/hargotetteh/'}
  ],
  2026:[]
};
const honoursYears=[2025,2026];
function HonoursPage(){
 const [archiveYear,setArchiveYear]=useState(2025);
 const[formOpen,setFormOpen]=useState(false);
 const[selectedHonouree,setSelectedHonouree]=useState(null);
 const[selectedHonoursPathway,setSelectedHonoursPathway]=useState(null);
 const archiveRef=useRef(null);
 useEffect(()=>{if(!selectedHonouree)return;const onKey=e=>e.key==='Escape'&&setSelectedHonouree(null);window.addEventListener('keydown',onKey);document.body.style.overflow='hidden';return()=>{window.removeEventListener('keydown',onKey);document.body.style.overflow=''}},[selectedHonouree]);
 const openForm=()=>setFormOpen(true);
 const goArchive=()=>archiveRef.current?.scrollIntoView({behavior:'smooth',block:'start'});
 return <><style>{`
.honoursArchivePerson{display:block;width:100%;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer;border-radius:24px}
.honoursArchivePerson figure{height:100%;margin:0;transition:transform .25s ease}
.honoursArchivePerson:hover figure,.honoursArchivePerson:focus-visible figure{transform:translateY(-5px)}
.honoursArchivePerson:focus-visible{outline:3px solid #c6ff52;outline-offset:5px}
.honoursArchivePerson figcaption{display:grid;grid-template-columns:auto 1fr;gap:3px 12px;align-items:center}
.honoursArchivePerson figcaption span{grid-row:1/3}
.honoursArchivePerson figcaption small{font-size:11px;text-transform:uppercase;letter-spacing:.12em;opacity:.62}
.honoureeModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:24px}
.honoureeModalBackdrop{position:absolute;inset:0;border:0;background:rgba(2,28,27,.84);backdrop-filter:blur(12px);cursor:pointer}
.honoureeProfileCard{position:relative;z-index:1;width:min(980px,94vw);max-height:min(820px,92vh);display:grid;grid-template-columns:minmax(300px,.9fr) minmax(340px,1.1fr);overflow:hidden;border-radius:30px;background:#083f3e;color:#fff;box-shadow:0 36px 100px rgba(0,0,0,.38);border:1px solid rgba(198,255,82,.18)}
.honoureeProfileClose{position:absolute;z-index:4;top:18px;right:18px;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.22);background:rgba(4,45,43,.76);color:#fff;cursor:pointer}
.honoureeProfileImage{min-height:540px;background:#062f2e;overflow:hidden}
.honoureeProfileImage img{display:block;width:100%;height:100%;object-fit:cover}
.honoureeProfileCopy{padding:clamp(32px,5vw,64px);display:flex;flex-direction:column;justify-content:center;align-items:flex-start}
.honoureeProfileCopy>span{font-size:11px;font-weight:800;letter-spacing:.16em;color:#c6ff52}
.honoureeProfileCopy h2{margin:14px 0 5px;font-size:clamp(34px,5vw,64px);line-height:.96;letter-spacing:-.045em}
.honoureeProfileCopy>small{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.62)}
.honoureeProfileCopy p{margin:26px 0 30px;max-width:52ch;font-size:clamp(15px,1.5vw,18px);line-height:1.68;color:rgba(255,255,255,.78)}
@media(max-width:760px){
 .honoureeModal{padding:10px;align-items:end}
 .honoureeProfileCard{width:100%;max-height:94vh;grid-template-columns:1fr;overflow:auto;border-radius:24px 24px 12px 12px}
 .honoureeProfileImage{min-height:0;height:min(44vh,390px)}
 .honoureeProfileImage img{object-position:center top}
 .honoureeProfileCopy{padding:28px 22px 30px}
 .honoureeProfileCopy h2{font-size:clamp(34px,10vw,48px)}
 .honoureeProfileCopy p{margin:20px 0 24px}
 .honoureeProfileClose{top:14px;right:14px}
}
`}</style>
  <section className="hero hero-honours"><div className="heroTop"><div className="heroCopy"><h1>Amplify the Untold.</h1><div className="actions"><button className="pill lime" onClick={openForm}>NOMINATE A LEADER</button><Link to="/circle" className="pill ghost">Join the community</Link></div></div><HeroVisual type="honours"/></div></section>
  <main className="honoursPage">
   <section className="honoursIntro"><span>CLIMATE HONOURS · 2026</span><div><h2>African women aren't waiting for climate solutions. They are engineering them</h2><p>Following the legacy of 18 featured leaders in 2025, WOMATE is documenting the next generation of women whose leadership is changing communities, fields and institutions across Africa.</p></div><aside><b>18</b><span>Voices elevated in 2025</span><button onClick={goArchive}>View the archive</button></aside></section>
   <section className="honoursJourney"><div className="honoursSectionHead"><h2 className="honoursJourneyTitle">THE JOURNEY TO OCTOBER 2026</h2></div><div className="honoursJourneyGrid"><article><b>01</b><h3>Nomination</h3><p>Name a woman whose climate work deserves wider recognition or submit your own story.</p></article><article><b>02</b><h3>Editorial review</h3><p>WOMATE reviews each story for clarity, credibility, impact and relevance to women-led climate action.</p></article><article><b>03</b><h3>Spotlight</h3><p>Selected leaders are documented through WOMATE’s Digital Magazine and Global Spotlight storytelling.</p></article><article><b>04</b><h3>October 2026</h3><p>The next cohort of climate leaders is elevated into the Honours ecosystem and connected to future opportunities.</p></article></div></section>
   <section className="honoursArchive" ref={archiveRef}><div className="honoursArchiveSymbol" aria-hidden="true"><img src="/assets/hero/honour-symbol.png" alt=""/></div><div className="honoursArchiveHead"><div><span>CLIMATE HONOURS ARCHIVE</span><h2>{archiveYear===2025?'18 pioneers. One growing record of African climate leadership.':archiveYear+' Climate Honours'}</h2></div><p>The archive is evidence that women’s climate work is happening, scaling and shaping the continent.</p></div><div className="honoursYearTabs" role="tablist" aria-label="Climate Honours archive years">{honoursYears.map(y=><button key={y} role="tab" aria-selected={archiveYear===y} className={archiveYear===y?'active':''} onClick={()=>setArchiveYear(y)}>{y}{y===2026&&<small>Unveiling Nov–Dec</small>}</button>)}</div>{archiveYear===2025?<div className="honoursArchiveGrid">{honoursArchiveByYear[2025].map((person,i)=><button type="button" className="honoursArchivePerson" key={person.image} onClick={()=>setSelectedHonouree(person)} aria-label={'Open profile for '+person.name}><figure><img src={'/assets/img/CH/'+person.image} alt={person.name+' — WOMATE Climate Honours 2025'} loading="lazy"/><figcaption><span>{String(i+1).padStart(2,'0')}</span><b>{person.name}</b><small>View profile</small></figcaption></figure></button>)}</div>:<div className="honoursLockedYear"><span>2026</span><h3>The next record is being prepared.</h3><p>WOMATE will unveil the 2026 Climate Honours cohort in November–December 2026. The archive will open here when the cohort is announced.</p><button className="pill lime" onClick={openForm}>NOMINATE A LEADER</button></div>}</section>
   <section className="honoursPathways iconPillarSection"><div className="honoursSectionHead iconPillarHead"><span>IS THE STORY YOURS TO TELL?</span><h2>Visibility is only the first layer.</h2><p>Whether it is your own innovation or a woman leading in your community, WOMATE turns recognition into access.</p></div><div className="iconPillarTray honoursPathwayTray"><div className="iconPillarGrid honoursPathwayIconGrid">{[
 {label:'The Spotlight',copy:'Be featured through WOMATE’s editorial storytelling and Global Spotlight series.',Icon:Sparkles},
 {label:'The Circle',copy:'Be welcomed into the WOMATE Circle, connecting with women across climate, leadership and related fields.',Icon:Users},
 {label:'The Honor',copy:'Join a growing record of women whose climate leadership WOMATE is committed to recognising and amplifying over time.',Icon:Award}
].map((item,i)=><button type="button" className="iconPillarCard" key={item.label} onClick={()=>setSelectedHonoursPathway({...item,index:i})} aria-label={'Explore '+item.label}><span className="iconPillarNo">{String(i+1).padStart(2,'0')}</span><span className="iconPillarGlyph"><item.Icon size={28} strokeWidth={1.7}/></span><strong>{item.label}</strong></button>)}</div><small className="iconPillarHint">SELECT AN ICON TO EXPLORE</small></div></section>
   <section className="honoursBenefits"><div><span>BEYOND RECOGNITION</span><h2>Recognition should open doors.</h2></div><div className="honoursBenefitList"><div><strong>Visibility that travels</strong><p>Selected leaders are amplified through WOMATE’s platforms and storytelling.</p></div><div><strong>Connections that matter</strong><p>Build relationships with women working across climate, leadership, research and related fields.</p></div><div><strong>Access to opportunity</strong><p>Receive relevant invitations to WOMATE programmes, events, collaborations and opportunities as they become available.</p></div><div><strong>A community beyond the spotlight</strong><p>Stay connected to the WOMATE Circle and a growing network of women shaping climate action across Africa.</p></div></div></section>
   <section className="honoursNominate"><div><span>AMPLIFY THE UNTOLD</span><h2>Know a woman rewriting Africa’s climate future?</h2><p>Nominate her or submit your own climate leadership story for consideration in the 2026 Climate Honours.</p></div><button className="pill lime" onClick={openForm}>NOMINATE A LEADER</button></section>
   
  </main>
  {selectedHonoursPathway&&<div className="iconPillarModal" role="dialog" aria-modal="true" aria-labelledby="honours-pathway-title"><button className="iconPillarBackdrop" aria-label="Close" onClick={()=>setSelectedHonoursPathway(null)}/><article className="iconPillarDialog"><button type="button" aria-label="Close" onClick={()=>setSelectedHonoursPathway(null)}><X size={20}/></button><div className="iconPillarDialogIcon"><selectedHonoursPathway.Icon size={28} strokeWidth={1.7}/></div><span>{String(selectedHonoursPathway.index+1).padStart(2,'0')} · CLIMATE HONOURS</span><h3 id="honours-pathway-title">{selectedHonoursPathway.label}</h3><p>{selectedHonoursPathway.copy}</p></article></div>}
   {selectedHonouree&&<div className="honoureeModal" role="dialog" aria-modal="true" aria-labelledby="honouree-profile-name"><button className="honoureeModalBackdrop" aria-label="Close profile" onClick={()=>setSelectedHonouree(null)}/><article className="honoureeProfileCard"><button className="honoureeProfileClose" aria-label="Close profile" onClick={()=>setSelectedHonouree(null)}><X/></button><div className="honoureeProfileImage"><img src={'/assets/img/CH/'+selectedHonouree.image} alt={selectedHonouree.name}/></div><div className="honoureeProfileCopy"><span>WOMATE CLIMATE HONOURS · 2025</span><h2 id="honouree-profile-name">{selectedHonouree.name}</h2><small>{selectedHonouree.location}</small><p>{selectedHonouree.profile}</p><a className="pill lime" href={selectedHonouree.linkedin} target="_blank" rel="noreferrer">View LinkedIn profile <ArrowUpRight size={17}/></a></div></article></div>}
   {formOpen&&<div className="honoursModal" role="dialog" aria-modal="true"><button className="honoursModalBackdrop" onClick={()=>setFormOpen(false)} aria-label="Close nomination form"/><div className="honoursModalPanel"><div className="honoursModalHead"><div><span>WOMATE CLIMATE HONOURS</span><h2>Nominate a leader</h2></div><button onClick={()=>setFormOpen(false)} aria-label="Close"><X/></button></div><iframe src={HONOURS_FORM} title="African Women in Climate Change Story Submission">Loading…</iframe></div></div>}
 </>
}


function LeadershipPage(){
 const team=[
  {name:'Phillipa Aidoo',role:'Chief Executive Officer',unit:'TECHNOLOGY',image:'/assets/img/team/phillipa-aidoo.png',linkedin:'https://gh.linkedin.com/in/phillipa-aidoo',bio:"Chief Strategist & Full-stack Developer. Architect of WOMATE’s integrated climate-tech ecosystem and the organisation’s strategic direction."},
  {name:'Asaa Gyebi-Adjei',role:'Board Member',unit:'RESEARCH',image:'/assets/img/team/asaa.jpeg',linkedin:'https://gh.linkedin.com/in/asaa-gyebi-adjei-902a03111',bio:'PhD Candidate & Strategic Economist. Leads data analysis and research thinking for high-impact adaptation projects.'},
  {name:'Ruby Damenshie-Brown',role:'Chief Operating Officer',unit:'PROGRAMS',image:'/assets/img/team/ruby-damenshie-brown.jpg',linkedin:'https://gh.linkedin.com/in/ruby-damenshie-brown-she-her-582b7287',bio:'Operations Specialist focused on community engagement, programme delivery and the regional scaling of climate initiatives.'},
  {name:'Hamza Abubakar',role:'Chief Communications Officer',unit:'ADVOCACY',image:'/assets/img/team/h.jpg',linkedin:'https://gh.linkedin.com/in/hamza-abubakar-537852214',bio:'UN Climate Champion advancing global communication, advocacy and public engagement for planetary stewardship.'}
 ];
 const [status,setStatus]=useState('');
 const endpoint=import.meta.env.VITE_LEADERSHIP_INQUIRY_ENDPOINT||'';
 const submit=async e=>{e.preventDefault();setStatus('sending');const f=new FormData(e.currentTarget);const payload=Object.fromEntries(f.entries());try{if(endpoint){const r=await fetch(endpoint,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error('Request failed');setStatus('sent');e.currentTarget.reset()}else{const subject=encodeURIComponent('WOMATE leadership partnership enquiry');const body=encodeURIComponent(`Name / Organisation: ${payload.name}\nEmail: ${payload.email}\nInterest: ${payload.interest}\n\n${payload.message||''}`);window.location.href=`mailto:womatead@gmail.com?subject=${subject}&body=${body}`;setStatus('sent')}}catch(err){setStatus('error')}};
 const goTeam=()=>document.getElementById('leadership-team')?.scrollIntoView({behavior:'smooth'});
 const goPartner=()=>document.getElementById('leadership-partner')?.scrollIntoView({behavior:'smooth'});
 return <><section className="hero hero-leadership"><div className="heroTop"><div className="heroCopy"><h1>Driving Inclusive Climate Action with Technology.</h1><div className="actions"><button className="pill lime" onClick={goTeam}>Meet the leadership</button><button className="pill ghost" onClick={goPartner}>Partner with WOMATE</button></div></div><HeroVisual type="leadership"/></div></section><main id="content" className="leadershipPage">
  <section className="leadershipMandate"><div><span>STRATEGIC OVERSIGHT · 2026</span><h2>Leadership built to connect community wisdom with scalable climate systems.</h2></div><div><p>WOMATE drives women-led climate adaptation across Africa by connecting technology, research, programmes and advocacy into one operating ecosystem.</p><p>That means leadership is not ceremonial. Each executive discipline is tied directly to how knowledge is created, programmes are delivered, communities are represented and climate action is scaled.</p></div></section>
  <section className="leadershipTeam" id="leadership-team"><div className="leadershipSectionHead"><span>EXECUTIVE UNIT</span><h2>Four disciplines. One climate mandate.</h2><p>The leadership team combines technical building, research intelligence, programme operations and public advocacy.</p></div><div className="leadershipProfileGrid">{team.map((m,i)=><article className="leadershipProfile" key={m.name}><figure><img src={m.image} alt={m.name}/><figcaption><span>{String(i+1).padStart(2,'0')}</span><b>{m.unit}</b></figcaption></figure><div className="leadershipProfileCopy"><span>{m.role}</span><h3>{m.name}</h3><p>{m.bio}</p><a className="leadershipLinkedin" href={m.linkedin} target="_blank" rel="noreferrer">LinkedIn <ArrowUpRight size={15}/></a></div></article>)}</div></section>
  <section className="leadershipDisciplines"><div className="leadershipSectionHead compact"><span>HOW LEADERSHIP OPERATES</span><h2>Institutional strength comes from connected disciplines.</h2></div><div className="leadershipDisciplineGrid"><article><b>01</b><h3>Technology</h3><p>Translate climate challenges into useful digital systems, accessible tools and scalable infrastructure.</p></article><article><b>02</b><h3>Research</h3><p>Ground decisions in gender-responsive evidence, economics, community data and measurable learning.</p></article><article><b>03</b><h3>Programs</h3><p>Turn strategy into credible learning, community and adaptation programmes that women can use and sustain.</p></article><article><b>04</b><h3>Advocacy</h3><p>Move women’s climate leadership into public narratives, policy conversations and global partnership spaces.</p></article></div></section>
  <section className="leadershipImpact"><div><span>INSTITUTIONAL IMPACT</span><h2>Scaling women-led research and adaptation into wider climate influence.</h2></div><div className="leadershipImpactProof"><article><strong>Knowledge</strong><p>Community intelligence is documented, analysed and protected.</p></article><article><strong>Systems</strong><p>Technology makes access, coordination and evidence easier to scale.</p></article><article><strong>Leadership</strong><p>Women move from programme participation into visible decision-making roles.</p></article><article><strong>Partnership</strong><p>Institutions can plug into a credible women-led climate ecosystem.</p></article></div></section>
  <section className="leadershipPartner" id="leadership-partner"><div><span>PARTNERSHIP INVITATION</span><h2>Build with WOMATE.</h2><p>Partner with us to strengthen women-led climate leadership, research, technology and community action across Africa.</p><a href="mailto:womatead@gmail.com">womatead@gmail.com</a></div><form onSubmit={submit}><label>Name / organisation<input name="name" required/></label><label>Email address<input name="email" required type="email" autoComplete="email"/></label><select name="interest" defaultValue=""><option value="" disabled>Area of interest</option><option>Strategic partnership</option><option>Research collaboration</option><option>Programme partnership</option><option>Technology collaboration</option><option>Funding / investment</option><option>Speaking / advocacy</option></select><textarea name="message" placeholder="What would you like to build with WOMATE?"/><label className="leadershipBriefLink">
    <span>Supporting document / partnership brief <b>*</b></span>
    <input required type="url" name="partnership_brief_link" inputMode="url" pattern="https://.*" placeholder="https://drive.google.com/..." aria-describedby="leadership-brief-help"/>
    <small id="leadership-brief-help">Paste a viewable Google Drive, OneDrive or Dropbox link. Please make sure anyone with the link can view it.</small>
  </label><button className="pill lime" disabled={status==='sending'}>{status==='sending'?'Sending…':'Initiate partnership'}</button>{status==='sent'&&<small>Thank you. Your enquiry is ready for the WOMATE team.</small>}{status==='error'&&<small className="formError">We could not send this yet. Please email womatead@gmail.com.</small>}</form></section>
 </main></>
}



const WOMATEER_FORM=import.meta.env.VITE_WOMATEER_FORM_EMBED_URL||'https://docs.google.com/forms/d/e/1FAIpQLSe6MZY9sqaYTHzYu1-gm53MbHQIwh8UiA40akKWjubQhXDFpw/viewform?embedded=true';
const WOMATEER_INQUIRY_ENDPOINT=import.meta.env.VITE_WOMATEER_INQUIRY_ENDPOINT||'';
const womateerRoles=[
 {n:'01',title:'Visual Strategist',role:'Graphic Designer',desc:'Shape the visual language of the movement. Translate purpose, dignity and impact into compelling design that strengthens WOMATE’s identity and amplifies women’s voices.',skills:['Brand systems','Campaign design','Editorial storytelling']},
 {n:'02',title:'Digital Systems Lead',role:'Developer',desc:'Design and maintain the digital platforms that power our programmes. Build accessible, reliable infrastructure that connects communities, partners and ideas.',skills:['Web systems','Accessibility','Digital operations']},
 {n:'03',title:'Impact Storyteller',role:'Social Media & Video Lead',desc:'Craft narratives that move beyond awareness into action. Produce ethical, high-quality content that communicates WOMATE’s mission clearly and globally.',skills:['Social media','Video','Impact narratives']},
 {n:'04',title:'Community Impact Lead',role:'Community Engagement Coordinator',desc:'Serve as the bridge between strategy and grassroots action. Coordinate programmes, partnerships and outreach that translate vision into measurable impact.',skills:['Community engagement','Coordination','Partnership delivery']}
];
const womateerRoleIcons=[Sparkles,Globe2,Radio,Users];
const womateerRoleLabels=['Design','Digital','Storytelling','Community'];
function WomateerPage(){
 const rolesRef=useRef(null);const[applyOpen,setApplyOpen]=useState(false);const[selectedWomateerRole,setSelectedWomateerRole]=useState(null);const[status,setStatus]=useState('');
 const goRoles=()=>rolesRef.current?.scrollIntoView({behavior:'smooth',block:'start'});
 const submitInquiry=async(e)=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget));setStatus('sending');try{if(!WOMATEER_INQUIRY_ENDPOINT){window.location.href=`mailto:womatead@gmail.com?subject=${encodeURIComponent('WOMATEER enquiry — '+(data.name||''))}&body=${encodeURIComponent(`Name: ${data.name||''}\nEmail: ${data.email||''}\nRole: ${data.role||''}\n\n${data.message||''}`)}`;setStatus('ready');return}const r=await fetch(WOMATEER_INQUIRY_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,source:'WOMATEER'})});if(!r.ok)throw new Error();setStatus('sent');e.currentTarget.reset()}catch{setStatus('error')}};
 return <>
  <section className="hero hero-volunteer"><div className="heroTop"><div className="heroCopy"><h1>Elevate Your Impact as a WOMATEER</h1><div className="actions"><button className="pill lime" onClick={()=>setApplyOpen(true)}>Apply to become a WOMATEER</button><button className="pill ghost" onClick={goRoles}>Explore roles</button></div></div><HeroVisual type="volunteer"/></div></section>
  <main className="womateerPage">
   <section className="womateerIntro"><span>WOMATEER · 2026 COHORT</span><div><h2>Where purpose meets professional excellence.</h2><p>WOMATEER is WOMATE’s skill-driven volunteer ecosystem for professionals who want their expertise to create measurable climate and social impact. This is not volunteering as an add-on. It is structured contribution—designers, developers, storytellers and community coordinators working alongside a women-led climate organisation.</p></div></section>
   <style>{`
.wmPathways{padding:clamp(54px,6vw,82px) clamp(18px,5vw,72px) clamp(60px,7vw,92px);background:linear-gradient(180deg,#f5f8f6 0%,#fff 100%)}
.wmPathwaysHead{max-width:980px;margin:0 auto clamp(28px,4vw,42px);text-align:center}
.wmPathwaysHead>span{display:block;margin:0 0 10px;font-size:10px;line-height:1.2;font-weight:800;letter-spacing:.17em;text-transform:uppercase;color:#6c8b89}
.wmPathwaysHead h2{margin:0 auto;max-width:16ch;font:700 clamp(34px,4.4vw,58px)/1 inherit;letter-spacing:-.043em;color:#0e4d4a;text-wrap:balance}
.wmPathwaysTray{max-width:900px;margin:0 auto;padding:18px;border:1px solid rgba(14,77,74,.08);border-radius:32px;background:rgba(255,255,255,.84);box-shadow:0 20px 60px rgba(6,58,55,.065)}
.wmPathwaysGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.wmPathwayButton{-webkit-appearance:none;appearance:none;position:relative;min-width:0;min-height:142px;margin:0;padding:18px 10px 15px;border:0!important;border-radius:22px!important;background:transparent!important;color:#0e4d4a!important;box-shadow:none!important;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;cursor:pointer;font:inherit!important}
.wmPathwayButton:hover,.wmPathwayButton:focus-visible{transform:translateY(-2px);background:rgba(14,77,74,.035)!important}
.wmPathwayNo{position:absolute;top:11px;left:12px;font-size:9px;font-weight:850;letter-spacing:.14em;color:#78918f}
.wmPathwayIcon{width:66px;height:66px;flex:0 0 66px;border-radius:21px;display:grid;place-items:center;background:#edf5f1;color:#0e4d4a;box-shadow:0 9px 25px rgba(6,58,55,.065)}
.wmPathwayButton:nth-child(2) .wmPathwayIcon{background:#f1edf8}.wmPathwayButton:nth-child(3) .wmPathwayIcon{background:#e8f2f2}.wmPathwayButton:nth-child(4) .wmPathwayIcon{background:#f7efe4}
.wmPathwayButton:hover .wmPathwayIcon,.wmPathwayButton:focus-visible .wmPathwayIcon{background:#c6ff52;transform:scale(1.04)}
.wmPathwayButton strong{font-size:13px;line-height:1.08;letter-spacing:-.015em;max-width:12ch}
.wmPathwaysHint{display:block;margin:16px auto 0;text-align:center;font-size:9px;letter-spacing:.13em;text-transform:uppercase;color:#78918f}
.wmPathwayModal{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:18px}.wmPathwayBackdrop{position:absolute;inset:0;border:0;background:rgba(2,30,29,.78);backdrop-filter:blur(12px)}
.wmPathwayDialog{position:relative;z-index:1;width:min(700px,94vw);padding:clamp(32px,5vw,58px);border-radius:32px;background:#083f3e;color:#fff;box-shadow:0 36px 100px rgba(0,0,0,.4);border:1px solid rgba(198,255,82,.18)}
.wmPathwayClose{position:absolute;top:16px;right:16px;width:42px;height:42px;border-radius:50%!important;border:1px solid rgba(255,255,255,.16)!important;background:rgba(255,255,255,.07)!important;color:#fff!important;display:grid;place-items:center;cursor:pointer}
.wmPathwayDialogIcon{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:#c6ff52;color:#083f3e;margin-bottom:22px}.wmPathwayMeta{font-size:11px;font-weight:850;letter-spacing:.16em;color:#c6ff52}.wmPathwayDialog h3{margin:14px 46px 18px 0;font-size:clamp(34px,6vw,58px);line-height:.96;letter-spacing:-.045em;max-width:14ch}.wmPathwayDialog p{margin:0;max-width:54ch;font-size:clamp(15px,1.6vw,18px);line-height:1.7;color:rgba(255,255,255,.82)}
.wmPathwayTags{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}.wmPathwayTags em{font-style:normal;font-size:10px;font-weight:750;letter-spacing:.06em;padding:8px 11px;border:1px solid rgba(198,255,82,.25);border-radius:999px;color:#dfffa0}.wmPathwayApply{margin-top:26px}
@media(max-width:760px){.wmPathwaysHead{text-align:left;margin-bottom:24px}.wmPathwaysHead h2{margin-left:0;font-size:clamp(30px,8vw,42px);max-width:18ch}.wmPathwaysTray{padding:11px;border-radius:25px}.wmPathwaysGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.wmPathwayButton{min-height:116px;border-radius:18px!important;padding:15px 8px 12px}.wmPathwayIcon{width:56px;height:56px;flex-basis:56px;border-radius:17px}.wmPathwayDialog{padding:30px 23px 28px;border-radius:25px}}
`}</style>
<section className="wmPathways" ref={rolesRef}><div className="wmPathwaysHead"><span>OPEN PATHWAYS</span><h2>Four disciplines. One shared mission.</h2></div><div className="wmPathwaysTray"><div className="wmPathwaysGrid">{womateerRoles.map((r,i)=>{const Icon=womateerRoleIcons[i];return <button type="button" className="wmPathwayButton" key={r.n} onClick={()=>setSelectedWomateerRole({...r,i})} aria-label={`${r.title}. Open pathway details`}><span className="wmPathwayNo">{r.n}</span><span className="wmPathwayIcon"><Icon size={27} strokeWidth={1.8}/></span><strong>{womateerRoleLabels[i]}</strong></button>})}</div><span className="wmPathwaysHint">Select a pathway to explore</span></div></section>
   <section className="womateerStandard"><div><span>WHAT COMMITMENT LOOKS LIKE</span><h2>Bring the skill. Bring the discipline.</h2></div><div className="womateerCommitGrid"><article><b>01</b><h3>Professional contribution</h3><p>You are joining to apply an existing or developing professional skill to live organisational work—not simply observe.</p></article><article><b>02</b><h3>Remote readiness</h3><p>The application checks remote-work comfort and access to a working laptop because collaboration happens across locations.</p></article><article><b>03</b><h3>Reliable availability</h3><p>Applicants identify weekly availability and preferred commitment period so responsibilities can be matched realistically.</p></article><article><b>04</b><h3>Values alignment</h3><p>Strong WOMATEERs combine technical quality with dignity, inclusion, responsible storytelling and respect for communities.</p></article></div></section>
   <section className="womateerJourney"><div className="womateerSectionHead"><span>THE JOURNEY</span><h2>Apply with intention.</h2></div><div className="womateerJourneyGrid"><div><b>01</b><strong>Choose your role</strong><p>Identify where your strongest skill can create value.</p></div><div><b>02</b><strong>Submit your application</strong><p>Share your experience, availability and practical working preferences.</p></div><div><b>03</b><strong>Alignment review</strong><p>WOMATE reviews fit across skills, needs, commitment and values.</p></div><div><b>04</b><strong>Contribute to live work</strong><p>Selected WOMATEERs join a collaborative, values-led working ecosystem.</p></div></div><button className="pill lime" onClick={()=>setApplyOpen(true)}>Start your application</button></section>
   <section className="womateerWhy"><div className="womateerWhyMark">W</div><div><span>WHY WOMATEER</span><h2>Meaningful work should leave evidence.</h2><p>Your contribution should strengthen a programme, system, story, campaign or community process. WOMATEER is designed around work that can be seen, used and built upon.</p></div><div className="womateerProof"><span>Climate resilience</span><span>Women’s empowerment</span><span>Social equity</span><span>Community leadership</span></div></section>
   <section className="womateerInquiry"><div><span>BEFORE YOU APPLY</span><h2>Need to clarify fit?</h2><p>If you have a specialist skill or an application question that does not fit the four pathways cleanly, contact the WOMATE team.</p></div><form onSubmit={submitInquiry}><label>Full name<input name="name" required autoComplete="name"/></label><label>Email address<input name="email" type="email" required autoComplete="email"/></label><select name="role"><option value="">Area of interest</option>{womateerRoles.map(r=><option key={r.title}>{r.title}</option>)}<option>Other specialist skill</option></select><textarea name="message" required placeholder="Tell us briefly what you can contribute or what you need clarified."/><button className="pill darkbtn" disabled={status==='sending'}>{status==='sending'?'Sending…':'Send enquiry'}</button>{status==='sent'&&<small>Thank you. Your enquiry has been received.</small>}{status==='ready'&&<small>Your email app has been opened with the enquiry prepared.</small>}{status==='error'&&<small>Submission failed. Please try again.</small>}</form></section>
  </main>
  {selectedWomateerRole&&(()=>{const Icon=womateerRoleIcons[selectedWomateerRole.i];return <div className="wmPathwayModal" role="dialog" aria-modal="true" aria-labelledby="womateer-pathway-title"><button className="wmPathwayBackdrop" aria-label="Close" onClick={()=>setSelectedWomateerRole(null)}/><article className="wmPathwayDialog"><button type="button" className="wmPathwayClose" aria-label="Close" onClick={()=>setSelectedWomateerRole(null)}><X size={20}/></button><div className="wmPathwayDialogIcon"><Icon size={28} strokeWidth={1.8}/></div><span className="wmPathwayMeta">{selectedWomateerRole.n} · {selectedWomateerRole.role}</span><h3 id="womateer-pathway-title">{selectedWomateerRole.title}</h3><p>{selectedWomateerRole.desc}</p><div className="wmPathwayTags">{selectedWomateerRole.skills.map(x=><em key={x}>{x}</em>)}</div><button className="pill lime wmPathwayApply" onClick={()=>{setSelectedWomateerRole(null);setApplyOpen(true)}}>Apply for this pathway</button></article></div>})()}
  {applyOpen&&<div className="womateerModal" role="dialog" aria-modal="true" aria-label="WOMATEER application"><button className="womateerBackdrop" onClick={()=>setApplyOpen(false)} aria-label="Close application"/><div className="womateerModalPanel"><div className="womateerModalHead"><div><span>WOMATEER 2026</span><h2>Apply with Intention</h2><p>Complete the secure WOMATE volunteer recruitment form.</p></div><button onClick={()=>setApplyOpen(false)} aria-label="Close"><X/></button></div><iframe src={WOMATEER_FORM} title="WOMATE Volunteer Recruitment Form">Loading…</iframe></div></div>}
 </>
}

const FUNDING_INTEREST_ENDPOINT=import.meta.env.VITE_FUNDING_INTEREST_ENDPOINT||'';
function FundingPage(){
 const[open,setOpen]=useState(false),[status,setStatus]=useState('');
 const submit=async e=>{e.preventDefault();const form=e.currentTarget,data=Object.fromEntries(new FormData(form).entries());setStatus('sending');
 if(FUNDING_INTEREST_ENDPOINT){try{let r=await fetch(FUNDING_INTEREST_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,programme:'WOMATE 2027 Funding Interest'})});if(!r.ok)throw 0;setStatus('sent');form.reset()}catch{setStatus('error')}return}
 const subject=encodeURIComponent('WOMATE 2027 Funding Interest');const body=encodeURIComponent(`Name: ${data.name}\nEmail: ${data.email}\nCountry: ${data.country}\nVenture stage: ${data.stage}\nClimate focus: ${data.focus}\n\n${data.note||''}`);window.location.href=`mailto:womatead@gmail.com?subject=${subject}&body=${body}`;setStatus('ready')};
 return <><section className="hero fundingHero"><div className="heroTop"><div className="heroCopy"><h1>Build a stronger case for climate capital.</h1><p>Grant-readiness support for African women founders building credible climate initiatives.</p><div className="actions"><button className="pill lime" onClick={()=>setOpen(true)}>Register interest · 2027</button><button className="pill ghost" onClick={()=>document.getElementById('funding-support')?.scrollIntoView({behavior:'smooth'})}>Explore support</button></div></div><div className="fundingOrb fundingHeroArtwork"><img src="/assets/hero/funding.png" alt="WOMATE funding support"/></div></div></section>
 <main className="fundingPage">
 <section className="fundingClosed"><b>2026 CYCLE · CLOSED</b><p>The 2026 support programme has concluded.</p></section>
 <section className="fundingSupportGrid">{[
 ['01','READINESS DIAGNOSTIC','Understand what is fundable now, what evidence is missing, and what to strengthen before a call opens.'],
 ['02','APPLICATION REVIEW','Improve clarity, alignment, completeness and competitive positioning before submission.'],
 ['03','GRANT WRITING CAPACITY','Frame the problem, solution, outcomes, budget logic and evidence with greater confidence.'],
 ['04','DOCUMENTATION','Prepare reusable materials funders repeatedly request instead of rebuilding from zero.'],
 ['05','FOUNDER POSITIONING','Connect climate impact, gender responsiveness, traction and implementation capacity into one credible case.'],
 ['06','COMMUNITY ACCESS','Learn alongside women building climate solutions and exchange useful funding intelligence and peer support.']
 ].map(([n,h,d])=><article key={n}><span>{n}</span><h3>{h}</h3><p>{d}</p></article>)}</section>
 <section className="fundingRegister"><div><span>THE 2027 REGISTER</span><h2>Register now. Apply when the right opportunity opens.</h2></div><div className="fundingSteps"><p><b>01 · SIGNAL INTEREST</b><br/>Tell WOMATE what you are building and what kind of capital you are preparing for.</p><p><b>02 · BUILD READINESS</b><br/>Use the waiting period to strengthen evidence, documentation and your funding narrative.</p><p><b>03 · RECEIVE CONFIRMED UPDATES</b><br/>WOMATE can contact registered founders when relevant 2027 support or opportunities are confirmed.</p></div></section>
 <section className="fundingCTA"><span>2027 · REGISTER OF INTEREST</span><h2>Do not wait for the deadline to start getting ready.</h2><p>This is an interest register, not a grant application and not a promise of funding.</p><button className="pill lime" onClick={()=>setOpen(true)}>Register interest</button></section>
 </main>
 {open&&<div className="formModal" role="dialog" aria-modal="true"><button className="formBackdrop" onClick={()=>setOpen(false)}/><div className="fundingForm"><button className="fundingClose" onClick={()=>setOpen(false)}>Ã—</button><span>WOMATE · 2027</span><h2>Funding interest register</h2><p>Leave the essentials so WOMATE can share confirmed 2027 funding-support information when available.</p><form onSubmit={submit}><label>Full name<input required name="name" autoComplete="name"/></label><label>Email address<input required name="email" type="email" autoComplete="email"/></label><label>Country<input required name="country" autoComplete="country-name"/></label><select required name="stage" defaultValue=""><option value="" disabled>Venture / project stage</option><option>Idea / pre-launch</option><option>Early stage</option><option>Operating / revenue</option><option>Growth stage</option><option>Community / nonprofit project</option></select><label>Climate focus<input required name="focus"/></label><textarea name="note" placeholder="What are you preparing to fund?"/><label className="fundingConsent"><input required type="checkbox"/> I agree to receive relevant WOMATE funding-support updates.</label><button className="pill darkbtn" disabled={status==='sending'}>{status==='sending'?'Submitting…':'Join 2027 interest register'}</button>{status==='sent'&&<small>Interest recorded. Thank you.</small>}{status==='ready'&&<small>Your email app has opened with your registration details.</small>}{status==='error'&&<small>Could not submit. Please try again.</small>}</form></div></div>}
 </>}
function Standard({p}){const d=details[p.type],g=pageGallery[p.type]||pageGallery.she;return <><Hero p={p}/><main id="content"><section className="programmeIntro"><div><h3>{d.title}</h3></div><div><p className="lead">Built for credibility in the room and usefulness on the ground. WOMATE combines rigorous thinking with accessible delivery so women can move from participation to influence.</p><div className="miniProof"><ShieldCheck/> Africa-rooted · evidence-led · community-built</div></div></section><section className="galleryTriptych"><figure className="gBig"><img src={g[0]}/><figcaption>WOMATE · {p.k}</figcaption></figure><figure><img src={g[1]}/></figure><figure><img src={g[2]}/></figure></section><section className="featureList">{d.items.map((x,i)=><div className="feature" key={x}><span>0{i+1}</span><h4>{x}</h4><ArrowUpRight/></div>)}</section>{p.type==='she'&&<section className="certificateScene"><div><h3>Learning should leave women with proof, practice and a stronger next step.</h3><p>Structured learning, applied reflection and visible evidence of completion.</p></div><img src="/assets/img/cert.svg"/></section>}{p.type==='leadership'&&<LeadershipFaces/>}{p.type==='honours'&&<Honours/>}{p.type==='merch'&&<Store/>}<section className="ctaBand"><div><h3>{d.aside}</h3></div><Link to="/circle" className="pill lime">Start here <ArrowUpRight/></Link></section>{['funding','volunteer','honours','circle'].includes(p.type)&&<Application type={p.type}/>}</main></>}
function LeadershipFaces(){return <section className="leadershipFaces">{[['phillipa-aidoo.png','Phillipa Aidoo'],['asaa.jpeg','Asaa Gyebi-Adjei'],['ruby-damenshie-brown.jpg','Ruby Damenshie-Brown'],['h.jpg','Hamza Abubakar']].map(([im,n])=><article key={n}><img src={'/assets/img/team/'+im}/><div><span>WOMATE LEADERSHIP</span><h4>{n}</h4></div></article>)}</section>}
const MERCH_CHECKOUT_URL=import.meta.env.VITE_MERCH_CHECKOUT_URL||'';
const MERCH_ORDER_ENDPOINT=import.meta.env.VITE_MERCH_ORDER_ENDPOINT||'';
const merchProducts=[
 {id:'core-white',name:'Core White',price:60,front:'/assets/img/merch/12.png',back:'/assets/img/merch/15.png',copy:'A clean white WOMATE tee carrying the Women in Climate identity across the chest and the climate-action statement across the back.'},
 {id:'deep-green',name:'Deep Green',price:60,front:'/assets/img/merch/13.png',back:'/assets/img/merch/14.png',copy:'The deep-green WOMATE tee: a stronger field colour with the core identity in front and the climate-action statement behind.'}
];
function MerchandisePage(){
 const [product,setProduct]=useState(merchProducts[0]);
 const [view,setView]=useState('front');
 const [size,setSize]=useState('M');
 const [qty,setQty]=useState(1);
 const [checkoutOpen,setCheckoutOpen]=useState(false);
 const [status,setStatus]=useState('idle');
 const total=product.price*qty;
 const choose=(p)=>{setProduct(p);setView('front');setQty(1)};
 const pay=()=>{
   if(MERCH_CHECKOUT_URL){const u=new URL(MERCH_CHECKOUT_URL,window.location.origin);u.searchParams.set('product',product.name);u.searchParams.set('size',size);u.searchParams.set('quantity',String(qty));u.searchParams.set('amount',String(total));window.open(u.toString(),'_blank','noopener,noreferrer');return}
   setCheckoutOpen(true);
 };
 const submit=async(e)=>{e.preventDefault();const form=new FormData(e.currentTarget);const payload=Object.fromEntries(form.entries());Object.assign(payload,{product:product.name,size,quantity:qty,total});
   if(!MERCH_ORDER_ENDPOINT){const subject=encodeURIComponent('WOMATE Vault order — '+product.name);const body=encodeURIComponent(`Product: ${product.name}\nSize: ${size}\nQuantity: ${qty}\nTotal: GHS ${total}\n\nName: ${payload.name}\nPhone: ${payload.phone}\nDelivery location: ${payload.location}`);window.location.href=`mailto:womatead@gmail.com?subject=${subject}&body=${body}`;setStatus('ready');return}
   try{setStatus('sending');const r=await fetch(MERCH_ORDER_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error();setStatus('sent')}catch{setStatus('error')}
 };
 return <>
  <section className="hero merchHero"><div className="heroTop"><div className="heroCopy"><h1>The Vault.</h1><div className="actions"><button className="pill lime" onClick={()=>document.getElementById('vault-shop')?.scrollIntoView({behavior:'smooth'})}>SHOP THE VAULT</button></div></div><div className="merchHeroStack"><img src="/assets/img/merch/12.png"/><img src="/assets/img/merch/13.png"/></div></div></section>
  <main className="merchPage" id="vault-shop">
   <section className="merchIntro"><span>WOMATE MERCHANDISE</span><div><h2>Wear the work.</h2><p>The Vault carries a small collection of WOMATE objects designed to make the community visible. The first release begins with two signature tees in the organisation’s core colours.</p></div><aside><b>GHS 60</b><small>per T-shirt</small></aside></section>
   <section className="vaultShop">
    <div className="vaultStage"><div className={'vaultImage '+(product.id==='deep-green'?'greenStage':'whiteStage')}><img src={view==='front'?product.front:product.back} alt={`${product.name} WOMATE T-shirt ${view}`}/><span>{view.toUpperCase()}</span></div><div className="vaultViewToggle"><button className={view==='front'?'active':''} onClick={()=>setView('front')}>Front</button><button className={view==='back'?'active':''} onClick={()=>setView('back')}>Back</button></div></div>
    <div className="vaultBuy"><span>THE VAULT · 01</span><h2>WOMATE T-SHIRT</h2><div className="vaultVariants">{merchProducts.map(p=><button key={p.id} className={product.id===p.id?'active':''} onClick={()=>choose(p)}><img src={p.front}/><div><b>{p.name}</b><small>GHS {p.price}</small></div></button>)}</div><p>{product.copy}</p><div className="vaultOption"><label>Size</label><div>{['S','M','L','XL','2XL'].map(x=><button key={x} className={size===x?'active':''} onClick={()=>setSize(x)}>{x}</button>)}</div></div><div className="vaultQty"><label>Quantity</label><div><button onClick={()=>setQty(Math.max(1,qty-1))}>âˆ’</button><strong>{qty}</strong><button onClick={()=>setQty(qty+1)}>+</button></div></div><div className="vaultTotal"><span>Total</span><strong>GHS {total}</strong></div><button className="pill lime vaultCheckout" onClick={pay}>BUY NOW <ArrowUpRight size={17}/></button><small className="vaultNote">Final fulfilment and delivery details are confirmed during checkout.</small></div>
   </section>
   <section className="vaultDetails"><article><span>01</span><h3>Two colours. One statement.</h3><p>Core White and Deep Green carry the same WOMATE identity with contrasting front and back treatments.</p></article><article><span>02</span><h3>Made to represent.</h3><p>For members, alumni, partners and supporters who want to carry the work beyond an event or programme.</p></article><article><span>03</span><h3>Small-batch release.</h3><p>The Vault starts deliberately small. Availability can be managed from your live fulfilment and payment workflow.</p></article></section>
  </main>
  {checkoutOpen&&<div className="vaultModal" role="dialog" aria-modal="true"><button className="vaultModalBackdrop" onClick={()=>setCheckoutOpen(false)} aria-label="Close"/><div className="vaultModalPanel"><div className="vaultModalHead"><div><span>THE VAULT</span><h2>Purchase request</h2></div><button onClick={()=>setCheckoutOpen(false)}><X/></button></div><div className="vaultOrderSummary"><img src={product.front}/><div><b>{product.name}</b><span>Size {size} · Qty {qty}</span><strong>GHS {total}</strong></div></div><form onSubmit={submit}><label>Full name<input name="name" required autoComplete="name"/></label><label>Email address<input name="email" type="email" required autoComplete="email"/></label><label>Phone / WhatsApp number<input name="phone" required autoComplete="tel"/></label><label>Delivery city / location<input name="location" required autoComplete="address-level2"/></label><textarea name="note" placeholder="Order note (optional)"/><button className="pill darkbtn" disabled={status==='sending'}>{status==='sending'?'Sending…':'Continue order'}</button>{status==='sent'&&<small>Order request received.</small>}{status==='ready'&&<small>Your email app has been opened with the order details.</small>}{status==='error'&&<small>Could not send the order. Please try again.</small>}</form></div></div>}
 </>
}
function Store(){return null}
function DonationPage(){
 const donateUrl='https://paystack.shop/pay/donateadollar';
 const impact=[
 ['01','Research','Support women-centred climate research, evidence and knowledge that can shape better decisions.'],
 ['02','Climate','Keep foundational climate learning, community action and practical leadership opportunities accessible.'],
 ['03','Health','Strengthen programmes that connect climate resilience with wellbeing, care and dignity.'],
 ['04','Leadership','Help women access training, mentorship, visibility, professional pathways and opportunities to lead.']
 ];
 return <main className="donatePage">
  <section className="donateHero"><div className="donateHeroCopy"><span>SUPPORT WOMATE</span><h1>Give access. Grow leadership.</h1><p>WOMATE is an organization that equips African women with technology, training and community support to move from climate participation to climate leadership.</p><div className="donateHeroActions"><a className="pill lime" href={donateUrl} target="_blank" rel="noreferrer">Donate now <ArrowUpRight size={17}/></a><a className="donateTextLink" href="#donate-impact">See where your support goes <ChevronRight size={16}/></a></div></div><aside className="donatePromise"><span>EVERY CEDI COUNTS</span><strong>Every cedi goes into supporting women.</strong><p>Your contribution strengthens WOMATE’s research, climate, health and leadership programmes across Africa.</p></aside></section>
  <section className="donateStatement"><span>WHY GIVE</span><h2>Support that keeps access open and turns learning into leadership.</h2></section>
  <section className="donateImpactGrid" id="donate-impact">{impact.map(([n,title,copy])=><article key={n}><b>{n}</b><div><h3>{title}</h3><p>{copy}</p></div></article>)}</section>
  <section className="donateModel"><div><span>HOW WOMATE SUSTAINS ACCESS</span><h2>Free foundations. Affordable advancement. Supported access.</h2></div><div className="donateModelRail"><article><strong>FREE</strong><h3>Foundational learning</h3><p>Core climate literacy and leadership learning can remain free and accessible.</p></article><article><strong>AFFORDABLE</strong><h3>Advanced skills</h3><p>Selected advanced professional courses can carry a small, accessible fee to support sustainable delivery.</p></article><article><strong>SPONSORED</strong><h3>Scholarships & programmes</h3><p>Donations and partners help WOMATE widen access for women who need additional support.</p></article></div></section>
  <section className="donateFinal"><div><span>BACK WOMEN-LED CLIMATE ACTION</span><h2>Help keep the first door open.</h2><p>Support research, climate action, health and leadership programmes designed around women as actors, builders and decision-makers.</p></div><a className="pill lime" href={donateUrl} target="_blank" rel="noreferrer">Make a donation <ArrowUpRight size={17}/></a></section>
 </main>
}

function Application({type}){const[status,setStatus]=useState('idle');return <section className="application"><div><h3>{type==='honours'?'Tell us whose work deserves to be seen.':'Your next step starts here.'}</h3><p>Complete the short form. WOMATE will review your submission and follow up through the contact details you provide.</p></div><form className="premiumForm" onSubmit={e=>submitWomateForm(e,`${type} interest`,setStatus)}><label>Full name<input required name="name" autoComplete="name"/></label><label>Email address<input required name="email" type="email" autoComplete="email"/></label><label>Country<input name="country" autoComplete="country-name"/></label><label>Tell us briefly about your interest<textarea name="message"/></label><button className="pill darkbtn" disabled={status==='sending'}>{status==='sending'?'Sending…':'Submit'} {status!=='sending'&&<ArrowUpRight/>}</button>{status==='success'&&<p role="status">Thank you. Your submission has been sent.</p>}{status==='error'&&<p role="alert">We could not send this. Please try again or email womatead@gmail.com.</p>}</form></section>}

function CircleWhatsAppWidget(){
 const[open,setOpen]=useState(true);
 const[choice,setChoice]=useState('');
 const options=[
  {label:'Join the community',message:'I would like to join the WOMATE Circle community.'},
  {label:'Access support',message:'I need help accessing a WOMATE Circle opportunity or resource.'},
  {label:'Professional enquiry',message:'I am contacting WOMATE about a professional or partnership enquiry.'}
 ];
 const launch=()=>{if(!choice)return;window.open('https://wa.me/233596430557?text='+encodeURIComponent(choice),'_blank','noopener,noreferrer')};
 return <div className={'circleWaShell '+(open?'isOpen':'')}>
 {open?<aside className="circleWaPanel" aria-label="WOMATE Circle Community Admin">
  <div className="circleWaHead"><div className="circleWaAvatar"><img src="/assets/circle/community-admin.png" alt="Community Admin"/></div><div><strong>Community Admin</strong><span>WOMATE Circle · WhatsApp</span></div><button type="button" className="circleWaClose" onClick={()=>setOpen(false)} aria-label="Close">×</button></div>
  <div className="circleWaBody"><span className="circleWaToday">Today</span><div className="circleWaBubble">Hi, welcome to the WOMATE Circle. Please choose the reason you are contacting us.</div><span className="circleWaTime">Community Admin</span></div>
  <div className="circleWaCompose circleWaChoices"><div className="circleWaChoiceList">{options.map((o,i)=><button type="button" key={o.message} className={'circleWaChoice '+(choice===o.message?'active':'')} onClick={()=>setChoice(o.message)}><span>{String(i+1).padStart(2,'0')}</span><strong>{o.label}</strong></button>)}</div><button type="button" className="circleWaStart" disabled={!choice} onClick={launch}>Send on WhatsApp</button></div>
 </aside>:<button type="button" className="circleWaFab" onClick={()=>setOpen(true)} aria-label="Open WhatsApp"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M19.11 17.21c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.19 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/><path fill="currentColor" d="M16.02 3C8.84 3 3 8.82 3 15.98c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.75a13 13 0 0 0 6.33 1.61h.01C23.2 28.86 29 23.04 29 15.88 29 8.72 23.2 3 16.02 3zm0 23.67h-.01a10.8 10.8 0 0 1-5.51-1.51l-.4-.24-3.96 1.04 1.06-3.86-.26-.4a10.75 10.75 0 0 1-1.66-5.72c0-5.93 4.83-10.76 10.77-10.76 5.94 0 10.77 4.83 10.77 10.76 0 5.94-4.85 10.69-10.8 10.69z"/></svg></button>}
 </div>
}

function Footer(){return <footer className="globalFooter"><div className="footerLead"><div className="footerIdentity"><img src="/assets/img/logo.svg" alt="WOMATE"/><h3>Driving inclusive climate action with technology.</h3></div><div className="footerAction"><span>ABOUT WOMATE</span><p>Meet the women-led organisation connecting climate knowledge, technology, research, community and leadership across Africa.</p><Link to="/leadership" className="footerCta">Our organisation <ArrowUpRight size={18}/></Link></div></div><div className="footerDirectory"><div className="footerOffice"><span className="footerLabel">GLOBAL NETWORK</span><strong>Accra, Ghana<br/>Africa · connected globally</strong><a href="mailto:womatead@gmail.com">womatead@gmail.com</a><a href="https://www.linkedin.com/company/womeninclimategh" target="_blank" rel="noreferrer">LinkedIn <ArrowUpRight size={13}/></a></div><div><span className="footerLabel">PROGRAMMES</span><Link to="/she-leads">She Leads</Link><Link to="/wok-action">WoK Action</Link><Link to="/circle">The WOMATE Circle</Link><Link to="/research">Research</Link><Link to="/resilient-minds">Resilient Minds</Link><Link to="/honours">Climate Honours</Link></div><div><span className="footerLabel">ORGANISATION</span><Link to="/leadership">Our organisation</Link><Link to="/funding">Funding support</Link><Link to="/womateer">WOMATEER</Link><Link to="/merchandise">The Vault</Link></div><div><span className="footerLabel">TAKE PART</span><Link to="/donate">Donate</Link><Link to="/circle">Join the community</Link><Link to="/honours">Nominate a leader</Link><Link to="/womateer">Volunteer</Link></div></div><div className="footerBottom"><span>© 2026 WOMATE · Women in Climate</span><div><span>Knowledge</span><span>Technology</span><span>Community</span></div><span>Women leading climate action.</span></div></footer>}
const uiPolish=`
:root{--motion-fast:180ms;--motion-ui:260ms;--motion-scene:420ms;--ease-womate:cubic-bezier(.2,.75,.25,1);--focus:#c6ff52;--field-h:50px}
html{scroll-behavior:smooth}body{overflow-x:hidden}button,a,input,select,textarea{transition:border-color var(--motion-fast) var(--ease-womate),background-color var(--motion-fast) var(--ease-womate),color var(--motion-fast) var(--ease-womate),transform var(--motion-fast) var(--ease-womate),box-shadow var(--motion-fast) var(--ease-womate)}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
button,.pill,.navTrigger,.menu{min-height:44px}.pill:active,button:active{transform:translateY(1px)}
img{max-width:100%}.premiumForm,label{min-width:0}.premiumForm label,.partner form label,.circleInquiry form label,.healInquiry form label,.healNativeGuardian>label:not(.guardianConsent),.leadershipPartner form label,.womateerInquiry form label,.fundingForm form>label:not(.fundingConsent),.vaultModalPanel form label{display:grid;gap:8px;font-size:12px;font-weight:750;letter-spacing:.055em}
input,select,textarea{width:100%;min-height:var(--field-h);font:inherit}textarea{min-height:118px;resize:vertical}
.megaIntro p{display:none}.megaMenu small{line-height:1.35}.megaMenu a{min-height:44px}
.program,.voiceCard,.sheRecruitCard,.circleTier,.healTier{transition:transform var(--motion-ui) var(--ease-womate),box-shadow var(--motion-ui) var(--ease-womate)}
@media(hover:hover){.program:hover,.sheRecruitCard:hover{transform:translateY(-4px)}.voiceCard:hover{transform:translateY(-2px)}}
@media(max-width:768px){.heroTop{min-height:auto}.actions{gap:10px}.actions .pill{min-height:48px}.programGrid,.circleTierGrid,.healTierGrid,.fundingSupportGrid{grid-template-columns:1fr!important}.partner,.researchInquiry,.healInquiry,.leadershipPartner,.womateerInquiry{grid-template-columns:1fr!important}.megaMenu{display:none!important}}
@media(max-width:430px){.heroCopy h1{font-size:clamp(42px,13vw,64px)}.actions{width:100%;align-items:stretch}.actions .pill{width:100%;justify-content:center}.statbar{grid-template-columns:repeat(2,1fr)!important}.footerDirectory{grid-template-columns:1fr!important}.footerBottom{gap:14px;align-items:flex-start!important}}


/* GLOBAL — WoK + Research icon navigation. Kept outside route components so styles render on every page. */
.wokPillars.iconPillarSection,
.researchServices.iconPillarSection{
  padding:clamp(54px,6vw,82px) clamp(18px,5vw,72px) clamp(60px,7vw,92px)!important;
  background:linear-gradient(180deg,#f5f8f6 0%,#fff 100%)!important;
}
.wokPillars.iconPillarSection .iconPillarHead,
.researchServices.iconPillarSection .iconPillarHead{
  display:block!important;width:100%!important;max-width:1100px!important;
  margin:0 auto clamp(28px,4vw,44px)!important;padding:0!important;
  text-align:center!important;grid-template-columns:none!important;
}
.wokPillars.iconPillarSection .iconPillarHead>span,
.researchServices.iconPillarSection .iconPillarHead>span{
  display:block!important;margin:0 0 10px!important;padding:0!important;
  font-family:inherit!important;font-size:10px!important;line-height:1.2!important;
  font-weight:800!important;letter-spacing:.17em!important;text-transform:uppercase!important;color:#6c8b89!important;
}
.wokPillars.iconPillarSection .iconPillarHead h2,
.researchServices.iconPillarSection .iconPillarHead h2{
  display:block!important;margin:0 auto!important;padding:0!important;
  max-width:15ch!important;font-family:inherit!important;
  font-size:clamp(40px,5.1vw,70px)!important;line-height:.98!important;
  letter-spacing:-.048em!important;font-weight:700!important;color:#0e4d4a!important;
  text-wrap:balance!important;
}
.wokPillars.iconPillarSection .iconPillarTray,
.researchServices.iconPillarSection .iconPillarTray{
  width:100%!important;max-width:1240px!important;margin:0 auto!important;
  padding:clamp(18px,2vw,26px)!important;border:1px solid rgba(14,77,74,.08)!important;
  border-radius:34px!important;background:rgba(255,255,255,.82)!important;
  box-shadow:0 20px 60px rgba(6,58,55,.065)!important;backdrop-filter:blur(12px)!important;
}
.wokPillars.iconPillarSection .iconPillarGrid,
.researchServices.iconPillarSection .iconPillarGrid{
  display:grid!important;width:100%!important;gap:10px!important;
}
.wokPillars.iconPillarSection .iconPillarGrid.six{grid-template-columns:repeat(6,minmax(0,1fr))!important}
.researchServices.iconPillarSection .iconPillarGrid.eight{grid-template-columns:repeat(8,minmax(0,1fr))!important}
.wokPillars.iconPillarSection button.iconPillarCard,
.researchServices.iconPillarSection button.iconPillarCard{
  appearance:none!important;-webkit-appearance:none!important;
  position:relative!important;min-width:0!important;width:100%!important;min-height:150px!important;
  margin:0!important;padding:18px 10px 16px!important;border:0!important;outline:0!important;
  border-radius:24px!important;background:transparent!important;color:#0e4d4a!important;
  box-shadow:none!important;cursor:pointer!important;display:flex!important;flex-direction:column!important;
  align-items:center!important;justify-content:center!important;gap:13px!important;text-align:center!important;
  font:inherit!important;line-height:1!important;overflow:visible!important;
}
.wokPillars.iconPillarSection button.iconPillarCard:hover,
.wokPillars.iconPillarSection button.iconPillarCard:focus-visible,
.researchServices.iconPillarSection button.iconPillarCard:hover,
.researchServices.iconPillarSection button.iconPillarCard:focus-visible{
  transform:translateY(-3px)!important;background:rgba(14,77,74,.035)!important;box-shadow:none!important;
}
.wokPillars.iconPillarSection .iconPillarNo,
.researchServices.iconPillarSection .iconPillarNo{
  position:absolute!important;top:12px!important;left:14px!important;display:block!important;
  font-size:9px!important;line-height:1!important;font-weight:850!important;letter-spacing:.15em!important;color:#77918f!important;
}
.wokPillars.iconPillarSection .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarGlyph{
  width:70px!important;height:70px!important;flex:0 0 70px!important;border-radius:22px!important;
  display:grid!important;place-items:center!important;background:#edf5f1!important;color:#0e4d4a!important;
  box-shadow:0 10px 28px rgba(6,58,55,.07)!important;
}
.wokPillars.iconPillarSection .iconPillarCard:nth-child(2) .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarCard:nth-child(2) .iconPillarGlyph{background:#f1edf8!important}
.wokPillars.iconPillarSection .iconPillarCard:nth-child(3) .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarCard:nth-child(3) .iconPillarGlyph{background:#eaf4ec!important}
.wokPillars.iconPillarSection .iconPillarCard:nth-child(4) .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarCard:nth-child(4) .iconPillarGlyph{background:#f7efe4!important}
.wokPillars.iconPillarSection .iconPillarCard:nth-child(5) .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarCard:nth-child(5) .iconPillarGlyph{background:#e8f2f2!important}
.wokPillars.iconPillarSection .iconPillarCard:nth-child(6) .iconPillarGlyph,
.researchServices.iconPillarSection .iconPillarCard:nth-child(6) .iconPillarGlyph{background:#eff6df!important}
.wokPillars.iconPillarSection button.iconPillarCard:hover .iconPillarGlyph,
.wokPillars.iconPillarSection button.iconPillarCard:focus-visible .iconPillarGlyph,
.researchServices.iconPillarSection button.iconPillarCard:hover .iconPillarGlyph,
.researchServices.iconPillarSection button.iconPillarCard:focus-visible .iconPillarGlyph{
  transform:scale(1.06)!important;background:#c6ff52!important;box-shadow:0 14px 32px rgba(6,58,55,.12)!important;
}
.wokPillars.iconPillarSection button.iconPillarCard strong,
.researchServices.iconPillarSection button.iconPillarCard strong{
  display:block!important;margin:0!important;padding:0!important;max-width:13ch!important;
  font-family:inherit!important;font-size:14px!important;line-height:1.08!important;font-weight:700!important;
  letter-spacing:-.02em!important;color:#0e4d4a!important;
}
.wokPillars.iconPillarSection .iconPillarHint,
.researchServices.iconPillarSection .iconPillarHint{
  display:block!important;margin:18px auto 0!important;padding:0!important;text-align:center!important;
  font-size:10px!important;line-height:1.2!important;font-weight:600!important;letter-spacing:.13em!important;
  text-transform:uppercase!important;color:#78918f!important;
}
.iconPillarModal{position:fixed!important;inset:0!important;z-index:9999!important;display:grid!important;place-items:center!important;padding:18px!important}
.iconPillarBackdrop{position:absolute!important;inset:0!important;border:0!important;background:rgba(2,30,29,.78)!important;backdrop-filter:blur(12px)!important}
.iconPillarDialog{position:relative!important;z-index:1!important;width:min(700px,94vw)!important;padding:clamp(32px,5vw,58px)!important;border-radius:32px!important;background:#083f3e!important;color:#fff!important;box-shadow:0 36px 100px rgba(0,0,0,.4)!important;border:1px solid rgba(198,255,82,.18)!important}
.iconPillarDialog:before{content:'';position:absolute;left:0;top:36px;width:5px;height:68px;border-radius:0 5px 5px 0;background:#c6ff52}
.iconPillarDialog>button{position:absolute!important;top:16px!important;right:16px!important;width:42px!important;height:42px!important;min-height:42px!important;padding:0!important;border-radius:50%!important;border:1px solid rgba(255,255,255,.16)!important;background:rgba(255,255,255,.07)!important;color:#fff!important;display:grid!important;place-items:center!important}
.iconPillarDialogIcon{width:58px!important;height:58px!important;border-radius:18px!important;display:grid!important;place-items:center!important;background:#c6ff52!important;color:#083f3e!important;margin-bottom:22px!important}
.iconPillarDialog>span{font-size:11px!important;font-weight:850!important;letter-spacing:.16em!important;color:#c6ff52!important}
.iconPillarDialog h3{margin:14px 46px 18px 0!important;font-size:clamp(34px,6vw,58px)!important;line-height:.96!important;letter-spacing:-.045em!important;max-width:14ch!important;color:#fff!important}
.iconPillarDialog p{margin:0!important;max-width:54ch!important;font-size:clamp(15px,1.6vw,18px)!important;line-height:1.7!important;color:rgba(255,255,255,.82)!important}
.iconPillarDialogTags{display:flex!important;flex-wrap:wrap!important;gap:8px!important;margin-top:24px!important}
.iconPillarDialogTags span{padding:8px 11px!important;border-radius:999px!important;background:rgba(255,255,255,.08)!important;border:1px solid rgba(255,255,255,.12)!important;color:#fff!important;font-size:11px!important;letter-spacing:.02em!important}
@media(max-width:1100px){
 .wokPillars.iconPillarSection .iconPillarGrid.six,
 .researchServices.iconPillarSection .iconPillarGrid.eight{grid-template-columns:repeat(4,minmax(0,1fr))!important}
}
@media(max-width:760px){
 .wokPillars.iconPillarSection,.researchServices.iconPillarSection{padding:46px 16px 58px!important}
 .wokPillars.iconPillarSection .iconPillarHead,.researchServices.iconPillarSection .iconPillarHead{text-align:left!important;margin-bottom:24px!important}
 .wokPillars.iconPillarSection .iconPillarHead h2,.researchServices.iconPillarSection .iconPillarHead h2{margin-left:0!important;font-size:clamp(34px,9vw,48px)!important;max-width:16ch!important}
 .wokPillars.iconPillarSection .iconPillarTray,.researchServices.iconPillarSection .iconPillarTray{padding:11px!important;border-radius:25px!important}
 .wokPillars.iconPillarSection .iconPillarGrid.six,.researchServices.iconPillarSection .iconPillarGrid.eight{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:5px!important}
 .wokPillars.iconPillarSection button.iconPillarCard,.researchServices.iconPillarSection button.iconPillarCard{min-height:116px!important;border-radius:18px!important;padding:15px 8px 12px!important}
 .wokPillars.iconPillarSection .iconPillarGlyph,.researchServices.iconPillarSection .iconPillarGlyph{width:56px!important;height:56px!important;flex-basis:56px!important;border-radius:17px!important}
 .wokPillars.iconPillarSection button.iconPillarCard strong,.researchServices.iconPillarSection button.iconPillarCard strong{font-size:12px!important}
 .iconPillarDialog{border-radius:24px!important;padding:28px 22px 30px!important}
}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.voiceTrack{animation:none!important}}
`;
function UIPolish(){return <style>{uiPolish}</style>}


const deepRepairStyles=`
@media(max-width:900px){
.mobileNavCategorised{position:fixed!important;inset:0!important;z-index:9998!important;background:#f8faf8!important;padding:18px 20px 28px!important;overflow-y:auto!important;display:block!important}
.mobileNavTop{display:flex;align-items:center;justify-content:space-between;padding:4px 0 18px;border-bottom:1px solid rgba(14,77,74,.13)}
.mobileNavTop>span{font-size:10px;font-weight:850;letter-spacing:.16em;color:#6d8886}
.mobileNavTop button{width:38px;height:38px;border:1px solid rgba(14,77,74,.14);border-radius:50%;background:#fff;color:#0e4d4a;display:grid;place-items:center}
.mobileNavGroup{padding:20px 0 10px;border-bottom:1px solid rgba(14,77,74,.11)}
.mobileNavLabel{display:block;margin:0 0 8px;font-size:9px;font-weight:850;letter-spacing:.16em;color:#819694}
.mobileNavGroup a{display:flex!important;align-items:center!important;justify-content:space-between!important;padding:10px 0!important;border:0!important;font-size:17px!important;font-weight:700!important;letter-spacing:-.02em!important;color:#0e4d4a!important;text-decoration:none!important}
.mobileNavGroup a svg{opacity:.45}.mobileDonate{display:flex!important;align-items:center!important;justify-content:space-between!important;margin-top:22px!important;padding:15px 18px!important;border-radius:999px!important;background:#c6ff52!important;color:#0e4d4a!important;font-weight:850!important;text-decoration:none!important}
}
.donatePage{background:#f6f5ef;color:#103f3c;min-height:70vh}
.donateHero{min-height:76vh;padding:clamp(120px,14vw,190px) clamp(24px,6vw,96px) 80px;background:#0E4D4A;color:#fff;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);gap:clamp(44px,8vw,120px);align-items:end}
.donateHeroCopy{max-width:850px}.donateHeroCopy>span,.donatePromise>span,.donateStatement>span,.donateModel>div>span,.donateFinal span{font-size:11px;letter-spacing:.18em;font-weight:800}
.donateHero h1{font-size:clamp(48px,7vw,102px);line-height:.94;letter-spacing:-.055em;margin:18px 0 28px;max-width:980px}.donateHeroCopy>p{font-size:clamp(18px,2vw,24px);line-height:1.55;max-width:760px;color:rgba(255,255,255,.82)}
.donateHeroActions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:34px}.donateTextLink{color:#fff;display:inline-flex;align-items:center;gap:5px;font-weight:750;text-decoration:none}
.donatePromise{border-top:1px solid rgba(255,255,255,.45);padding-top:22px}.donatePromise strong{font-size:clamp(28px,3vw,43px);line-height:1.08;display:block;margin:18px 0}.donatePromise p{color:rgba(255,255,255,.72);line-height:1.65}
.donateStatement{padding:100px clamp(24px,6vw,96px) 58px;display:grid;grid-template-columns:.45fr 1.55fr;gap:40px}.donateStatement h2{font-size:clamp(38px,5vw,72px);line-height:1.02;letter-spacing:-.045em;margin:0;max-width:1050px}
.donateImpactGrid{padding:0 clamp(24px,6vw,96px) 110px;display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid rgba(14,77,74,.18)}.donateImpactGrid article{display:grid;grid-template-columns:60px 1fr;gap:22px;padding:38px 26px 38px 0;border-bottom:1px solid rgba(14,77,74,.18)}.donateImpactGrid article:nth-child(odd){border-right:1px solid rgba(14,77,74,.18)}.donateImpactGrid article:nth-child(even){padding-left:32px}.donateImpactGrid h3{font-size:clamp(24px,2.4vw,36px);margin:0 0 12px}.donateImpactGrid p{margin:0;line-height:1.7;color:#466b68}
.donateModel{padding:110px clamp(24px,6vw,96px);background:#C6FF52;display:grid;grid-template-columns:.7fr 1.3fr;gap:70px}.donateModel h2{font-size:clamp(40px,5vw,72px);line-height:1;letter-spacing:-.045em;margin:18px 0 0}.donateModelRail{border-top:1px solid rgba(14,77,74,.35)}.donateModelRail article{display:grid;grid-template-columns:100px 1fr 1fr;gap:20px;padding:24px 0;border-bottom:1px solid rgba(14,77,74,.35)}.donateModelRail h3{margin:0}.donateModelRail p{margin:0;color:#315c58}
.donateFinal{padding:90px clamp(24px,6vw,96px);background:#072f2d;color:#fff;display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:end}.donateFinal h2{font-size:clamp(48px,6vw,86px);line-height:.98;letter-spacing:-.05em;margin:14px 0 18px}.donateFinal p{color:rgba(255,255,255,.72);font-size:18px}
@media(max-width:850px){.donateHero,.donateStatement,.donateModel,.donateFinal{grid-template-columns:1fr}.donateImpactGrid{grid-template-columns:1fr}.donateImpactGrid article:nth-child(odd){border-right:0}.donateImpactGrid article:nth-child(even){padding-left:0}.donateModelRail article{grid-template-columns:80px 1fr}.donateModelRail p{grid-column:2}}
`;
function DeepRepairStyles(){return <style>{deepRepairStyles}</style>}
function App(){
let path=window.location.pathname.replace(/\/$/,'')||'/';
let p=pages[path]||pages['/'];
useEffect(()=>{window.scrollTo(0,0);},[]);
if(path==='/canopy'||path.startsWith('/canopy/'))return <CanopyApp/>;
return <>
<PageSEO path={path}/><UIPolish/><DeepRepairStyles/>
<Header/>
{p.type==='home'?<Home/>:p.type==='she'?<SheLeads/>:p.type==='wok'?<WokAction/>:p.type==='research'?<ResearchPage/>:p.type==='circle'?<CirclePage/>:p.type==='minds'?<ResilientMinds/>:p.type==='honours'?<HonoursPage/>:p.type==='leadership'?<LeadershipPage/>:p.type==='volunteer'?<WomateerPage/>:p.type==='merch'?<MerchandisePage/>:p.type==='funding'?<FundingPage/>:p.type==='donate'?<DonationPage/>:<Standard p={p}/>}
<Footer/>
</>
}

createRoot(document.getElementById('root')).render(
<React.StrictMode>
<HelmetProvider>
<App/>
</HelmetProvider>
</React.StrictMode>
);






