:root{--canopy:#0e4d4a;--canopy-2:#0a3836;--canopy-lime:#c6ff52;--canopy-ink:#102322;--canopy-muted:#667b77;--canopy-line:#dce7e3;--canopy-soft:#f3f7f4;--canopy-white:#fff}
*{box-sizing:border-box}.canopyPublic,.canopyAuth,.canopyApp,.canopyLoading{font-family:Manrope,system-ui,sans-serif;color:var(--canopy-ink)}button,input,textarea{font:inherit}.canopyPublic button,.canopyAuth button,.canopyApp button{cursor:pointer}.canopyBrand{border:0;background:transparent;display:flex;align-items:center;gap:10px;padding:0;color:var(--canopy);text-align:left}.canopyMark{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--canopy);color:var(--canopy-lime)}.canopyBrand>span:last-child{display:grid;line-height:1}.canopyBrand b{font-size:17px;letter-spacing:.08em}.canopyBrand small{font-size:10px;letter-spacing:.16em;margin-top:4px}.canopyPublicTop{height:76px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,5vw,76px);border-bottom:1px solid var(--canopy-line);background:#fff}.canopyTextBtn{border:0;background:transparent;color:var(--canopy);font-weight:800;display:inline-flex;gap:7px;align-items:center}.canopyLandingHero{min-height:560px;padding:clamp(56px,7vw,100px) clamp(20px,6vw,90px);display:grid;grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr);align-items:center;gap:50px;background:linear-gradient(135deg,#fff 0%,#f5faf5 72%,#edf7e8 100%);overflow:hidden}.canopyHeroCopy{max-width:720px}.canopyEyebrow{font-size:12px;letter-spacing:.14em;font-weight:900;color:var(--canopy);display:block;margin-bottom:15px}.canopyHeroCopy h1{font-size:clamp(44px,6vw,80px);line-height:.98;letter-spacing:-.055em;margin:0 0 24px;max-width:800px}.canopyHeroCopy p{font-size:18px;line-height:1.7;color:#405955;max-width:650px}.canopyActions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.canopyPrimary,.canopySecondary{min-height:48px;border-radius:999px;padding:0 20px;font-weight:900;display:inline-flex;align-items:center;justify-content:center;gap:9px;border:1px solid transparent}.canopyPrimary{background:var(--canopy-lime);color:var(--canopy-2)}.canopySecondary{background:#fff;border-color:#bfd0cb;color:var(--canopy)}.canopyPrimary.full{width:100%}.canopyHeroVisual{min-height:400px;position:relative;display:grid;place-items:center}.canopyRings{position:absolute;inset:-20%;display:grid;place-items:center}.canopyRings span{grid-area:1/1;width:85%;aspect-ratio:1;border:1px solid rgba(14,77,74,.13);border-radius:50%}.canopyRings span:nth-child(2){width:62%;border-color:rgba(14,77,74,.22)}.canopyRings span:nth-child(3){width:39%;background:var(--canopy-lime);border:0;opacity:.7}.canopyHeroCard{position:relative;width:min(390px,90%);padding:36px;border-radius:28px;background:var(--canopy);color:#fff;box-shadow:0 26px 70px rgba(14,77,74,.16);display:grid;gap:18px}.canopyHeroCard small{letter-spacing:.16em;color:var(--canopy-lime);font-weight:900}.canopyHeroCard b{font-size:42px;letter-spacing:-.04em}.canopyHeroCard strong{font-size:21px;line-height:1.3;font-weight:650}.canopyHeroCard div{display:flex;gap:10px;flex-wrap:wrap}.canopyHeroCard div span{padding:7px 10px;border:1px solid rgba(255,255,255,.25);border-radius:999px;font-size:12px}.canopyCourseIntro{padding:90px clamp(20px,6vw,90px) 48px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end}.canopyCourseIntro h2,.canopyHow h2{font-size:clamp(32px,4vw,52px);line-height:1.05;letter-spacing:-.04em;margin:0 0 16px;max-width:800px}.canopyCourseIntro p{max-width:780px;color:var(--canopy-muted);font-size:17px;line-height:1.7}.canopyMeta{display:flex;gap:8px;flex-wrap:wrap}.canopyMeta span{padding:8px 11px;border-radius:999px;background:#eef5f1;color:var(--canopy);font-size:12px;font-weight:800}.canopyModulePreview{padding:0 clamp(20px,6vw,90px) 90px}.canopyModulePreview article{display:grid;grid-template-columns:52px minmax(0,1fr) 32px;gap:18px;align-items:center;padding:24px 0;border-top:1px solid var(--canopy-line)}.canopyModulePreview>article>span{font-weight:900;color:var(--canopy)}.canopyModulePreview small{color:var(--canopy-muted);font-size:12px}.canopyModulePreview h3{margin:5px 0;font-size:21px}.canopyModulePreview p{margin:0;color:var(--canopy-muted)}.canopyHow{padding:80px clamp(20px,6vw,90px);background:var(--canopy);color:#fff}.canopyHow .canopyEyebrow{color:var(--canopy-lime)}.canopyHowGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:45px;background:rgba(255,255,255,.16)}.canopyHowGrid article{background:var(--canopy);padding:30px}.canopyHowGrid svg{color:var(--canopy-lime)}.canopyHowGrid h3{font-size:22px;margin:22px 0 8px}.canopyHowGrid p{color:#bdd0cb;line-height:1.6}.canopyPublicFooter{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:28px clamp(20px,6vw,90px);font-size:12px;font-weight:800;letter-spacing:.04em}
.canopyAuth{min-height:720px;display:grid;grid-template-columns:minmax(320px,.9fr) minmax(430px,1.1fr);background:#fff}.canopyAuth>aside{padding:60px clamp(32px,5vw,76px);background:var(--canopy);color:#fff;display:flex;flex-direction:column;justify-content:space-between;gap:60px}.canopyAuth>aside .canopyBrand{color:#fff}.canopyAuth>aside .canopyMark{background:var(--canopy-lime);color:var(--canopy)}.canopyAuth>aside .canopyEyebrow{color:var(--canopy-lime)}.canopyAuth>aside h1{font-size:clamp(40px,5vw,68px);letter-spacing:-.05em;line-height:1;margin:0 0 20px}.canopyAuth>aside p{color:#c4d7d2;line-height:1.7;max-width:520px}.canopyAuth blockquote{margin:0;border-top:1px solid rgba(255,255,255,.22);padding-top:22px;color:var(--canopy-lime);font-size:12px;letter-spacing:.12em;font-weight:900}.canopyAuth>main{padding:45px clamp(28px,7vw,110px);display:flex;flex-direction:column}.canopyBack{border:0;background:transparent;display:inline-flex;align-items:center;gap:8px;color:var(--canopy);font-weight:800;align-self:flex-start}.canopyAuth form{width:min(520px,100%);margin:auto}.canopyAuthHead h2{font-size:42px;letter-spacing:-.04em;margin:6px 0 25px}.canopyAuth label,.canopyModalPanel label{display:grid;gap:8px;font-size:13px;font-weight:800;margin:14px 0}.canopyAuth input,.canopyModalPanel textarea{width:100%;border:1px solid #cbd9d5;border-radius:12px;padding:14px 15px;outline:none;background:#fff;color:var(--canopy-ink)}.canopyAuth input:focus,.canopyModalPanel textarea:focus{border-color:var(--canopy);box-shadow:0 0 0 3px rgba(14,77,74,.08)}.canopySwitch,.canopyFormMsg,.canopyConfigWarn{font-size:13px;line-height:1.55}.canopySwitch button{border:0;background:transparent;color:var(--canopy);font-weight:900}.canopyConfigWarn{padding:12px;border-radius:10px;background:#fff5d8;color:#745600}.canopyFormMsg{color:var(--canopy);font-weight:700}
.canopyApp{min-height:100vh;background:#f7f9f8;display:grid;grid-template-columns:254px minmax(0,1fr)}.canopySidebar{background:#fff;border-right:1px solid var(--canopy-line);padding:24px 18px;display:flex;flex-direction:column;min-height:100vh;position:sticky;top:0;height:100vh}.canopySideTop{display:flex;align-items:center;justify-content:space-between}.canopySideClose,.canopyMenu{display:none}.canopySidebar nav{display:grid;gap:5px;margin-top:42px}.canopySidebar nav button{min-height:46px;border:0;background:transparent;border-radius:12px;display:flex;align-items:center;gap:12px;padding:0 13px;color:#5c716d;font-weight:800;text-align:left}.canopySidebar nav button.active{background:#edf5f1;color:var(--canopy)}.canopySidebar nav button:hover{background:#f3f7f4}.canopySideBottom{margin-top:auto;border-top:1px solid var(--canopy-line);padding-top:20px;display:grid;gap:4px}.canopySideBottom small{font-size:10px;color:var(--canopy-muted)}.canopySideBottom b{font-size:12px}.canopyMain{min-width:0}.canopyAppTop{height:72px;background:#fff;border-bottom:1px solid var(--canopy-line);display:flex;align-items:center;justify-content:flex-end;padding:0 32px;gap:24px;position:sticky;top:0;z-index:20}.canopyAppTop>div{display:grid;text-align:right}.canopyAppTop span{font-size:11px;color:var(--canopy-muted)}.canopyAppTop b{font-size:13px}.canopySignout{border:1px solid var(--canopy-line);background:#fff;display:inline-flex;align-items:center;gap:7px;border-radius:999px;padding:9px 12px;color:var(--canopy)}.canopyDashboard,.canopyCoursePage,.canopyLesson,.canopyQuiz,.canopyAssignments,.canopyProgressPage,.canopyResources,.canopyProfile,.canopyManager{padding:clamp(24px,4vw,54px);max-width:1320px;margin:0 auto}.canopyWelcome{display:flex;align-items:end;justify-content:space-between;gap:30px;background:var(--canopy);color:#fff;padding:clamp(28px,4vw,52px);border-radius:28px}.canopyWelcome .canopyEyebrow{color:var(--canopy-lime)}.canopyWelcome h1{font-size:clamp(36px,5vw,60px);letter-spacing:-.05em;margin:0 0 10px}.canopyWelcome p{color:#c8dad5;max-width:640px;line-height:1.6}.canopyProgressRing{width:126px;height:126px;border-radius:50%;background:conic-gradient(var(--canopy-lime) var(--p),rgba(255,255,255,.14) 0);display:grid;place-items:center;flex:0 0 auto}.canopyProgressRing>div{width:100px;height:100px;border-radius:50%;background:var(--canopy);display:grid;place-content:center;text-align:center}.canopyProgressRing strong{font-size:27px}.canopyProgressRing span{font-size:11px;color:#c8dad5}.canopyContinue{margin-top:24px;padding:27px 30px;background:#fff;border:1px solid var(--canopy-line);border-radius:20px;display:flex;align-items:center;justify-content:space-between;gap:20px}.canopyContinue span,.canopyDashGrid small,.canopyCourseStat span,.canopySubmitted{font-size:11px;font-weight:900;letter-spacing:.08em;color:var(--canopy)}.canopyContinue h2{font-size:27px;margin:7px 0 3px}.canopyContinue p{margin:0;color:var(--canopy-muted)}.canopyDashGrid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px;margin-top:20px}.canopyDashGrid article{background:#fff;border:1px solid var(--canopy-line);border-radius:20px;padding:28px}.canopyDashGrid h3{font-size:24px;margin:9px 0 18px}.canopyDashGrid article>button{margin-top:24px;border:0;background:transparent;color:var(--canopy);font-weight:900;display:flex;gap:7px}.canopyLine{height:7px;background:#e7efeb;border-radius:999px;overflow:hidden;margin:16px 0}.canopyLine span{display:block;height:100%;background:var(--canopy-lime);border-radius:999px}.canopyLockedState{margin-top:24px;background:#fff;border:1px solid var(--canopy-line);border-radius:20px;padding:30px;display:flex;gap:20px;align-items:flex-start}.canopyLockedState svg{color:var(--canopy)}
.canopyCourseHero{background:#fff;border:1px solid var(--canopy-line);border-radius:26px;padding:clamp(30px,5vw,58px);display:grid;grid-template-columns:1fr auto;gap:40px}.canopyCourseHero h1,.canopyPageHead h1,.canopyQuiz h1{font-size:clamp(38px,5vw,62px);line-height:1;letter-spacing:-.05em;margin:0 0 18px}.canopyCourseHero p,.canopyPageHead p,.canopyQuiz section>p{color:var(--canopy-muted);font-size:16px;line-height:1.65;max-width:780px}.canopyCourseStat{display:grid;grid-template-columns:auto auto;gap:7px 10px;align-content:center}.canopyCourseStat strong{font-size:36px;color:var(--canopy)}.canopyCurriculum{margin-top:40px}.canopySectionHead h2{font-size:34px;margin:7px 0 20px}.canopySectionHead span{font-size:11px;font-weight:900;color:var(--canopy);letter-spacing:.12em}.canopyCurriculum article{border-top:1px solid var(--canopy-line)}.canopyModuleRow{width:100%;border:0;background:transparent;display:grid;grid-template-columns:54px minmax(0,1fr) 42px;gap:18px;text-align:left;padding:25px 0;align-items:center}.canopyModuleNo{font-size:16px;color:var(--canopy);font-weight:900}.canopyModuleRow small{color:var(--canopy-muted)}.canopyModuleRow h3{font-size:23px;margin:4px 0}.canopyModuleRow p{margin:0 0 9px;color:var(--canopy-muted)}.canopyModuleRow div>span{font-size:11px;font-weight:800;color:var(--canopy)}.canopyModuleArrow{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--canopy-line);border-radius:50%;color:var(--canopy)}
.canopyLessonCrumb{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}.canopyLessonCrumb button{border:0;background:transparent;color:var(--canopy);display:flex;align-items:center;gap:7px;font-weight:900}.canopyLessonCrumb>span{font-size:12px;color:var(--canopy-muted)}.canopyLessonLayout{display:grid;grid-template-columns:270px minmax(0,780px);gap:40px;justify-content:center}.canopyLessonLayout>aside{position:sticky;top:100px;align-self:start;background:#fff;border:1px solid var(--canopy-line);border-radius:18px;padding:20px}.canopyLessonLayout>aside>span{font-size:11px;color:var(--canopy);font-weight:900}.canopyLessonLayout>aside h2{font-size:20px;margin:7px 0 18px}.canopyLessonLayout>aside>div{display:grid;gap:5px}.canopyLessonLayout>aside button{border:0;background:transparent;border-radius:10px;padding:9px;display:flex;gap:9px;align-items:center;text-align:left;color:#627570}.canopyLessonLayout>aside button.active{background:#eef5f1;color:var(--canopy)}.canopyLessonLayout>aside button>span{width:25px;height:25px;border:1px solid var(--canopy-line);border-radius:50%;display:grid;place-items:center;font-size:11px;flex:0 0 auto}.canopyLessonLayout>aside button svg{width:14px}.canopyLessonLayout>article{background:#fff;border:1px solid var(--canopy-line);border-radius:22px;padding:clamp(24px,4vw,48px)}.canopyLessonLayout>article header small{font-size:11px;color:var(--canopy);font-weight:900;letter-spacing:.09em}.canopyLessonLayout>article h1{font-size:clamp(35px,5vw,54px);letter-spacing:-.05em;line-height:1;margin:10px 0 26px}.canopyVideo,.canopyVideoPlaceholder{margin:0 0 32px;border-radius:16px;overflow:hidden;background:#0b2423}.canopyVideo{aspect-ratio:16/9}.canopyVideo iframe{width:100%;height:100%;border:0}.canopyVideoPlaceholder{min-height:210px;color:#fff;display:flex;align-items:center;justify-content:center;gap:18px;padding:28px;text-align:left}.canopyVideoPlaceholder svg{color:var(--canopy-lime);width:42px;height:42px}.canopyVideoPlaceholder div{display:grid;gap:5px}.canopyVideoPlaceholder span{color:#b9ceca;font-size:13px;max-width:390px}.canopyLessonBody p{font-size:17px;line-height:1.8;color:#304a46}.canopyTakeaway{margin-top:30px;border-left:4px solid var(--canopy-lime);background:#f4f8f5;padding:20px;display:flex;gap:14px}.canopyTakeaway svg{color:var(--canopy)}.canopyTakeaway span{font-size:10px;font-weight:900;letter-spacing:.1em;color:var(--canopy)}.canopyTakeaway p{margin:5px 0 0;font-size:15px;line-height:1.55}.canopyLessonLayout>article footer{display:flex;justify-content:space-between;gap:12px;margin-top:35px;padding-top:25px;border-top:1px solid var(--canopy-line)}
.canopyQuiz>section{max-width:820px;margin:30px auto;background:#fff;border:1px solid var(--canopy-line);border-radius:24px;padding:clamp(28px,5vw,54px)}.canopyQuiz fieldset{border:0;border-top:1px solid var(--canopy-line);padding:26px 0;margin:0}.canopyQuiz legend{font-weight:900;font-size:17px;margin-bottom:14px}.canopyQuiz fieldset label{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:10px}.canopyQuiz fieldset label:hover{background:#f4f8f5}.canopyQuiz input{margin-top:4px}.canopyQuizResult{display:flex;gap:20px;align-items:center;margin-top:25px;padding:22px;background:#eef6f2;border-radius:16px}.canopyQuizResult>strong{font-size:38px;color:var(--canopy)}.canopyQuizResult h3{margin:0 0 5px}.canopyQuizResult p{margin:0 0 7px;color:var(--canopy-muted)}
.canopyPageHead{margin-bottom:30px}.canopyAssignments>section,.canopyResources>section{display:grid;gap:10px}.canopyAssignments>section>article{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:18px;padding:24px;background:#fff;border:1px solid var(--canopy-line);border-radius:16px;align-items:center}.canopyAssignments article>span{color:var(--canopy);font-weight:900}.canopyAssignments h3{margin:5px 0 8px}.canopyAssignments p{margin:0;color:var(--canopy-muted);line-height:1.55}.canopySubmitted{display:inline-flex;gap:5px;align-items:center;margin-top:10px}.canopySubmitted svg{width:14px}.canopyModal{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px}.canopyModalBack{position:absolute;inset:0;border:0;background:rgba(6,29,27,.65)}.canopyModalPanel{position:relative;width:min(720px,100%);max-height:88vh;overflow:auto;background:#fff;border-radius:20px;padding:28px;z-index:1}.canopyModalPanel header{display:flex;justify-content:space-between;gap:20px}.canopyModalPanel header button{border:0;background:#eef5f1;border-radius:50%;width:38px;height:38px}.canopyModalPanel h2{margin:4px 0 12px}.canopyModalPanel>p{color:var(--canopy-muted);line-height:1.6}.canopyModalPanel textarea{min-height:260px;resize:vertical}.canopyProgressHero,.canopyManagerStats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.canopyProgressHero>div,.canopyManagerStats article{background:var(--canopy);color:#fff;border-radius:18px;padding:26px;display:grid}.canopyProgressHero strong,.canopyManagerStats strong{font-size:35px;color:var(--canopy-lime)}.canopyProgressHero span,.canopyManagerStats span{font-size:12px}.canopyProgressModules{margin-top:25px;display:grid;gap:10px}.canopyProgressModules article{display:grid;grid-template-columns:40px minmax(0,1fr) 60px;gap:15px;align-items:center;background:#fff;border:1px solid var(--canopy-line);border-radius:14px;padding:20px}.canopyProgressModules article>span,.canopyProgressModules article>strong{color:var(--canopy);font-weight:900}.canopyProgressModules h3{margin:0}.canopyProgressModules small{color:var(--canopy-muted)}.canopyResources a{display:grid;grid-template-columns:40px minmax(0,1fr) 30px;gap:15px;align-items:center;background:#fff;border:1px solid var(--canopy-line);border-radius:14px;padding:20px;text-decoration:none;color:var(--canopy-ink)}.canopyResources a>svg{color:var(--canopy)}.canopyResources h3{margin:4px 0}.canopyResources small{color:var(--canopy-muted)}.canopyProfile>section{max-width:760px;background:#fff;border:1px solid var(--canopy-line);border-radius:18px;overflow:hidden}.canopyProfile>section>div{display:grid;grid-template-columns:180px 1fr;gap:20px;padding:20px 24px;border-bottom:1px solid var(--canopy-line)}.canopyProfile small{color:var(--canopy-muted)}.canopyManagerStats{grid-template-columns:repeat(4,1fr)}.canopyManagerTable{margin-top:24px;background:#fff;border:1px solid var(--canopy-line);border-radius:16px;overflow:hidden}.canopyManagerTable header,.canopyManagerTable>div{display:grid;grid-template-columns:1.6fr 1fr .7fr .7fr;gap:15px;padding:15px 18px}.canopyManagerTable header{background:#eef5f1;color:var(--canopy);font-size:12px}.canopyManagerTable>div{border-top:1px solid var(--canopy-line);font-size:13px}.canopyLoading{min-height:600px;display:grid;place-content:center;text-align:center;gap:12px;color:var(--canopy)}.canopyLoading svg{margin:auto;color:var(--canopy-lime);fill:var(--canopy)}
@media(max-width:900px){.canopyLandingHero{grid-template-columns:1fr}.canopyHeroVisual{min-height:340px}.canopyCourseIntro{grid-template-columns:1fr}.canopyHowGrid{grid-template-columns:1fr 1fr}.canopyAuth{grid-template-columns:1fr}.canopyAuth>aside{min-height:360px}.canopyApp{display:block}.canopySidebar{position:fixed;z-index:60;left:0;top:0;transform:translateX(-105%);transition:.2s ease;width:min(300px,88vw)}.canopySidebar.open{transform:translateX(0);box-shadow:30px 0 70px rgba(0,0,0,.16)}.canopySideClose,.canopyMenu{display:grid;place-items:center;border:0;background:transparent}.canopyAppTop{justify-content:space-between;padding:0 18px}.canopyAppTop>div{margin-left:auto}.canopyLessonLayout{grid-template-columns:1fr}.canopyLessonLayout>aside{position:static}.canopyProgressHero,.canopyManagerStats{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.canopyPublicTop{height:68px}.canopyPublicTop .canopyTextBtn{font-size:12px}.canopyLandingHero{padding-top:46px}.canopyHeroVisual{min-height:300px}.canopyHeroCard{padding:28px}.canopyHeroCard b{font-size:35px}.canopyHowGrid{grid-template-columns:1fr}.canopyAuth>aside{padding:36px 24px}.canopyAuth>main{padding:28px 20px}.canopyWelcome{align-items:flex-start;flex-direction:column}.canopyProgressRing{width:104px;height:104px}.canopyProgressRing>div{width:82px;height:82px}.canopyContinue{align-items:flex-start;flex-direction:column}.canopyDashGrid{grid-template-columns:1fr}.canopyCourseHero{grid-template-columns:1fr}.canopyCourseStat{grid-template-columns:auto 1fr}.canopyModuleRow{grid-template-columns:36px minmax(0,1fr) 34px;gap:10px}.canopyLesson,.canopyQuiz,.canopyAssignments,.canopyProgressPage,.canopyResources,.canopyProfile,.canopyDashboard,.canopyCoursePage,.canopyManager{padding:22px 15px}.canopyLessonLayout>article{padding:24px 18px}.canopyLessonLayout>article footer{flex-direction:column}.canopyLessonLayout>article footer button{width:100%}.canopyAssignments>section>article{grid-template-columns:32px 1fr}.canopyAssignments>section>article>button{grid-column:2;width:fit-content}.canopyProgressHero,.canopyManagerStats{grid-template-columns:1fr}.canopyProgressModules article{grid-template-columns:28px minmax(0,1fr) 45px}.canopyProfile>section>div{grid-template-columns:1fr;gap:4px}.canopyManagerTable{overflow:auto}.canopyManagerTable header,.canopyManagerTable>div{min-width:620px}.canopySignout span{display:none}}
.canopyAuthHelp{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:14px}.canopyAuthHelp button{border:0;background:transparent;padding:0;color:var(--canopy);font-size:13px;font-weight:900;text-decoration:underline;text-underline-offset:3px}.canopyAuthHelp button:disabled{opacity:.5;cursor:not-allowed}.canopyFormMsg{padding:12px 14px;border-radius:10px;background:#eef5f1}.canopyFormMsg.success{background:#edf8ee;color:#245a32}.canopyFormMsg.warning{background:#fff5d8;color:#745600}.canopyFormMsg.error{background:#fff0ee;color:#8a2c24}

/* CANOPY HERO SLIDING DEMO V2 */
.canopyHeroDemo{position:relative;width:100%;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center}.canopyHeroDemoStage{position:relative;width:min(100%,760px);aspect-ratio:1.42/1}.canopyHeroDemoImage{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transform:translateX(24px) scale(.985);transition:opacity .8s ease,transform .9s cubic-bezier(.2,.8,.2,1);pointer-events:none;filter:drop-shadow(0 24px 36px rgba(4,41,39,.12))}.canopyHeroDemoImage.isActive{opacity:1;transform:none}.canopyHeroDemoNav{display:flex;gap:8px;justify-content:center;z-index:3}.canopyHeroDemoNav button{border:0;width:7px;height:7px;border-radius:999px;background:rgba(14,77,74,.25);padding:0;cursor:pointer;transition:.25s}.canopyHeroDemoNav button.isActive{width:27px;background:#C6FF52}@media(max-width:680px){.canopyHeroDemo{margin-top:12px}.canopyHeroDemoStage{width:100%;aspect-ratio:1.28/1}}@media(prefers-reduced-motion:reduce){.canopyHeroDemoImage{transition:none}}

/* CANOPY EXACT LANDING + WEEKLY PACING */
.canopyBrand{padding:0;border:0;background:transparent;display:inline-flex;align-items:center;cursor:pointer}
.canopyBrand img{display:block;width:clamp(150px,15vw,220px);height:auto;object-fit:contain}
.canopyBrand.compact img{width:145px}
.canopyPaceNote{margin-top:22px;padding:17px 19px;border:1px solid rgba(14,77,74,.14);border-radius:18px;background:rgba(198,255,82,.10);display:grid;gap:5px;max-width:720px}
.canopyPaceNote b{color:#0E4D4A;font-size:14px}.canopyPaceNote span{font-size:13px;line-height:1.55;color:rgba(14,77,74,.72)}
.canopyModulePreview{display:block!important}
.canopyModuleAccordion{border-top:1px solid rgba(14,77,74,.14);background:transparent}
.canopyModuleAccordion:last-child{border-bottom:1px solid rgba(14,77,74,.14)}
.canopyModuleAccordion summary{list-style:none;display:grid;grid-template-columns:56px minmax(0,1fr) 28px;gap:16px;align-items:center;padding:22px 4px;cursor:pointer}
.canopyModuleAccordion summary::-webkit-details-marker{display:none}
.canopyModuleAccordion summary>div{min-width:0}.canopyModuleAccordion summary small{display:block;margin-bottom:4px;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:rgba(14,77,74,.55)}
.canopyModuleAccordion summary h3{margin:0;font-size:clamp(17px,2vw,22px);line-height:1.2;color:#103f3c}
.canopyModuleNo{font-size:13px;font-weight:850;letter-spacing:.12em;color:#0E4D4A}
.canopyModuleChevron{transition:transform .25s ease}.canopyModuleAccordion[open] .canopyModuleChevron{transform:rotate(90deg)}
.canopyModuleAnswer{padding:0 44px 23px 76px}.canopyModuleAnswer>p{margin:0;max-width:720px;line-height:1.65;color:rgba(14,77,74,.76)}
.canopyModuleRhythm{display:flex;gap:9px;flex-wrap:wrap;margin-top:15px}.canopyModuleRhythm span{font-size:12px;padding:8px 11px;border-radius:999px;background:rgba(198,255,82,.2);color:#0E4D4A}
.canopyModuleRow:disabled{cursor:not-allowed;opacity:.58}
.canopyLockedModule{min-height:65vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;max-width:720px;margin:auto;padding:48px 28px}.canopyLockedModule>svg{margin-bottom:20px}.canopyLockedModule h1{font-size:clamp(34px,5vw,64px);line-height:1;margin:0 0 16px}.canopyLockedModule p{line-height:1.65;margin:0 0 24px}
@media(max-width:680px){.canopyBrand img{width:155px}.canopyBrand.compact img{width:128px}.canopyModuleAccordion summary{grid-template-columns:42px minmax(0,1fr) 24px;gap:10px;padding:18px 0}.canopyModuleAnswer{padding:0 0 20px 52px}.canopyModuleRhythm{display:grid}.canopyPaceNote{padding:15px}}

/* CANOPY PUBLIC LUX POLISH */
/* Premium public-course hierarchy: quiet warm surface + fine-grain effect built in CSS, no generated image asset. */
.canopyCourseIntroEditorial{
  position:relative;
  overflow:hidden;
  display:block!important;
  padding:clamp(72px,8vw,118px) clamp(24px,6vw,92px)!important;
  background:
    radial-gradient(circle at 14% 18%,rgba(198,255,82,.13),transparent 26%),
    radial-gradient(circle at 86% 76%,rgba(14,77,74,.07),transparent 28%),
    linear-gradient(135deg,#f4f2e9 0%,#fbfaf5 52%,#eeeee5 100%)!important;
  isolation:isolate;
}
.canopyCourseIntroEditorial:before{
  content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;opacity:.38;
  background-image:
    repeating-linear-gradient(0deg,rgba(14,77,74,.025) 0,rgba(14,77,74,.025) 1px,transparent 1px,transparent 4px),
    repeating-linear-gradient(90deg,rgba(255,255,255,.24) 0,rgba(255,255,255,.24) 1px,transparent 1px,transparent 5px);
  mix-blend-mode:multiply;
}
.canopyCourseIntroEditorial .canopyCourseIntroLead{
  width:min(1180px,100%);margin:0 auto;text-align:center;
}
.canopyCourseIntroEditorial .canopyEyebrow{display:block;margin:0 auto 22px}
.canopyCourseIntroEditorial h2{
  max-width:1180px!important;margin:0 auto!important;
  text-align:center!important;
  font-size:clamp(34px,4.6vw,70px)!important;
  line-height:1.04!important;letter-spacing:-.045em!important;
  text-wrap:balance;
}
.canopyCourseIntroEditorial .canopyMeta{
  width:max-content;max-width:100%;margin:38px auto 0!important;justify-content:center!important;
}
.canopyPaceNote,.canopyModuleRhythm{display:none!important}
.canopyModulePreview{
  position:relative;
  background:
    linear-gradient(180deg,rgba(255,255,255,.72),rgba(246,245,239,.92)),
    repeating-linear-gradient(135deg,rgba(14,77,74,.018) 0,rgba(14,77,74,.018) 1px,transparent 1px,transparent 6px);
}
.canopyModuleAccordion summary{transition:background .22s ease,padding .22s ease}
.canopyModuleAccordion summary:hover{background:rgba(198,255,82,.075)}
@media(max-width:720px){
 .canopyCourseIntroEditorial{padding:64px 22px!important}
 .canopyCourseIntroEditorial h2{font-size:clamp(31px,9vw,48px)!important;line-height:1.08!important}
 .canopyCourseIntroEditorial .canopyMeta{width:100%;justify-content:center}
}

/* CANOPY BACKGROUND HIERARCHY SWAP */

/* Light, fine-grained editorial background for the She Leads cohort statement */
.canopyCourseIntroEditorial{
  background:
    radial-gradient(circle at 12% 18%,rgba(198,255,82,.11),transparent 24%),
    radial-gradient(circle at 88% 76%,rgba(14,77,74,.055),transparent 28%),
    linear-gradient(135deg,#f7f5ee 0%,#fcfbf7 52%,#f1f0e8 100%)!important;
  color:#103f3c!important;
}
.canopyCourseIntroEditorial:before{
  opacity:.32!important;
  background-image:
    repeating-linear-gradient(0deg,rgba(14,77,74,.02) 0,rgba(14,77,74,.02) 1px,transparent 1px,transparent 4px),
    repeating-linear-gradient(90deg,rgba(255,255,255,.22) 0,rgba(255,255,255,.22) 1px,transparent 1px,transparent 5px)!important;
}
.canopyCourseIntroEditorial h2,
.canopyCourseIntroEditorial .canopyEyebrow{
  color:#103f3c!important;
}

/* Deep green field now carries the curriculum + how-it-works + footer */
.canopyModulePreview{
  background:
    radial-gradient(circle at 18% 12%,rgba(198,255,82,.055),transparent 24%),
    linear-gradient(180deg,#0E4D4A 0%,#0b403e 100%)!important;
  color:#fff!important;
  padding:clamp(48px,6vw,82px) clamp(24px,6vw,92px)!important;
}
.canopyModuleAccordion{
  border-color:rgba(255,255,255,.14)!important;
}
.canopyModuleAccordion:last-child{
  border-color:rgba(255,255,255,.14)!important;
}
.canopyModuleAccordion summary:hover{
  background:rgba(198,255,82,.06)!important;
}
.canopyModuleAccordion summary small,
.canopyModuleAccordion summary h3,
.canopyModuleNo,
.canopyModuleChevron,
.canopyModuleAnswer>p{
  color:#fff!important;
}
.canopyModuleAccordion summary small{
  color:rgba(255,255,255,.58)!important;
}
.canopyModuleAnswer>p{
  color:rgba(255,255,255,.76)!important;
}

/* HOW IT WORKS joins the same green visual chapter */
.canopyHow{
  background:
    radial-gradient(circle at 84% 18%,rgba(198,255,82,.06),transparent 24%),
    linear-gradient(180deg,#0b403e 0%,#093735 100%)!important;
  color:#fff!important;
  padding-top:clamp(58px,7vw,92px)!important;
  padding-bottom:clamp(66px,8vw,108px)!important;
}
.canopyHow .canopyEyebrow,
.canopyHow h2,
.canopyHowGrid h3{
  color:#fff!important;
}
.canopyHowGrid p{
  color:rgba(255,255,255,.72)!important;
}
.canopyHowGrid article{
  border-color:rgba(255,255,255,.12)!important;
  background:rgba(255,255,255,.035)!important;
  box-shadow:none!important;
}
.canopyHowGrid article svg{
  color:#C6FF52!important;
}

/* Footer becomes part of the deep-green chapter instead of a separate light strip */
.canopyPublicFooter{
  background:#093735!important;
  color:#fff!important;
  border-top:1px solid rgba(255,255,255,.12)!important;
}
.canopyPublicFooter span:last-child{
  color:rgba(255,255,255,.62)!important;
}

@media(max-width:680px){
  .canopyModulePreview{
    padding:40px 20px!important;
  }
  .canopyHow{
    padding-left:20px!important;
    padding-right:20px!important;
  }
}

/* CANOPY ALTERNATING GLOBAL STANDARD */

/* 1. Hero remains light */

/* 2. SHE LEADS · COHORT 3 becomes deep green */
.canopyCourseIntroEditorial{
  position:relative!important;
  overflow:hidden!important;
  background:
    radial-gradient(circle at 14% 18%,rgba(198,255,82,.08),transparent 25%),
    radial-gradient(circle at 88% 82%,rgba(255,255,255,.04),transparent 28%),
    linear-gradient(135deg,#0E4D4A 0%,#0b4643 56%,#093936 100%)!important;
  color:#fff!important;
  padding:clamp(76px,8vw,122px) clamp(24px,6vw,92px)!important;
}
.canopyCourseIntroEditorial:before{
  content:"";position:absolute;inset:0;pointer-events:none;
  opacity:.25!important;
  background-image:
    repeating-linear-gradient(0deg,rgba(255,255,255,.025) 0,rgba(255,255,255,.025) 1px,transparent 1px,transparent 4px),
    repeating-linear-gradient(90deg,rgba(198,255,82,.012) 0,rgba(198,255,82,.012) 1px,transparent 1px,transparent 6px)!important;
}
.canopyCourseIntroEditorial .canopyCourseIntroLead{position:relative;z-index:1}
.canopyCourseIntroEditorial .canopyEyebrow{
  color:#C6FF52!important;
  opacity:1!important;
}
.canopyCourseIntroEditorial h2{
  color:#fff!important;
  max-width:1180px!important;
  margin:0 auto!important;
  text-align:center!important;
}
.canopyCourseIntroEditorial .canopyMeta{
  position:relative;z-index:1;
  width:max-content;max-width:100%;margin:38px auto 0!important;
  justify-content:center!important;
}
.canopyCourseIntroEditorial .canopyMeta span{
  color:#fff!important;
  border-color:rgba(255,255,255,.18)!important;
  background:rgba(255,255,255,.055)!important;
}

/* 3. Curriculum returns to a light fine-grained surface */
.canopyModulePreview{
  background:
    radial-gradient(circle at 10% 20%,rgba(198,255,82,.09),transparent 24%),
    linear-gradient(180deg,#faf9f4 0%,#f3f2eb 100%)!important;
  color:#103f3c!important;
  padding:clamp(54px,7vw,92px) clamp(24px,6vw,92px)!important;
}
.canopyModulePreview:before{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.28;
  background-image:
    repeating-linear-gradient(0deg,rgba(14,77,74,.018) 0,rgba(14,77,74,.018) 1px,transparent 1px,transparent 4px),
    repeating-linear-gradient(90deg,rgba(255,255,255,.22) 0,rgba(255,255,255,.22) 1px,transparent 1px,transparent 5px);
}
.canopyModuleAccordion{
  position:relative;z-index:1;
  border-color:rgba(14,77,74,.14)!important;
}
.canopyModuleAccordion:last-child{border-color:rgba(14,77,74,.14)!important}
.canopyModuleAccordion summary:hover{background:rgba(14,77,74,.035)!important}
.canopyModuleAccordion summary small{color:rgba(14,77,74,.55)!important}
.canopyModuleAccordion summary h3,
.canopyModuleNo,
.canopyModuleChevron{color:#103f3c!important}
.canopyModuleAnswer>p{color:rgba(14,77,74,.74)!important}

/* 4. HOW IT WORKS becomes the next green band */
.canopyHow{
  background:
    radial-gradient(circle at 86% 18%,rgba(198,255,82,.065),transparent 24%),
    linear-gradient(180deg,#0E4D4A 0%,#0a403d 100%)!important;
  color:#fff!important;
  padding:clamp(76px,8vw,112px) clamp(24px,6vw,92px)!important;
}
.canopyHow .canopyEyebrow{color:#C6FF52!important}
.canopyHow h2,.canopyHowGrid h3{color:#fff!important}
.canopyHowGrid{
  gap:18px!important;
}
.canopyHowGrid article{
  background:rgba(255,255,255,.04)!important;
  border:1px solid rgba(255,255,255,.12)!important;
  border-radius:22px!important;
  padding:28px!important;
  box-shadow:none!important;
}
.canopyHowGrid article svg{color:#C6FF52!important}
.canopyHowGrid p{color:rgba(255,255,255,.72)!important}

/* 5. Simple, global-standard footer using supplied Canopy logo */
.canopyPublicFooter{
  background:#082f2d!important;
  color:#fff!important;
  border-top:1px solid rgba(255,255,255,.10)!important;
  padding:28px clamp(22px,6vw,92px)!important;
  display:flex!important;
  align-items:center!important;
  justify-content:space-between!important;
  gap:24px!important;
}
.canopyFooterBrand img{
  display:block;
  width:clamp(145px,14vw,200px);
  height:auto;
  filter:brightness(0) invert(1);
  opacity:.96;
}
.canopyFooterMeta{
  display:flex;
  align-items:center;
  gap:18px;
  flex-wrap:wrap;
  justify-content:flex-end;
  text-align:right;
}
.canopyFooterMeta span{
  font-size:12px;
  line-height:1.4;
  color:rgba(255,255,255,.62)!important;
}
.canopyFooterMeta span+span{
  padding-left:18px;
  border-left:1px solid rgba(255,255,255,.14);
}

@media(max-width:760px){
  .canopyCourseIntroEditorial{padding:66px 20px!important}
  .canopyModulePreview,.canopyHow{padding-left:20px!important;padding-right:20px!important}
  .canopyPublicFooter{
    align-items:flex-start!important;
    flex-direction:column!important;
  }
  .canopyFooterMeta{
    justify-content:flex-start;
    text-align:left;
    gap:8px 14px;
  }
  .canopyFooterMeta span+span{
    padding-left:0;
    border-left:0;
  }
}

/* CANOPY SHE LEADS STYLE ICON STEPS */
.canopyHowIcons{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:clamp(24px,3vw,48px);
  margin-top:clamp(38px,5vw,64px);
}
.canopyHowIcons article{
  position:relative;
  display:block;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent!important;
  box-shadow:none!important;
}
.canopyHowIcon{
  width:64px;
  height:64px;
  display:grid;
  place-items:center;
  margin-bottom:24px;
  border-radius:50%;
  border:1px solid rgba(198,255,82,.48);
  background:rgba(198,255,82,.075);
  transition:transform .25s ease,background .25s ease,border-color .25s ease;
}
.canopyHowIcon svg{
  width:27px;
  height:27px;
  stroke-width:1.55;
  color:#C6FF52!important;
}
.canopyHowIcons article:hover .canopyHowIcon{
  transform:translateY(-4px);
  background:rgba(198,255,82,.13);
  border-color:rgba(198,255,82,.78);
}
.canopyHowIcons h3{
  margin:0 0 10px;
  color:#fff!important;
  font-size:18px;
  letter-spacing:-.02em;
}
.canopyHowIcons p{
  margin:0;
  max-width:250px;
  color:rgba(255,255,255,.68)!important;
  font-size:13px;
  line-height:1.65;
}
@media(max-width:900px){
 .canopyHowIcons{grid-template-columns:repeat(2,minmax(0,1fr));gap:38px 28px}
}
@media(max-width:560px){
 .canopyHowIcons{grid-template-columns:1fr;gap:30px}
 .canopyHowIcons article{display:grid;grid-template-columns:58px 1fr;gap:17px;align-items:start}
 .canopyHowIcon{width:54px;height:54px;margin:0}
 .canopyHowIcon svg{width:23px;height:23px}
 .canopyHowIcons p{max-width:none}
}

/* CANOPY HERO FULLER IMAGE SIZE */
.canopyHeroDemoStage{overflow:visible!important}
.canopyHeroDemoImage{width:112%!important;max-width:none!important;height:auto!important;left:50%!important;transform:translateX(-50%) scale(1.04)!important;transform-origin:center center!important}
.canopyHeroDemoImage.isActive{transform:translateX(-50%) scale(1.04)!important}
@media(max-width:760px){.canopyHeroDemoImage,.canopyHeroDemoImage.isActive{width:108%!important;transform:translateX(-50%) scale(1.02)!important}}

/* CANOPY AUTH LUXE REDESIGN */
.canopyAuthLuxe{
  min-height:100svh;
  display:grid!important;
  grid-template-columns:minmax(440px,1.08fr) minmax(430px,.92fr)!important;
  background:#f6f5ef!important;
  color:#103f3c;
}
.canopyAuthLuxe .canopyAuthVisual{
  position:relative;
  min-height:100svh;
  overflow:hidden;
  isolation:isolate;
  padding:clamp(34px,4vw,64px);
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  background:#083f3d url('/assets/canopy/auth/canopy-auth-bg.png') center/cover no-repeat!important;
}
.canopyAuthVisualOverlay{
  position:absolute;inset:0;z-index:-1;
  background:
    linear-gradient(180deg,rgba(3,35,33,.12),rgba(3,35,33,.24) 48%,rgba(3,35,33,.72)),
    radial-gradient(circle at 18% 18%,rgba(198,255,82,.09),transparent 32%);
}
.canopyAuthLogo{
  position:relative;z-index:2;
  width:min(330px,72%);
  padding:0;border:0;background:transparent;cursor:pointer;
}
.canopyAuthLogo img{display:block;width:100%;height:auto}
.canopyAuthVisualCopy{
  position:relative;z-index:2;
  max-width:650px;
  margin-top:auto;
  padding-top:80px;
}
.canopyAuthKicker{
  display:inline-flex;
  margin-bottom:18px;
  font-size:11px;
  font-weight:850;
  letter-spacing:.16em;
  color:#C6FF52;
}
.canopyAuthVisualCopy h1{
  margin:0;
  max-width:620px;
  font-size:clamp(42px,5.3vw,78px);
  line-height:.98;
  letter-spacing:-.055em;
  color:#fff;
  text-wrap:balance;
}
.canopyAuthVisualCopy p{
  max-width:560px;
  margin:22px 0 0;
  color:rgba(255,255,255,.72);
  font-size:15px;
  line-height:1.7;
}
.canopyAuthVisualFoot{
  position:relative;z-index:2;
  display:flex;flex-wrap:wrap;gap:10px 20px;
  margin-top:46px;padding-top:18px;
  border-top:1px solid rgba(255,255,255,.14);
}
.canopyAuthVisualFoot span{
  font-size:9px;font-weight:800;letter-spacing:.16em;color:rgba(255,255,255,.52)
}
.canopyAuthPanelWrap{
  min-height:100svh;
  padding:clamp(24px,4vw,54px)!important;
  display:flex!important;
  flex-direction:column;
  justify-content:center;
  background:
    radial-gradient(circle at 82% 8%,rgba(198,255,82,.10),transparent 22%),
    linear-gradient(145deg,#fbfaf6 0%,#f2f1e9 100%)!important;
}
.canopyAuthPanelWrap>.canopyBack{
  position:absolute;
  top:28px;
  margin:0!important;
}
.canopyAuthPanel{
  width:min(520px,100%);
  margin:0 auto;
  padding:clamp(30px,4vw,48px);
  background:rgba(255,255,255,.78);
  border:1px solid rgba(14,77,74,.10);
  border-radius:28px;
  box-shadow:0 24px 70px rgba(7,49,47,.11);
  backdrop-filter:blur(16px);
}
.canopyAuthPanel .canopyAuthHead{margin-bottom:28px}
.canopyAuthPanel .canopyAuthHead>span{
  display:block;
  margin-bottom:9px;
  font-size:10px;
  font-weight:850;
  letter-spacing:.15em;
  color:#0E4D4A;
}
.canopyAuthPanel .canopyAuthHead h2{
  margin:0;
  color:#0b3e3b;
  font-size:clamp(34px,4vw,50px);
  line-height:1;
  letter-spacing:-.045em;
}
.canopyAuthPanel .canopyAuthHead>p:not(.canopyConfigWarn){
  margin:12px 0 0;
  color:rgba(14,77,74,.62);
  font-size:13px;
  line-height:1.6;
}
.canopyAuthPanel form{display:grid;gap:17px}
.canopyAuthPanel label{
  display:grid;
  gap:8px;
  font-size:11px;
  font-weight:800;
  letter-spacing:.02em;
  color:#164f4c;
}
.canopyAuthPanel input{
  width:100%;
  min-height:54px;
  padding:0 16px;
  border:1px solid rgba(14,77,74,.15)!important;
  border-radius:14px!important;
  background:#fff!important;
  color:#103f3c!important;
  outline:none;
  box-shadow:0 1px 0 rgba(255,255,255,.8) inset;
  transition:border-color .2s ease,box-shadow .2s ease,transform .2s ease;
}
.canopyAuthPanel input::placeholder{color:rgba(14,77,74,.34)}
.canopyAuthPanel input:focus{
  border-color:rgba(14,77,74,.56)!important;
  box-shadow:0 0 0 4px rgba(198,255,82,.16)!important;
}
.canopyAuthTwoCol{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.canopyPasswordField{position:relative}
.canopyPasswordField input{padding-right:52px}
.canopyPasswordField>button{
  position:absolute;right:9px;top:50%;transform:translateY(-50%);
  width:36px;height:36px;display:grid;place-items:center;
  border:0;border-radius:10px;background:transparent;color:#0E4D4A;cursor:pointer;
}
.canopyPasswordField>button:hover{background:rgba(14,77,74,.055)}
.canopyPasswordField svg{width:18px;height:18px}
.canopyAuthSubmit{
  min-height:56px!important;
  margin-top:3px;
  border-radius:14px!important;
  box-shadow:0 10px 26px rgba(14,77,74,.16);
}
.canopyAuthPanel .canopyAuthHelp{
  display:flex;
  justify-content:space-between;
  gap:12px;
  padding-top:2px;
}
.canopyAuthPanel .canopyAuthHelp button,
.canopyAuthPanel .canopySwitch button{
  border:0;background:transparent;padding:0;color:#0E4D4A;font-weight:800;cursor:pointer;
}
.canopyAuthPanel .canopySwitch{
  margin:3px 0 0;
  padding-top:18px;
  border-top:1px solid rgba(14,77,74,.10);
  text-align:center;
  color:rgba(14,77,74,.58);
  font-size:12px;
}
.canopyAuthLuxe .canopyFormMsg{border-radius:12px!important}
@media(max-width:980px){
 .canopyAuthLuxe{grid-template-columns:1fr!important}
 .canopyAuthLuxe .canopyAuthVisual{
   min-height:390px;
   padding:28px 28px 34px;
 }
 .canopyAuthLogo{width:min(250px,58%)}
 .canopyAuthVisualCopy{padding-top:56px}
 .canopyAuthVisualCopy h1{font-size:clamp(38px,8vw,58px);max-width:720px}
 .canopyAuthVisualCopy p{max-width:680px}
 .canopyAuthVisualFoot{margin-top:34px}
 .canopyAuthPanelWrap{min-height:auto;padding:72px 22px 34px!important}
 .canopyAuthPanelWrap>.canopyBack{top:24px;left:22px}
}
@media(max-width:620px){
 .canopyAuthLuxe .canopyAuthVisual{
   min-height:330px;
   background-position:65% center!important;
   padding:22px 20px 28px;
 }
 .canopyAuthLogo{width:210px;max-width:62%}
 .canopyAuthVisualCopy{padding-top:44px}
 .canopyAuthVisualCopy h1{font-size:clamp(34px,10vw,48px);line-height:1.02}
 .canopyAuthVisualCopy p{font-size:13px;line-height:1.55}
 .canopyAuthVisualFoot{display:none}
 .canopyAuthPanelWrap{padding:68px 16px 24px!important}
 .canopyAuthPanel{
   padding:26px 20px;
   border-radius:22px;
   box-shadow:0 16px 44px rgba(7,49,47,.08);
 }
 .canopyAuthTwoCol{grid-template-columns:1fr}
 .canopyAuthPanel .canopyAuthHelp{align-items:flex-start;flex-direction:column}
}

/* CANOPY ADMIN LEARNER ACCESS */
.canopyManagerAccessTable header,.canopyManagerAccessTable>div{grid-template-columns:minmax(180px,1.5fr) minmax(100px,.8fr) 90px 110px 100px minmax(130px,.9fr)!important;align-items:center}
.canopyManagerAccessTable .canopyPrimary,.canopyManagerAccessTable .canopySecondary{min-height:40px;padding:9px 14px;font-size:12px;white-space:nowrap}
.canopyAccessStatus{display:inline-flex;align-items:center;min-height:28px;padding:5px 10px;border-radius:999px;font-size:11px;letter-spacing:.04em}
.canopyAccessStatus.isActive{background:rgba(198,255,82,.2)}
.canopyAccessStatus.isWaiting{background:rgba(14,77,74,.08);font-weight:700}
@media(max-width:900px){
 .canopyManagerAccessTable{overflow-x:auto}
 .canopyManagerAccessTable header,.canopyManagerAccessTable>div{min-width:850px}
}

/* CANOPY ADMIN OPERATIONS HUB */
.canopyOpsGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.canopyOpsGrid>button{display:grid;grid-template-columns:48px 1fr 22px;gap:14px;align-items:center;text-align:left;border:1px solid rgba(14,77,74,.12);background:#fff;border-radius:20px;padding:20px;cursor:pointer}
.canopyOpsGrid>button>svg:first-child{width:46px;height:46px;padding:12px;border-radius:16px;background:rgba(198,255,82,.23)}
.canopyOpsGrid b{display:block;font-size:15px}.canopyOpsGrid small{display:block;margin-top:5px;line-height:1.45;opacity:.7}
.canopyManagerAccessTable header,.canopyManagerAccessTable>div{grid-template-columns:minmax(220px,1.5fr) minmax(120px,.8fr) 110px minmax(140px,.8fr)!important;align-items:center}
.canopyAccessStatus{display:inline-flex;align-items:center;min-height:28px;padding:5px 10px;border-radius:999px;font-size:11px;letter-spacing:.04em}
.canopyAccessStatus.isActive{background:rgba(198,255,82,.22)}.canopyAccessStatus.isWaiting{background:rgba(14,77,74,.08)}
.canopyOpsForm{background:#fff;border:1px solid rgba(14,77,74,.12);border-radius:24px;padding:24px;margin-bottom:22px}
.canopyOpsFormGrid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:18px 0}.canopyOpsFormGrid label{display:grid;gap:7px;font-size:12px;font-weight:700}.canopyOpsFormGrid .wide{grid-column:1/-1}
.canopyOpsForm input,.canopyOpsForm select,.canopyOpsForm textarea{width:100%;border:1px solid rgba(14,77,74,.17);border-radius:14px;background:#fff;padding:13px 14px;font:inherit}
.canopyOpsList{display:grid;gap:12px}.canopyOpsList>article{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;background:#fff;border:1px solid rgba(14,77,74,.1);border-radius:18px;padding:20px}.canopyOpsList h3{margin:5px 0}.canopyOpsList p{margin:0;opacity:.72}.canopyOpsList code{display:inline-block;margin-top:9px}.canopyOpsListActions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.canopyOpsReport{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.canopyOpsReport article{background:#fff;border-radius:18px;padding:22px;border:1px solid rgba(14,77,74,.1)}.canopyOpsReport strong{display:block;font-size:28px}.canopyOpsReport span{font-size:12px;opacity:.7}
@media(max-width:980px){.canopyOpsGrid{grid-template-columns:1fr 1fr}.canopyOpsReport{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.canopyOpsGrid,.canopyOpsReport,.canopyOpsFormGrid{grid-template-columns:1fr}.canopyOpsFormGrid .wide{grid-column:auto}.canopyOpsList>article{display:grid}.canopyManagerAccessTable{overflow-x:auto}.canopyManagerAccessTable header,.canopyManagerAccessTable>div{min-width:720px}}


/* WOMATE CANOPY automated learning */
.ca-page,.cc-page,.cn-page,.ccert-page{max-width:1180px;margin:0 auto;padding:34px 26px 70px}
.ca-kicker,.cc-kicker,.cn-kicker,.ccert-kicker{font-size:.74rem;letter-spacing:.14em;font-weight:800;color:#0E4D4A}
.ca-head h1,.cc-head h1,.cn-page h1,.ccert-page h1{font-size:clamp(2rem,4vw,4rem);line-height:1.02;margin:.45rem 0 1rem}
.ca-head p,.cc-head p{max-width:800px;color:#52615e}
.ca-stack{display:grid;gap:24px;margin-top:28px}.ca-card{background:#fff;border:1px solid #e1e9e6;border-radius:24px;padding:24px;box-shadow:0 14px 40px rgba(14,77,74,.06)}
.ca-card-head{display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.ca-card-head small{font-weight:800;color:#0E4D4A}.ca-card-head h2{margin:.35rem 0}.ca-dates{display:grid;gap:5px;text-align:right;font-size:.86rem}
.ca-threefold{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:20px 0}.ca-threefold>div{background:#f4f8f6;border-radius:18px;padding:18px}.ca-threefold h3{margin:.5rem 0}.ca-threefold p{font-size:.92rem;color:#596663}.ca-threefold a{font-weight:800;color:#0E4D4A}
.ca-status{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;background:#0E4D4A;color:#fff;padding:16px;border-radius:18px;margin:18px 0}.ca-status>div{display:grid;gap:5px}.ca-status span{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:#cde1dc}.ca-feedback{grid-column:1/-1}
.ca-form{display:grid;gap:14px}.ca-form label,.cc-form label{display:grid;gap:7px;font-weight:750}.ca-form input,.ca-form textarea,.cc-form input,.cc-form textarea,.cc-form select{width:100%;border:1px solid #cfdad7;border-radius:12px;padding:12px 13px;font:inherit;background:#fff}
.ca-form button,.cc-download,.ca-puzzle button{border:0;border-radius:999px;background:#0E4D4A;color:#fff;padding:12px 18px;font-weight:800;cursor:pointer;width:max-content}.ca-form button:disabled{opacity:.55}
.ca-puzzle{margin-top:20px;border-top:1px solid #e3e9e7;padding-top:15px}.ca-puzzle summary{font-weight:800;cursor:pointer}.ca-puzzle-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:15px 0}.ca-puzzle-grid label{display:grid;gap:5px}.ca-puzzle-grid span{letter-spacing:.15em;font-weight:800;color:#0E4D4A}.ca-puzzle-grid input{border:1px solid #ccd7d4;border-radius:10px;padding:10px}
.ca-empty,.cn-empty,.ccert-empty{background:#f3f7f5;border-radius:20px;padding:28px;margin-top:24px}.ca-toast{position:fixed;right:22px;bottom:22px;background:#0E4D4A;color:#fff;padding:14px 18px;border-radius:14px;max-width:420px;box-shadow:0 10px 30px rgba(0,0,0,.18);z-index:100}
.cc-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr);gap:28px;margin-top:28px}.cc-form{display:grid;gap:14px}.cc-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.cc-preview{background:#0E4D4A;color:#fff;aspect-ratio:1/1;border-radius:24px;padding:8%;display:flex;flex-direction:column;box-shadow:0 18px 50px rgba(14,77,74,.18);overflow:hidden}.cc-preview.portrait-post{aspect-ratio:4/5}.cc-preview.landscape-card{aspect-ratio:16/9}.cc-preview>span{font-weight:900;letter-spacing:.08em}.cc-preview>small{color:#C6FF52;text-transform:uppercase;font-weight:800;margin-top:14%}.cc-preview h2{font-size:clamp(1.6rem,3.5vw,3.6rem);line-height:1.03;margin:4% 0}.cc-preview p{color:#dbe8e5;margin-top:auto}.cc-preview strong{color:#C6FF52}.cc-preview em{margin-top:5%;font-style:normal}.cc-note{font-weight:750;color:#0E4D4A;background:#f2f7f5;border-radius:12px;padding:12px}
.cn-list{display:grid;gap:10px;margin-top:25px}.cn-item{width:100%;text-align:left;border:1px solid #dce5e2;background:#fff;border-radius:16px;padding:18px;display:flex;justify-content:space-between;gap:20px;cursor:pointer}.cn-item.unread{border-left:5px solid #0E4D4A;background:#f7fbf9}.cn-item small{color:#0E4D4A;text-transform:uppercase;font-weight:800}.cn-item h3{margin:.25rem 0}.cn-item p{margin:0;color:#586562}.cn-item time{font-size:.78rem;color:#687572;white-space:nowrap}
.ccert-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:24px}.ccert-grid article{border:1px solid #dfe8e5;border-radius:20px;padding:22px}.ccert-grid a{font-weight:800;color:#0E4D4A}
@media(max-width:820px){.ca-threefold,.ca-status,.ccert-grid{grid-template-columns:1fr}.ca-card-head{display:grid}.ca-dates{text-align:left}.cc-grid{grid-template-columns:1fr}.cc-preview{order:-1}.ca-puzzle-grid,.cc-two{grid-template-columns:1fr}.cn-item{display:grid}}



/* CANOPY 2026 complete curriculum */
.cl-page{max-width:1220px;margin:0 auto;padding:34px 26px 80px}.cl-hero{padding:30px 0 34px;max-width:850px}.cl-hero>span,.cl-module-intro>div>span,.cl-case>span,.cl-assignment-bridge>div>span,.cl-lesson-nav>span{font-size:.72rem;letter-spacing:.14em;font-weight:850;color:#0E4D4A}.cl-hero h1{font-size:clamp(2.5rem,5vw,5rem);line-height:.98;letter-spacing:-.045em;margin:.55rem 0 1rem}.cl-hero p{font-size:1.05rem;color:#53635f;max-width:760px}
.cl-module-tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;border-bottom:1px solid #dce5e2;padding-bottom:18px}.cl-module-tabs button{border:0;background:#f3f7f5;border-radius:16px;padding:14px;text-align:left;display:grid;gap:5px;cursor:pointer}.cl-module-tabs button.active{background:#0E4D4A;color:#fff}.cl-module-tabs b{font-size:.75rem}.cl-module-tabs span{font-weight:800;line-height:1.15}.cl-module-tabs small{opacity:.72}
.cl-module-intro{display:grid;grid-template-columns:1fr 260px;gap:40px;padding:50px 0 30px}.cl-module-intro h2{font-size:clamp(2.2rem,4vw,4.2rem);line-height:1;margin:.5rem 0}.cl-module-intro p{max-width:760px;color:#56635f}.cl-module-intro .cl-question{font-size:1.22rem;color:#0E4D4A;font-weight:750}.cl-module-intro aside{background:#0E4D4A;color:#fff;border-radius:20px;padding:22px;display:flex;flex-direction:column;justify-content:center;gap:7px}.cl-module-intro aside small{color:#C6FF52;font-weight:800}.cl-module-intro aside strong{font-size:1.4rem}
.cl-outcomes{background:#edf5f1;border-radius:22px;padding:24px 28px;margin-bottom:35px}.cl-outcomes h3{margin-top:0}.cl-outcomes ol{columns:2;column-gap:45px;padding-left:22px}.cl-outcomes li{break-inside:avoid;margin:0 0 10px;color:#40504c}
.cl-learning-grid{display:grid;grid-template-columns:280px 1fr;gap:38px;align-items:start}.cl-lesson-nav{position:sticky;top:95px;display:grid;gap:7px}.cl-lesson-nav>span{margin-bottom:6px}.cl-lesson-nav button{border:1px solid #e0e8e5;background:#fff;border-radius:14px;padding:13px;text-align:left;display:grid;grid-template-columns:32px 1fr;gap:3px 8px;cursor:pointer}.cl-lesson-nav button.active{border-color:#0E4D4A;background:#f1f7f4}.cl-lesson-nav button b{grid-row:1/3;color:#0E4D4A}.cl-lesson-nav button span{font-weight:750;line-height:1.2}.cl-lesson-nav button small{color:#70807b}
.cl-lesson{max-width:790px}.cl-lesson-head>span{color:#0E4D4A;font-weight:850}.cl-lesson-head h2{font-size:clamp(2rem,3.5vw,3.4rem);line-height:1.03;margin:.35rem 0}.cl-lesson-head small{color:#71807c}.cl-lesson>p{font-size:1.03rem;line-height:1.78;color:#354440}.cl-lesson blockquote{margin:28px 0;border:0;border-left:5px solid #C6FF52;background:#0E4D4A;color:#fff;padding:20px 24px;border-radius:0 16px 16px 0;font-size:1.08rem;font-weight:700}.cl-lesson blockquote small{display:block;color:#C6FF52;font-size:.7rem;letter-spacing:.12em;margin-bottom:6px}
.cl-check{background:#f3f7f5;border-radius:20px;padding:22px;margin:28px 0}.cl-check>small{color:#0E4D4A;font-weight:850;letter-spacing:.1em}.cl-check h4{font-size:1.15rem}.cl-check>div{display:grid;gap:8px}.cl-check>div button{border:1px solid #d6e0dc;background:#fff;padding:12px 14px;border-radius:12px;text-align:left;cursor:pointer}.cl-check>div button.selected{border-color:#0E4D4A;background:#eaf3ef}.cl-check-submit{margin-top:12px;border:0;background:#0E4D4A;color:#fff;border-radius:999px;padding:10px 16px;font-weight:800}.cl-check .correct{color:#1e684c;font-weight:750}.cl-check .retry{color:#8a4d22;font-weight:750}
.cl-sources{border-top:1px solid #e1e8e6;margin-top:30px;padding-top:18px;display:flex;flex-wrap:wrap;gap:8px 18px}.cl-sources h4{width:100%;margin:0 0 5px}.cl-sources a{color:#0E4D4A;font-size:.88rem;font-weight:700}
.cl-case{margin:55px 0 25px;background:#0E4D4A;color:#fff;border-radius:26px;padding:34px}.cl-case>span{color:#C6FF52}.cl-case h2{font-size:2rem;margin:.5rem 0}.cl-case p{max-width:850px;line-height:1.7;color:#e5efec}
.cl-assignment-bridge{margin:20px 0 35px;border:1px solid #dce5e2;border-radius:26px;padding:30px}.cl-assignment-bridge h2{font-size:2.1rem;margin:.4rem 0}.cl-assignment-bridge>div:first-child p{max-width:900px;line-height:1.65;color:#4f5e5a}.cl-assignment-parts{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin:22px 0}.cl-assignment-parts>div{background:#f2f7f4;border-radius:14px;padding:15px;display:grid;gap:5px}.cl-assignment-parts b{color:#0E4D4A}.cl-assignment-parts span{font-size:.78rem;color:#6d7b77}.cl-assignment-bridge>a{display:inline-block;background:#0E4D4A;color:#fff;padding:11px 17px;border-radius:999px;font-weight:800;text-decoration:none}
@media(max-width:900px){.cl-module-tabs{grid-template-columns:1fr 1fr}.cl-module-intro,.cl-learning-grid{grid-template-columns:1fr}.cl-module-intro aside{max-width:none}.cl-lesson-nav{position:static;grid-template-columns:1fr 1fr}.cl-lesson-nav>span{grid-column:1/-1}.cl-assignment-parts{grid-template-columns:1fr 1fr}.cl-outcomes ol{columns:1}}
@media(max-width:560px){.cl-page{padding:22px 16px 60px}.cl-module-tabs,.cl-lesson-nav,.cl-assignment-parts{grid-template-columns:1fr}.cl-module-intro{padding-top:32px}.cl-case,.cl-assignment-bridge{padding:22px}}


/* UNIFIED 2026 COURSE LOCK DATE */
.canopyModuleOpenDate{font-size:10px;line-height:1.2;font-weight:800;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap;opacity:.65;margin-right:8px}
.canopyModuleArrow{display:flex;align-items:center;justify-content:flex-end;gap:6px}
@media(max-width:680px){.canopyModuleOpenDate{display:none}}
