import React,{useMemo,useState} from 'react';
import {canopyModules2026,canopySources} from './canopyCurriculum2026';

function SourceList({keys=[]}){
  return <div className="cl-sources"><h4>Sources & further reading</h4>{keys.map(k=>{
    const s=canopySources[k]; return s?<a key={k} href={s.url} target="_blank" rel="noreferrer">{s.label} ↗</a>:null;
  })}</div>
}
function KnowledgeCheck({check}){
  const [choice,setChoice]=useState(null),[revealed,setRevealed]=useState(false);
  return <div className="cl-check"><small>KNOWLEDGE CHECK</small><h4>{check.question}</h4>
    <div>{check.options.map((o,i)=><button key={o} type="button" className={choice===i?'selected':''} onClick={()=>{setChoice(i);setRevealed(false)}}>{o}</button>)}</div>
    <button className="cl-check-submit" disabled={choice===null} onClick={()=>setRevealed(true)}>Check answer</button>
    {revealed&&<p className={choice===check.answer?'correct':'retry'}>{choice===check.answer?'Correct. ':'Try again. '}{check.explanation}</p>}
  </div>
}
export default function CanopyCurriculum2026(){
  const [moduleId,setModuleId]=useState('01');
  const [lessonId,setLessonId]=useState('01.1');
  const module=useMemo(()=>canopyModules2026.find(m=>m.id===moduleId)||canopyModules2026[0],[moduleId]);
  const lesson=useMemo(()=>module.lessons.find(l=>l.id===lessonId)||module.lessons[0],[module,lessonId]);

  function selectModule(id){const m=canopyModules2026.find(x=>x.id===id);setModuleId(id);setLessonId(m.lessons[0].id);window.scrollTo({top:0,behavior:'smooth'})}

  return <section className="cl-page">
    <header className="cl-hero">
      <span>2026 CURRICULUM</span>
      <h1>From climate knowledge to climate leadership.</h1>
      <p>Five structured modules combining climate foundations, African and Ghanaian context, practical application, live expert learning and weekly action.</p>
    </header>

    <nav className="cl-module-tabs" aria-label="Course modules">
      {canopyModules2026.map(m=><button key={m.id} className={m.id===module.id?'active':''} onClick={()=>selectModule(m.id)}>
        <b>{m.id}</b><span>{m.title}</span><small>{m.weekLabel}</small>
      </button>)}
    </nav>

    <div className="cl-module-intro">
      <div><span>MODULE {module.id} · {module.weekLabel}</span><h2>{module.title}</h2><p className="cl-question">{module.framingQuestion}</p><p>{module.overview}</p></div>
      <aside><small>LIVE EXPERT SESSION</small><strong>{module.liveDate}</strong><span>Thursday · 4:00 PM GMT</span></aside>
    </div>

    <div className="cl-outcomes"><h3>By the end of this module, you should be able to:</h3><ol>{module.outcomes.map(x=><li key={x}>{x}</li>)}</ol></div>

    <div className="cl-learning-grid">
      <aside className="cl-lesson-nav"><span>LESSONS</span>{module.lessons.map(l=><button key={l.id} className={l.id===lesson.id?'active':''} onClick={()=>setLessonId(l.id)}><b>{l.id}</b><span>{l.title}</span><small>{l.minutes} min</small></button>)}</aside>
      <article className="cl-lesson">
        <div className="cl-lesson-head"><span>{lesson.id}</span><h2>{lesson.title}</h2><small>Approx. {lesson.minutes} minutes</small></div>
        {lesson.body.map((p,i)=><p key={i}>{p}</p>)}
        <blockquote><small>KEY IDEA</small>{lesson.keyIdea}</blockquote>
        <KnowledgeCheck check={lesson.check}/>
        <SourceList keys={lesson.sources}/>
      </article>
    </div>

    <section className="cl-case"><span>WOMATE CASE / PRACTICE</span><h2>{module.caseStudy.title}</h2><p>{module.caseStudy.text}</p></section>

    <section className="cl-assignment-bridge">
      <div><span>WEEKLY APPLICATION</span><h2>Turn this module into action.</h2><p>{module.assignment.paragraphPrompt}</p></div>
      <div className="cl-assignment-parts">
        <div><b>01</b><strong>Paragraph response</strong><span>Compulsory</span></div>
        <div><b>02</b><strong>CanopyCanvas campaign</strong><span>Compulsory</span></div>
        <div><b>03</b><strong>Thursday speaker challenge</strong><span>Compulsory · unlocks Thursday</span></div>
        <div><b>+</b><strong>Word puzzle</strong><span>Optional</span></div>
      </div>
      <a href="/canopy/assignments">Go to this week’s assignments →</a>
    </section>

    <SourceList keys={module.sources}/>
  </section>
}
