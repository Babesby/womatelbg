import React,{useMemo,useState} from 'react';

const causes=[
  'Climate resilience','Climate justice','Clean energy','Biodiversity','Water security',
  'Sustainable cities','Climate & wellbeing','Women in climate leadership'
];
const observances=[
  {label:'None',value:''},
  {label:'International Women’s Day · 8 March',value:'International Women’s Day — 8 March'},
  {label:'International Day of Forests · 21 March',value:'International Day of Forests — 21 March'},
  {label:'World Water Day · 22 March',value:'World Water Day — 22 March'},
  {label:'International Mother Earth Day · 22 April',value:'International Mother Earth Day — 22 April'},
  {label:'World Environment Day · 5 June',value:'World Environment Day — 5 June'},
  {label:'World Mental Health Day · 10 October',value:'World Mental Health Day — 10 October'}
];
const tones=['Clear & factual','Hopeful','Urgent but responsible','Community-centred','Professional'];
const formats=['Square post','Portrait post','Landscape card'];
const brandKits=['CANOPY','WOMATE'];

function wrap(ctx,text,x,y,maxWidth,lineHeight,maxLines=8){
  const words=String(text||'').split(/\s+/); let line='', lines=0;
  for(let n=0;n<words.length;n++){
    const test=line+words[n]+' ';
    if(ctx.measureText(test).width>maxWidth&&n>0){
      ctx.fillText(line.trim(),x,y); line=words[n]+' '; y+=lineHeight; lines++;
      if(lines>=maxLines)return;
    } else line=test;
  }
  if(lines<maxLines)ctx.fillText(line.trim(),x,y);
}

export default function CanopyCanvas(){
  const [form,setForm]=useState({
    cause:causes[0],observance:'',
    audience:'Young people and early-career professionals',
    actionTarget:'Learn one practical action and share it with someone else.',
    message:'Climate leadership starts with informed, practical action in the places where we live and work.',
    tone:tones[0],format:formats[0],brandKit:brandKits[0]
  });
  const [note,setNote]=useState('');
  const dims=useMemo(()=>form.format==='Square post'?[1200,1200]:form.format==='Portrait post'?[1080,1350]:[1600,900],[form.format]);
  const update=(k,v)=>setForm(f=>({...f,[k]:v}));

  const makeBlob=()=>new Promise(resolve=>{
    const [w,h]=dims; const c=document.createElement('canvas'); c.width=w; c.height=h;
    const ctx=c.getContext('2d');
    ctx.fillStyle='#0E4D4A'; ctx.fillRect(0,0,w,h);
    ctx.fillStyle='#C6FF52'; ctx.fillRect(0,0,w,Math.max(18,h*.018));
    ctx.fillStyle='#fff'; ctx.font=`700 ${Math.round(w*.035)}px Arial`; ctx.fillText(form.brandKit,w*.07,h*.10);
    ctx.fillStyle='#C6FF52'; ctx.font=`700 ${Math.round(w*.025)}px Arial`; ctx.fillText(form.cause.toUpperCase(),w*.07,h*.21);
    ctx.fillStyle='#fff'; ctx.font=`700 ${Math.round(w*.055)}px Arial`; wrap(ctx,form.message,w*.07,h*.32,w*.84,h*.075,6);
    ctx.fillStyle='#dce8e5'; ctx.font=`500 ${Math.round(w*.025)}px Arial`; wrap(ctx,`For ${form.audience}`,w*.07,h*.72,w*.84,h*.04,2);
    ctx.fillStyle='#C6FF52'; ctx.font=`700 ${Math.round(w*.027)}px Arial`; wrap(ctx,form.actionTarget,w*.07,h*.82,w*.84,h*.045,3);
    if(form.observance){ctx.fillStyle='#fff';ctx.font=`500 ${Math.round(w*.018)}px Arial`;ctx.fillText(form.observance,w*.07,h*.94);}
    c.toBlob(resolve,'image/png',0.95);
  });

  async function download(){
    const blob=await makeBlob();
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download=`canopycanvas-${form.cause.toLowerCase().replace(/[^a-z0-9]+/g,'-')}.png`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(a.href),1000);
    setNote('Graphic downloaded. Upload it to your own Google Drive, set access to “Anyone with the link”, then paste that Drive link into your assignment.');
  }

  return <section className="cc-page">
    <div className="cc-head">
      <span className="cc-kicker">CANOPYCANVAS</span>
      <h1>Create a responsible climate campaign graphic.</h1>
      <p>Choose the cause, audience, action and tone. Review the live preview, download the finished graphic, then upload it to your own Google Drive and attach the viewable link to your assignment.</p>
    </div>

    <div className="cc-grid">
      <div className="cc-form">
        <label>Cause<select value={form.cause} onChange={e=>update('cause',e.target.value)}>{causes.map(x=><option key={x}>{x}</option>)}</select></label>
        <label>Verified observance<select value={form.observance} onChange={e=>update('observance',e.target.value)}>{observances.map(x=><option key={x.label} value={x.value}>{x.label}</option>)}</select></label>
        <label>Audience<input value={form.audience} onChange={e=>update('audience',e.target.value)}/></label>
        <label>Desired action<textarea value={form.actionTarget} onChange={e=>update('actionTarget',e.target.value)}/></label>
        <label>Message<textarea rows="5" value={form.message} onChange={e=>update('message',e.target.value)}/></label>
        <div className="cc-two">
          <label>Tone<select value={form.tone} onChange={e=>update('tone',e.target.value)}>{tones.map(x=><option key={x}>{x}</option>)}</select></label>
          <label>Format<select value={form.format} onChange={e=>update('format',e.target.value)}>{formats.map(x=><option key={x}>{x}</option>)}</select></label>
        </div>
        <label>Brand kit<select value={form.brandKit} onChange={e=>update('brandKit',e.target.value)}>{brandKits.map(x=><option key={x}>{x}</option>)}</select></label>
        <button type="button" className="cc-download" onClick={download}>Download graphic</button>
        {note&&<p className="cc-note">{note}</p>}
      </div>

      <div className={`cc-preview ${form.format.toLowerCase().replace(/\s+/g,'-')}`}>
        <span>{form.brandKit}</span>
        <small>{form.cause}</small>
        <h2>{form.message}</h2>
        <p>For {form.audience}</p>
        <strong>{form.actionTarget}</strong>
        {form.observance&&<em>{form.observance}</em>}
      </div>
    </div>
  </section>
}
