{
  "routes": [
    {
      "src": "^/research\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/research"
      }
    },
    {
      "src": "^/(?:wok|WoK)\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/wok-action"
      }
    },
    {
      "src": "^/www\\.facebook\\.com/?$",
      "status": 308,
      "headers": {
        "Location": "https://www.facebook.com/"
      }
    },
    {
      "src": "^/www\\.facebook\\.com/(.*)$",
      "status": 308,
      "headers": {
        "Location": "https://www.facebook.com/$1"
      }
    },
    {
      "src": "^/www\\.linkedin\\.com/?$",
      "status": 308,
      "headers": {
        "Location": "https://www.linkedin.com/"
      }
    },
    {
      "src": "^/www\\.linkedin\\.com/(.*)$",
      "status": 308,
      "headers": {
        "Location": "https://www.linkedin.com/$1"
      }
    },
    {
      "src": "^/womateer\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/womateer"
      }
    },
    {
      "src": "^/circle\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/circle"
      }
    },
    {
      "src": "^/(?:CH|ch)\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/honours"
      }
    },
    {
      "src": "^/heal\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/resilient-minds"
      }
    },
    {
      "src": "^/(?:Funding|funding)\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/funding"
      }
    },
    {
      "src": "^/merch\\.html/?$",
      "status": 308,
      "headers": {
        "Location": "/merchandise"
      }
    },
    {
      "src": "^/talent/?$",
      "status": 308,
      "headers": {
        "Location": "/talent-discovery"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "womate-work": false,
      "womate-work/**": false
    }
  }
}
